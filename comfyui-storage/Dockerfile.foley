# Foley Audio Generation Docker Image - OPTIMIZED

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined with cleanup
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg timm decord av uv

WORKDIR /opt/ComfyUI

# Clone repos with --depth=1, remove .git, install requirements
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-Manager/requirements.txt \
    && git clone --depth=1 https://github.com/if-ai/ComfyUI_HunyuanVideoFoley.git custom_nodes/ComfyUI_HunyuanVideoFoley \
    && rm -rf custom_nodes/ComfyUI_HunyuanVideoFoley/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/ComfyUI_HunyuanVideoFoley/requirements.txt \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && python -m pip install --no-cache-dir --force-reinstall \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true

# Copy user configurations
COPY --chown=user:user ./storage/ComfyUI/user /opt/ComfyUI/user

# Copy Foley-specific models
COPY --chown=user:user ./storage/ComfyUI/models/foley/hunyuanvideo-foley-xxl/hunyuanvideo_foley.fp8_e5m2.pth /opt/ComfyUI/models/foley/hunyuanvideo-foley-xxl/
COPY --chown=user:user ./storage/ComfyUI/models/checkpoints/Hunyuan-DiT-v1.2-fp16.safetensors /opt/ComfyUI/models/checkpoints/
COPY --chown=user:user ./storage/ComfyUI/models/checkpoints/t2v_checkpoint.pt /opt/ComfyUI/models/checkpoints/
COPY --chown=user:user ./storage/ComfyUI/models/vae/sd-v1-5-vae-ft-mse.safetensors /opt/ComfyUI/models/vae/
COPY --chown=user:user ./storage/ComfyUI/models/clip_vision/clip_vit_l_14.safetensors /opt/ComfyUI/models/clip_vision/
COPY --chown=user:user ./storage/ComfyUI/models/t5/t5-v1_1-xxl /opt/ComfyUI/models/t5/

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]
