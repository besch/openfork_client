        "denoise": 1.0
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "Scheduler (25 steps conservative, use distilled LoRA for fewer steps)"
      }
    },
    "10": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "11": {
      "inputs": {
        "model": ["1", 0],
        "vae": ["1", 2],
        "width": 544,
        "height": 320,
        "num_frames": 73,
        "guider": ["7", 0],
        "sampler": ["8", 0],
        "sigmas": ["9", 0],
        "noise": ["10", 0]
      },
      "class_type": "LTXVBaseSampler",
      "_meta": {
        "title": "8GB Optimized: 544x320 (close to 480p), 73 frames (3 seconds)",
        "notes": "Conservative settings for 8GB VRAM. For 5s clips use 121 frames (risky). Avoid going above 544x320."
      }
    },
    "12": {
      "inputs": {
        "samples": ["11", 0],
        "vae": ["1", 2],
        "tile_size": 128,
        "overlap": 64
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode with Aggressive Tiling (CRITICAL for 8GB)",
        "notes": "tile_size: 128 is very aggressive for <6GB free. Use 192 for 6-7GB, 256 for 7-8GB free VRAM."
      }
    },
    "13": {
      "inputs": {
        "images": ["12", 0],
        "fps": 24
      },
      "class_type": "CreateVideo"
    },
    "14": {
      "inputs": {
        "video": ["13", 0],
        "filename_prefix": "ltx2_t2v_8gb",
        "format": "auto",
        "codec": "auto",
        "quality": "auto"
      },
      "class_type": "SaveVideo"
