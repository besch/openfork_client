# LTX-2.3 22B Docker Image (24GB+ VRAM) — FIXED v2
#
# ROOT CAUSE OF COLOR DEGRADATION (confirmed from official docs.ltx.video):
#   1. Audio CFG was 7.0 — official docs explicitly warn this BREAKS generation
#   2. SamplerCustomAdvanced has no latent normalization — latents drift into
#      oversaturation causing overbaked/crushed colors (LTXVNormalizingSampler fixes this)
#   3. pix_fmt yuv420p uses TV/limited color range (RGB 16-235), crushing output
#
# DOCKERFILE CHANGES FROM ORIGINAL:
#   1. Gemma encoder: replaced single fp8 safetensors file with full multi-file folder
#      from google/gemma-3-12b-it-qat-q4_0-unquantized (official requirement per docs.ltx.video)
#      Stored at: models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized/
#   2. Removed broken gemma-configs COPY lines (configs come from the HF repo folder itself)
#   3. IMPORTANT: HF_TOKEN alone is not enough — your HF account must have accepted
#      Google's Gemma license at huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
#      before the download will work, even with a valid token.
#
# WORKFLOW JSON CHANGES (see ltx23-text-to-video-24gb_api_FIXED_v2.json):
#   - Audio CFG: 7.0 -> 3.0
#   - Both modality_scale: 3.0 -> 1.0, skip_step audio: 0 -> 1 (official baseline)
#   - Steps: 15 -> 8, max_shift/base_shift corrected for distilled schedule
#   - SamplerCustomAdvanced -> LTXVNormalizingSampler (key color fix)
#   - pix_fmt: yuv420p -> yuv444p
#   - Negative prompt: was empty, now has quality terms

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN python -m pip install --no-cache-dir --upgrade pip

RUN python -m pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu128 \
    && rm -rf /tmp/* /var/tmp/*

RUN python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers \
        huggingface-hub color-matcher matplotlib mss toml \
        rich uv sentencepiece bitsandbytes xformers accelerate \
    && rm -rf /tmp/* /var/tmp/*

WORKDIR /opt/ComfyUI

ARG CACHEBUST=1

RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && rm -rf /tmp/* /var/tmp/*

RUN git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && rm -rf /tmp/* /var/tmp/*

RUN git clone --depth=1 https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-LTXVideo/requirements.txt || true) \
    && rm -rf /tmp/* /var/tmp/*

RUN git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && rm -rf /tmp/* /var/tmp/*

RUN mkdir -p models/checkpoints \
    models/clip \
    models/vae \
    models/loras \
    models/latent_upscale_models \
    models/text_encoders

ENV LTX23_TIER=24gb

# ============================================================================
# MODEL DOWNLOADS
# ============================================================================

# LTX-2.3 22B Distilled checkpoint (46.1GB BF16)
RUN echo "Downloading LTX-2.3 22B Distilled model (46.1GB)..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-distilled.safetensors', \
    local_dir='/tmp/ltx23', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/ltx23/ltx-2.3-22b-distilled.safetensors models/checkpoints/ && \
    rm -rf /tmp/ltx23 && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# LTX-2.3 Spatial Upscaler
RUN echo "Downloading LTX-2.3 spatial upscaler..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-spatial-upscaler-x2-1.0.safetensors', \
    local_dir='/tmp/upscaler', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/upscaler/ltx-2.3-spatial-upscaler-x2-1.0.safetensors models/latent_upscale_models/ && \
    rm -rf /tmp/upscaler && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# =============================================================================
# GEMMA TEXT ENCODER — CRITICAL FIX
# =============================================================================
# Official docs (docs.ltx.video) require the FULL MULTI-FILE FOLDER from:
#   google/gemma-3-12b-it-qat-q4_0-unquantized
# stored at:
#   models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized/
#
# The original Dockerfile used a single merged fp8 .safetensors from a third-party
# repo (GitMylo). That is NOT the format LTXAVTextEncoderLoader expects when
# pointed at a folder path — it expects a full HF-style model directory with
# config.json, tokenizer files, and model shards.
#
# PREREQUISITE: Your HF account must have accepted Google's Gemma license at:
#   https://huggingface.co/google/gemma-3-12b-it-qat-q4_0-unquantized
# A valid HF_TOKEN is necessary but NOT sufficient — license acceptance on the
# website is also required, otherwise the download will fail with a 403 error.
# =============================================================================
RUN echo "Downloading Gemma-3 12B QAT full folder (~24GB, requires license acceptance)..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='google/gemma-3-12b-it-qat-q4_0-unquantized', local_dir='/opt/ComfyUI/models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized', token=os.getenv('HF_TOKEN'), ignore_patterns=['*.msgpack', '*.h5', 'flax_model*', 'tf_model*', 'rust_model*'])" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Final cleanup
RUN find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/* ~/.cache/*

WORKDIR /opt/ComfyUI

# --lowvram: offloads 46.1GB model to CPU RAM (required for 24GB VRAM)
# --reserve-vram 1.0: reserve 1GB VRAM for system overhead
# --use-split-cross-attention: memory efficient attention for 24GB
CMD ["python", "main.py", "--listen", "--lowvram", "--reserve-vram", "1.0", "--use-split-cross-attention"]