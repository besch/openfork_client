{
  "prompt": {
    "1": {
      "inputs": {
        "unet_name": "ltx/ltx-2-19b-distilled_Q8_0.gguf"
      },
      "class_type": "UnetLoaderGGUF",
      "_meta": {
        "title": "GGUF Q8_0 Transformer (stays compressed)"
      }
    },
    "2": {
      "inputs": {
        "clip_name1": "gemma_3_12B_it_fp8_scaled.safetensors",
        "clip_name2": "ltx-2-19b-embeddings_connector_dev_bf16.safetensors",
        "type": "ltxv2"
      },
      "class_type": "DualCLIPLoader",
      "_meta": {
        "title": "FP8 Gemma-3 (expands to FP16 temporarily, then offloads)"
      }
    },
    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive Prompt"
      }
    },
    "4": {
      "inputs": {
        "text": "blurry, low quality, static, distorted, watermarks, missing audio, silent, muffled audio, distorted audio",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative Prompt"
      }
    },
    "5": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning"
    },
    "6": {
      "inputs": {
        "width": 512,
        "height": 288,
        "length": 25,
        "batch_size": 1,
        "autopad": true
      },
      "class_type": "EmptyLTXVLatentVideo",
      "_meta": {
        "title": "Ultra-Low Latent (512x288, 25 frames for 8GB+32GB RAM)"
      }
    },
    "empty_audio_latent": {
      "inputs": {
        "length": 25,
        "batch_size": 1,
        "frame_rate": 24
      },
      "class_type": "LTXVEmptyLatentAudio",
      "_meta": {
        "title": "Empty Audio Latent"
      }
    },
    "concat_av": {
      "inputs": {
        "video_latent": ["6", 0],
        "audio_latent": ["empty_audio_latent", 0]
      },
      "class_type": "LTXVConcatAVLatent",
      "_meta": {
        "title": "Concatenate Audio+Video Latents"
      }
    },
    "7": {
      "inputs": {
        "model": ["1", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "cfg": 3.0
      },
      "class_type": "CFGGuider"
    },
    "8": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect"
    },
    "9": {
      "inputs": {
        "model": ["1", 0],
        "scheduler": "simple",
        "steps": 8,
        "denoise": 1.0
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "Scheduler (8 steps - distilled model)"
      }
    },
    "10": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "11": {
      "inputs": {
        "vae_name": "LTX2_video_vae_bf16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load Video VAE"
      }
    },
    "audio_vae": {
      "inputs": {
        "vae_name": "LTX2_audio_vae_bf16.safetensors"
      },
      "class_type": "LTXVAudioVAELoader",
      "_meta": {
        "title": "Load Audio VAE (LTX-2 core node)"
      }
    },
    "12": {
      "inputs": {
        "noise": ["10", 0],
        "guider": ["7", 0],
        "sampler": ["8", 0],
        "sigmas": ["9", 0],
        "latent_image": ["concat_av", 0]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": {
        "title": "Sampler (Audio+Video)"
      }
    },
    "separate_av": {
      "inputs": {
        "samples": ["12", 0]
      },
      "class_type": "LTXVSeparateAVLatent",
      "_meta": {
        "title": "Separate Audio/Video Latents"
      }
    },
    "13": {
      "inputs": {
        "samples": ["separate_av", 0],
        "vae": ["11", 0],
        "tile_size": 256,
        "overlap": 32,
        "temporal_size": 16,
        "temporal_overlap": 4
      },
      "class_type": "VAEDecodeTiled",
      "_meta": {
        "title": "Decode Video Latent (Ultra-Low RAM)"
      }
    },
    "decode_audio": {
      "inputs": {
        "samples": ["separate_av", 1],
        "audio_vae": ["audio_vae", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVAudioVAEDecode",
      "_meta": {
        "title": "Decode Audio Latent"
      }
    },
    "14": {
      "inputs": {
        "images": ["13", 0],
        "audio": ["decode_audio", 0],
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "ltx2_t2v_8gb_audio",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 23,
        "save_metadata": false,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": true
      },
      "class_type": "VHS_VideoCombine",
      "_meta": {
        "title": "Save Video+Audio (VHS)"
      }
    }
  }
}