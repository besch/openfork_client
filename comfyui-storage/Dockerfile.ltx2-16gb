# LTX-2 19B Docker Image (16GB VRAM Optimized) - Cloud Build
# Uses ltx-2-19b-distilled-fp8 (~27GB FP8) model with full Gemma-3-12b text encoder
# Optimized for RTX 4080, 3090, 4060 Ti 16GB
# Supports 720p-1080p at 24fps, 4-5s clips

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# PyTorch CUDA memory optimization for 16GB VRAM
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:256

# Set up Hugging Face Token Build Arg
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages
RUN python -m pip install --no-cache-dir --upgrade pip

# Install PyTorch first
RUN python -m pip install --no-cache-dir \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && rm -rf /tmp/* /var/tmp/*

# Install remaining dependencies
RUN python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers \
        huggingface-hub color-matcher matplotlib mss toml \
        rich uv sentencepiece bitsandbytes \
    && rm -rf /tmp/* /var/tmp/*

WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && rm -rf /tmp/* /var/tmp/*

# Install ComfyUI-Manager
RUN git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && rm -rf /tmp/* /var/tmp/*

# Install ComfyUI-LTXVideo
RUN git clone --depth=1 https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-LTXVideo/requirements.txt || true) \
    && rm -rf /tmp/* /var/tmp/*

# Install VideoHelperSuite
RUN git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true \
    && rm -rf /tmp/* /var/tmp/*

# Patch embeddings_connector.py
RUN find custom_nodes/ComfyUI-LTXVideo -name "embeddings_connector.py" -exec python3 -c "import sys; path=sys.argv[1]; print(f'Patching {path}'); content=open(path).read(); content=content.replace('repeat(hidden_states.shape[0], 1, 1))', 'repeat(hidden_states.shape[0], 1, 1).to(hidden_states.device))'); open(path,'w').write(content)" {} \;

# Create model directories
RUN mkdir -p models/checkpoints \
    models/clip/gemma-3-12b-it \
    models/latent_upscale_models \
    models/loras

ENV LTX2_TIER=16gb

# Download main BF16 model with retry (~27GB FP8 distilled model for 16GB VRAM)
RUN if [ -z "$HF_TOKEN" ]; then \
        echo "ERROR: HF_TOKEN is not set!"; \
        exit 1; \
    fi \
    && MAX_RETRIES=3; \
    for i in $(seq 1 $MAX_RETRIES); do \
        echo "Attempt $i/$MAX_RETRIES: Downloading BF16 main model..."; \
        huggingface-cli download Lightricks/LTX-2 \
            ltx-2-19b-distilled-fp8.safetensors \
            --local-dir models/checkpoints \
            --local-dir-use-symlinks False \
            --token "$HF_TOKEN" \
            --resume-download \
        && break || { \
            echo "Download failed, retrying..."; \
            rm -rf models/checkpoints/ltx-2-19b-distilled-fp8.safetensors* ; \
            sleep 10; \
        }; \
    done \
    && python3 -c "import os; size=os.path.getsize('models/checkpoints/ltx-2-19b-distilled-fp8.safetensors')/(1024**3); print(f'Main model: {size:.2f}GB'); assert size > 25, 'File too small, corrupted'" \
    && rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Download spatial upscaler
RUN MAX_RETRIES=3; \
    for i in $(seq 1 $MAX_RETRIES); do \
        echo "Attempt $i/$MAX_RETRIES: Downloading spatial upscaler..."; \
        huggingface-cli download Lightricks/LTX-2 \
            ltx-2-spatial-upscaler-x2-1.0.safetensors \
            --local-dir models/latent_upscale_models \
            --local-dir-use-symlinks False \
            --token "$HF_TOKEN" \
            --resume-download \
        && break || { \
            echo "Download failed, retrying..."; \
            rm -rf models/latent_upscale_models/ltx-2-spatial-upscaler-x2-1.0.safetensors* ; \
            sleep 10; \
        }; \
    done \
    && python3 -c "import os; size=os.path.getsize('models/latent_upscale_models/ltx-2-spatial-upscaler-x2-1.0.safetensors')/(1024**3); print(f'Upscaler: {size:.2f}GB'); assert size > 0.8, f'File too small ({size:.2f}GB), corrupted or incomplete download'; \
assert size < 3.0, f'File unexpectedly large ({size:.2f}GB), may be corrupted'; \
print(f'✓ Spatial upscaler download verified: {size:.2f}GB')" \
    && rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Download distilled LoRA (FIXED: Updated size check from 3.0 to 8.0 GB)
RUN MAX_RETRIES=3; \
    for i in $(seq 1 $MAX_RETRIES); do \
        echo "Attempt $i/$MAX_RETRIES: Downloading distilled LoRA..."; \
        huggingface-cli download Lightricks/LTX-2 \
            ltx-2-19b-distilled-lora-384.safetensors \
            --local-dir models/loras \
            --local-dir-use-symlinks False \
            --token "$HF_TOKEN" \
            --resume-download \
        && break || { \
            echo "Download failed, retrying..."; \
            rm -rf models/loras/ltx-2-19b-distilled-lora-384.safetensors* ; \
            sleep 10; \
        }; \
    done \
    && python3 -c "import os; size=os.path.getsize('models/loras/ltx-2-19b-distilled-lora-384.safetensors')/(1024**3); print(f'LoRA: {size:.2f}GB'); assert size > 0.8, f'File too small ({size:.2f}GB), corrupted or incomplete download'; \
assert size < 8.0, f'File unexpectedly large ({size:.2f}GB), may be corrupted'; \
print(f'✓ LoRA download verified: {size:.2f}GB')" \
    && rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Download full Gemma-3 12B text encoder BF16 (~24GB total)
# Note: Model is sharded (4-5 files)
RUN MAX_RETRIES=3; \
    for i in $(seq 1 $MAX_RETRIES); do \
        echo "Attempt $i/$MAX_RETRIES: Downloading Gemma-3 12B encoder (sharded)..."; \
        huggingface-cli download google/gemma-3-12b-it \
            --include "model-*.safetensors" "model.safetensors.index.json" \
            --local-dir models/clip/gemma-3-12b-it \
            --local-dir-use-symlinks False \
            --token "$HF_TOKEN" \
            --resume-download \
        && break || { \
            echo "Download failed, retrying..."; \
            rm -rf models/clip/gemma-3-12b-it/model-*.safetensors models/clip/gemma-3-12b-it/model.safetensors.index.json; \
            sleep 10; \
        }; \
    done \
    && python3 -c "import os; size=sum(os.path.getsize(os.path.join('models/clip/gemma-3-12b-it', f)) for f in os.listdir('models/clip/gemma-3-12b-it') if f.startswith('model-') and f.endswith('.safetensors'))/(1024**3); print(f'Gemma-3 (sharded): {size:.2f}GB'); assert size > 20, 'File too small, corrupted'" \
    && rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Download tokenizer and config files
RUN huggingface-cli download google/gemma-3-12b-it \
    tokenizer.model \
    tokenizer.json \
    tokenizer_config.json \
    special_tokens_map.json \
    config.json \
    --local-dir models/clip/gemma-3-12b-it \
    --local-dir-use-symlinks False \
    --token "$HF_TOKEN" \
    && rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Verify all models (FIXED: Updated LoRA minimum size & Directory support)
RUN echo '#!/usr/bin/env python3\n\
import os\n\
import sys\n\
\n\
files_to_verify = {\n\
    "models/checkpoints/ltx-2-19b-distilled-fp8.safetensors": 25.0,\n\
    "models/clip/gemma-3-12b-it": 20.0,\n\
    "models/latent_upscale_models/ltx-2-spatial-upscaler-x2-1.0.safetensors": 0.8,\n\
    "models/loras/ltx-2-19b-distilled-lora-384.safetensors": 6.0,\n\
}\n\
\n\
print("\\n" + "="*70)\n\
print("VERIFYING 16GB MODEL FILES")\n\
print("="*70)\n\
\n\
all_valid = True\n\
for filepath, min_size_gb in files_to_verify.items():\n\
    if not os.path.exists(filepath):\n\
        print(f"❌ MISSING: {filepath}")\n\
        all_valid = False\n\
        continue\n\
    \n\
    if os.path.isdir(filepath):\n\
        size_gb = sum(os.path.getsize(os.path.join(filepath, f)) for f in os.listdir(filepath) if os.path.isfile(os.path.join(filepath, f))) / (1024**3)\n\
    else:\n\
        size_gb = os.path.getsize(filepath) / (1024**3)\n\
        \n\
    if size_gb < min_size_gb:\n\
        print(f"❌ TOO SMALL: {filepath} ({size_gb:.2f}GB < {min_size_gb}GB minimum)")\n\
        all_valid = False\n\
    else:\n\
        print(f"✓ VALID: {filepath} ({size_gb:.2f}GB)")\n\
\n\
print("="*70)\n\
\n\
if not all_valid:\n\
    print("ERROR: Some model files are missing or corrupted!")\n\
    sys.exit(1)\n\
\n\
print("="*70)\n\
\n\
if not all_valid:\n\
    print("ERROR: Some model files are missing or corrupted!")\n\
    sys.exit(1)\n\
\n\
print("SUCCESS: All 16GB tier model files verified!")\n\
print("="*70 + "\\n")\n\
' > /tmp/verify_models.py \
    && python3 /tmp/verify_models.py \
    && rm /tmp/verify_models.py

# Final cleanup
RUN find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/* ~/.cache/*

WORKDIR /opt/ComfyUI

# 16GB VRAM OPTIMIZED LAUNCH FLAGS:
# --listen: Allow external connections
# --highvram: Use high VRAM mode for better performance (16GB has headroom)
# --use-pytorch-cross-attention: Better quality than split attention
# 
# Performance Expectations for 16GB VRAM:
# - 720p 4-5s clips: ~2-3 minutes, STABLE ✓
# - 1080p 4-5s clips: ~3-5 minutes, STABLE ✓
# - 1440p 3-4s clips: ~4-6 minutes, possible with optimization
# - Quality: 100% - full BF16 precision
CMD ["python", "main.py", "--listen", "--highvram", "--use-pytorch-cross-attention"]