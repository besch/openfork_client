# syntax=docker/dockerfile:1.4
# ERNIE-Image Turbo (8GB) - low-VRAM compatibility mode
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DEFAULT_TIMEOUT=120
ENV HF_HOME=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

ENV ERNIE_MODEL_ID=baidu/ERNIE-Image-Turbo
ENV ERNIE_DEFAULT_STEPS=8
ENV ERNIE_DTYPE=fp16
ENV ERNIE_USE_PE=false
ENV ERNIE_ENABLE_CPU_OFFLOAD=true
ENV ERNIE_ENABLE_ATTENTION_SLICING=true
ENV ERNIE_ENABLE_VAE_TILING=true
ENV ERNIE_ALLOW_MODEL_DOWNLOAD=false

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git wget libgl1-mesa-glx ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip

RUN mkdir -p /tmp/pip-cache \
    && for attempt in 1 2 3; do \
        PIP_NO_CACHE_DIR=0 python -m pip install \
            --cache-dir /tmp/pip-cache \
            --retries 10 \
            --timeout 120 \
            torch==2.7.1+cu128 torchvision==0.22.1+cu128 \
            --extra-index-url https://download.pytorch.org/whl/cu128 \
        && break; \
        status=$?; \
        echo "Torch install failed on attempt ${attempt}, retrying..."; \
        if [ "$attempt" -eq 3 ]; then exit "$status"; fi; \
        sleep 15; \
    done \
    && rm -rf /tmp/pip-cache

RUN python -m pip install --no-cache-dir \
        transformers>=4.51.0 \
        accelerate>=1.3.0 \
        sentencepiece \
        huggingface_hub \
        Pillow \
        fastapi \
        "uvicorn[standard]" \
        python-multipart \
        requests

# ErnieImagePipeline landed in diffusers after the 0.37.0 PyPI release.
# Install from git main until the next stable release ships.
RUN python -m pip install --no-cache-dir \
        "git+https://github.com/huggingface/diffusers.git"

RUN mkdir -p /app/input /app/output /app/models

# --- Bake model weights into the image at build time ---
# This is still the official Turbo checkpoint, but the runtime defaults above
# switch the service into a low-VRAM mode (CPU offload, PE disabled) so the
# "8GB" tier behaves like a compatibility tier instead of trying to run the
# full prompt-enhanced pipeline entirely on GPU.
# Pass --build-arg HF_TOKEN=hf_xxx to avoid rate limits during build.
# If no token is provided the download still works but may be slower.
ARG HF_TOKEN=""
RUN if [ -n "$HF_TOKEN" ]; then \
        python -c "from huggingface_hub import login; login('$HF_TOKEN')"; \
    fi \
    && HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c "\
from huggingface_hub import snapshot_download; \
snapshot_download('baidu/ERNIE-Image-Turbo', cache_dir='/app/models', ignore_patterns=['pe/*', 'pe_tokenizer/*'])" \
    && echo "Model downloaded successfully"

COPY ernie_image_api.py /app/ernie_image_api.py

CMD ["python", "ernie_image_api.py"]
