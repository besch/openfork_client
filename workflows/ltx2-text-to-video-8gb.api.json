{
  "prompt": {
    "comment": "LTX-2 Text-to-Video 8GB VRAM Workflow - Updated for Kijai FP8 models",
    "1": {
      "inputs": {
        "unet_name": "ltx-2-19b-dev-fp8_transformer_only.safetensors"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "Load Diffusion Model"
      }
    },
    "2": {
      "inputs": {
        "clip_name1": "gemma_3_12B_it.safetensors",
        "clip_name2": "ltx-2-19b-embeddings_connector_dev_bf16.safetensors",
        "type": "ltxv"
      },
      "class_type": "DualCLIPLoader",
      "_meta": {
        "title": "Load Text Encoders (Gemma + LTX Connector)"
      }
    },
    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder - replace with your prompt",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Encode Positive Prompt"
      }
    },
    "4": {
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Encode Negative Prompt (empty for LTX-2)"
      }
    },
    "5": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning",
      "_meta": {
        "title": "LTX-V Conditioning"
      }
    },
    "6": {
      "inputs": {
        "width": 544,
        "height": 320,
        "length": 1,
        "color": 0
      },
      "class_type": "EmptyImage",
      "_meta": {
        "title": "Empty Latent Image (Initial Frame)"
      }
    },
    "7": {
      "inputs": {
        "length": 73
      },
      "class_type": "PrimitiveInt",
      "_meta": {
        "title": "Frame Count (73 = 3 seconds at 24fps)"
      }
    },
    "8": {
      "inputs": {
        "value": 24
      },
      "class_type": "PrimitiveFloat",
      "_meta": {
        "title": "Frame Rate"
      }
    },
    "9": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise",
      "_meta": {
        "title": "Random Noise Seed (0 = random each time)"
      }
    },
    "10": {
      "inputs": {
        "model": ["1", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "vae": ["11", 0],
        "empty_latent_image": ["6", 0],
        "length": 73,
        "frame_rate": 24,
        "noise_seed": 0,
        "steps": 30,
        "cfg": 3.0,
        "sampler_name": "euler",
        "scheduler": "simple"
      },
      "class_type": "LTXVSampler",
      "_meta": {
        "title": "LTX-2 Sampler"
      }
    },
    "11": {
      "inputs": {
        "vae_name": "LTX2_video_vae_bf16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load VAE"
      }
    },
    "12": {
      "inputs": {
        "samples": ["10", 0],
        "vae": ["11", 0],
        "tile_size": 256
      },
      "class_type": "VAEDecodeTiled",
      "_meta": {
        "title": "VAE Decode (Tiled for 8GB VRAM)"
      }
    },
    "13": {
      "inputs": {
        "images": ["12", 0],
        "fps": 24,
        "codec": "h264",
        "quality": 23,
        "format": "video/h264-mp4"
      },
      "class_type": "CreateVideo",
      "_meta": {
        "title": "Create Video File"
      }
    },
    "14": {
      "inputs": {
        "video": ["13", 0],
        "filename_prefix": "ltx2_t2v_8gb",
        "codec": "h264",
        "quality": "high"
      },
      "class_type": "SaveVideo",
      "_meta": {
        "title": "Save Video"
      }
    }
  },
  "extra_data": {
    "notes": "This workflow uses:\n- FP8 diffusion model from Kijai (~21.6GB)\n- Gemma-3 12B text encoder from Comfy-Org\n- LTX-2 embeddings connector from Kijai\n- Tiled VAE decoding for 8GB VRAM\n\nOptimized for 8GB VRAM with --lowvram flag.\nAdjust resolution (node 6) and frames (node 7) for your VRAM capacity."
  }
}