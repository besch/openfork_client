# syntax=docker/dockerfile:1.4
# ACE-Step-1.5 Docker Image - 8GB Optimized
# Uses 2B turbo DiT only (no LM) to stay within 8GB VRAM

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

# Metadata
LABEL maintainer="openfork@example.com"
LABEL description="ACE-Step-1.5 Music Generation API Server (8GB Optimized)"
LABEL version="1.5.0-8gb"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=$CUDA_HOME/bin:$PATH \
    LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/app/pretrained \
    UV_CACHE_DIR=/app/.uv_cache \
    ACESTEP_CHECKPOINTS_DIR=/app/acestep_repo/checkpoints \
    ACESTEP_CONFIG_PATH=acestep-v15-turbo \
    ACESTEP_INIT_LLM=false \
    ACESTEP_LM_BACKEND=pt \
    ACESTEP_API_HOST=0.0.0.0 \
    ACESTEP_API_PORT=8000

# Install system dependencies with retry logic
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    wget \
    ffmpeg \
    libsndfile1 \
    ca-certificates \
    || (sleep 5 && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    wget \
    ffmpeg \
    libsndfile1 \
    ca-certificates) \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install uv from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Clone ACE-Step-1.5
RUN git clone https://github.com/ACE-Step/ACE-Step-1.5.git /app/acestep_repo

WORKDIR /app/acestep_repo

# Install dependencies using UV
RUN uv python install 3.11 \
    && uv sync

# Install additional dependencies for model download
RUN uv pip install huggingface_hub[cli]

# Create directories for models and output
RUN mkdir -p /app/pretrained /app/output /app/acestep_repo/checkpoints

# Download base components only (VAE, text encoder, 2B turbo DiT)
# Skip LM model to stay within 8GB VRAM budget
RUN uv run huggingface-cli download ACE-Step/Ace-Step1.5 --local-dir /app/acestep_repo/checkpoints --resume-download

# Expose API port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the built-in ACE-Step 1.5 API server
CMD ["uv", "run", "acestep-api"]
