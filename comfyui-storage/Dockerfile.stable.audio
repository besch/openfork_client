# syntax=docker/dockerfile:1.4
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu121

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git wget sed git-lfs \
    ffmpeg \
    libavformat-dev libavcodec-dev libavdevice-dev \
    libavutil-dev libavfilter-dev libswscale-dev libswresample-dev \
    pkg-config \
    libgl1-mesa-glx libgl1-mesa-dri \
    libsndfile1 libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

RUN python -m pip install --upgrade pip

# Set working directory
WORKDIR /opt/ComfyUI

# Clone ComfyUI first
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI
RUN cd /opt/ComfyUI && git pull

# Install NumPy 1.x FIRST - critical for compatibility
RUN python -m pip install "numpy>=1.24.0,<2.0.0"

# Create a pip constraints file to prevent numpy upgrades and pin versions
RUN echo "numpy<2.0.0" > /tmp/constraints.txt && \
    echo "transformers>=4.45.0" >> /tmp/constraints.txt && \
    echo "pydantic>=2.0,<3.0" >> /tmp/constraints.txt
ENV PIP_CONSTRAINT=/tmp/constraints.txt

# Install PyTorch 2.3.1 with CUDA 12.1 (compatible with cuDNN 8)
RUN python -m pip install --no-cache-dir \
    torch==2.3.1+cu121 \
    torchvision==0.18.1+cu121 \
    torchaudio==2.3.1+cu121 \
    --index-url https://download.pytorch.org/whl/cu121

# Install xformers compatible with PyTorch 2.3.1
RUN python -m pip install --no-cache-dir xformers==0.0.26.post1

# Install base dependencies
RUN python -m pip install PyYAML opencv-python imageio-ffmpeg

# Install PyAV for video handling (CRITICAL - needed before other packages)
RUN python -m pip install --no-cache-dir av

# Install ComfyUI core dependencies manually - use --no-deps and install dependencies carefully
RUN python -m pip install --no-cache-dir \
    einops \
    Pillow \
    pyyaml \
    tqdm \
    psutil

# Install scipy and other scientific packages that might want numpy 2.x
RUN python -m pip install --no-cache-dir --no-deps scipy && \
    python -m pip install --no-cache-dir --no-deps kornia && \
    python -m pip install --no-cache-dir --no-deps spandrel

# Install their minimal dependencies without upgrading numpy
RUN python -m pip install --no-cache-dir \
    aiohttp \
    safetensors>=0.4.2 \
    torchsde \
    kornia-rs \
    pydantic-settings \
    pydantic>=2.0 \
    alembic \
    resampy

# Install transformers 4.45.0 which has Qwen2Tokenizer
RUN python -m pip install --no-cache-dir --no-deps transformers==4.45.0 && \
    python -m pip install --no-cache-dir "tokenizers>=0.20,<0.21" huggingface-hub filelock requests regex

# Force numpy back to 1.x in case anything upgraded it
RUN python -m pip install --force-reinstall --no-cache-dir "numpy>=1.24.0,<2.0.0"

# Verify PyTorch can load and check versions
RUN python -c "import torch; print(f'PyTorch version: {torch.__version__}'); assert torch.__version__.startswith('2.3.'), f'Wrong PyTorch version'"
RUN python -c "import numpy; print(f'NumPy version: {numpy.__version__}'); assert numpy.__version__.startswith('1.'), f'Wrong NumPy version'"
RUN python -c "from transformers import Qwen2Tokenizer; print('✓ Qwen2Tokenizer available')"
RUN python -c "import av; print(f'✓ PyAV available')"

# Install ComfyUI Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git /opt/ComfyUI/custom_nodes/ComfyUI-Manager

# Install Manager requirements, filtering out torch and transformers to prevent version conflicts
RUN if [ -f /opt/ComfyUI/custom_nodes/ComfyUI-Manager/requirements.txt ]; then \
        grep -v "^torch" /opt/ComfyUI/custom_nodes/ComfyUI-Manager/requirements.txt | \
        grep -v "^transformers" > /tmp/manager_reqs.txt && \
        python -m pip install -r /tmp/manager_reqs.txt || true; \
    fi

# Install ComfyUI-Sound-Lab
RUN git clone https://github.com/shadowcz007/comfyui-sound-lab /opt/ComfyUI/custom_nodes/comfyui-sound-lab
RUN cd /opt/ComfyUI/custom_nodes/comfyui-sound-lab && \
    python -m pip install -r requirements.txt

# Install uv for ComfyUI-Manager
RUN python -m pip install --no-cache-dir uv

# CRITICAL: Force reinstall transformers 4.45.0 and tokenizers after all audio packages
RUN echo "Forcing transformers 4.45.0 reinstall..." && \
    python -m pip uninstall -y transformers tokenizers && \
    python -m pip install --no-cache-dir transformers==4.45.0 "tokenizers>=0.20,<0.21"

# Ensure pydantic V2 is properly installed with all components
RUN python -m pip uninstall -y pydantic pydantic-core pydantic-settings && \
    python -m pip install --no-cache-dir pydantic>=2.0 pydantic-core pydantic-settings

# Install remaining ComfyUI optional dependencies
RUN python -m pip install --no-cache-dir comfyui-workflow-templates comfyui-embedded-docs || true

# Final verification - ensure correct versions are installed
RUN echo "=== Build-time Package Verification ===" && \
    python -c "import torch; print(f'✓ PyTorch: {torch.__version__}')" && \
    python -c "import transformers; print(f'✓ Transformers: {transformers.__version__}')" && \
    python -c "from transformers import Qwen2Tokenizer; print('✓ Qwen2Tokenizer available')" && \
    python -c "import numpy; print(f'✓ NumPy: {numpy.__version__}')" && \
    python -c "import pydantic; print(f'✓ Pydantic: {pydantic.__version__}')" && \
    python -c "import av; print(f'✓ PyAV: {av.__version__}')" && \
    echo "=== All checks passed ==="

# Create models directories
RUN mkdir -p /opt/ComfyUI/models/checkpoints
RUN mkdir -p /opt/ComfyUI/models/text_encoders

# Download Stable Audio Open 1.0 models (optional - gracefully handles missing token)
ARG HF_TOKEN=""
RUN if [ -z "$HF_TOKEN" ]; then \
        echo ""; \
        echo "===================================================="; \
        echo "WARNING: HF_TOKEN not provided during build"; \
        echo "===================================================="; \
        echo "Models were NOT downloaded. To use Stable Audio, either:"; \
        echo ""; \
        echo "Option 1: Rebuild with HF token"; \
        echo "  docker build --build-arg HF_TOKEN=your_token_here \\"; \
        echo "    -t beschiak/openfork-stable-audio-rtx4060:latest ."; \
        echo ""; \
        echo "Option 2: Download models manually"; \
        echo "  - Accept model access at https://huggingface.co/stabilityai/stable-audio-open-1.0"; \
        echo "  - Create './models' directory locally"; \
        echo "  - Download model files to ./models"; \
        echo "  - Mount at runtime: -v \$(pwd)/models:/opt/ComfyUI/models"; \
        echo "===================================================="; \
        echo ""; \
    else \
        echo "Downloading Stable Audio Open 1.0 models with provided HF_TOKEN..."; \
        python3 -c " \
import os; \
from huggingface_hub import hf_hub_download, login; \
import shutil; \
token = os.environ.get('HF_TOKEN', ''); \
login(token=token) if token else None; \
print('✓ Authenticated with Hugging Face'); \
hf_hub_download(repo_id='stabilityai/stable-audio-open-1.0', filename='model.safetensors', local_dir='/opt/ComfyUI/models/checkpoints', local_dir_use_symlinks=False); \
src = '/opt/ComfyUI/models/checkpoints/model.safetensors'; dst = '/opt/ComfyUI/models/checkpoints/stable_audio_open_1.0.safetensors'; \
shutil.move(src, dst) if os.path.exists(src) else None; \
print('✓ Main model downloaded'); \
hf_hub_download(repo_id='stabilityai/stable-audio-open-1.0', filename='text_encoder/model.safetensors', local_dir='/opt/ComfyUI/models/text_encoders', local_dir_use_symlinks=False); \
src = '/opt/ComfyUI/models/text_encoders/text_encoder/model.safetensors'; dst = '/opt/ComfyUI/models/text_encoders/t5_base.safetensors'; \
shutil.move(src, dst) if os.path.exists(src) else None; \
print('✓ Text encoder downloaded'); \
print('✓ All models ready!') \
" || echo "WARNING: Model download failed - you can add models manually later"; \
    fi

# Create a startup script that shows versions and starts ComfyUI
RUN echo '#!/bin/bash' > /opt/startup.sh && \
    echo 'echo "=== ComfyUI Starting - Package Versions ==="' >> /opt/startup.sh && \
    echo 'python -c "import torch; print(f\"PyTorch: {torch.__version__}\")"' >> /opt/startup.sh && \
    echo 'python -c "import transformers; print(f\"Transformers: {transformers.__version__}\")"' >> /opt/startup.sh && \
    echo 'python -c "import numpy; print(f\"NumPy: {numpy.__version__}\")"' >> /opt/startup.sh && \
    echo 'python -c "import pydantic; print(f\"Pydantic: {pydantic.__version__}\")"' >> /opt/startup.sh && \
    echo 'python -c "import av; print(f\"PyAV: {av.__version__}\")"' >> /opt/startup.sh && \
    echo 'echo "=========================================="' >> /opt/startup.sh && \
    echo 'cd /opt/ComfyUI && python main.py --listen "$@"' >> /opt/startup.sh && \
    chmod +x /opt/startup.sh

# Set final working directory and command
WORKDIR /opt/ComfyUI
CMD ["/opt/startup.sh"]