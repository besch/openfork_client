# LTX-2 19B FP4 Docker Image (8GB VRAM with RAM offloading)
# Uses ltx-2-19b-dev-fp4 model with Gemma-3-12b text encoder
# Requires --lowvram flag to offload weights to system RAM

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub \
        color-matcher matplotlib mss toml rich uv sentencepiece bitsandbytes

WORKDIR /opt/ComfyUI

# Clone ComfyUI and custom nodes
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && git clone --depth=1 https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-LTXVideo/requirements.txt || true) \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true

# Patch embeddings_connector.py to fix LTX-2 stalling (device mismatch)
RUN find custom_nodes/ComfyUI-LTXVideo -name "embeddings_connector.py" -exec python3 -c "import sys; path=sys.argv[1]; print(f'Patching {path}'); content=open(path).read(); content=content.replace('repeat(hidden_states.shape[0], 1, 1))', 'repeat(hidden_states.shape[0], 1, 1).to(hidden_states.device))'); open(path,'w').write(content)" {} \;


# Create model directories
RUN mkdir -p models/checkpoints models/clip/gemma-3-12b-it-fp8 models/latent_upscale_models models/loras

# Download LTX-2 FP4 model (~20GB) - most VRAM efficient
RUN wget -q --show-progress -O models/checkpoints/ltx-2-19b-dev-fp4.safetensors \
        "https://huggingface.co/Lightricks/LTX-2/resolve/main/ltx-2-19b-dev-fp4.safetensors"

# Download spatial upscaler
RUN wget -q --show-progress -O models/latent_upscale_models/ltx-2-spatial-upscaler-x2-1.0.safetensors \
        "https://huggingface.co/Lightricks/LTX-2/resolve/main/ltx-2-spatial-upscaler-x2-1.0.safetensors"

# Download distilled LoRA for faster generation (fewer steps)
RUN wget -q --show-progress -O models/loras/ltx-2-19b-distilled-lora-384.safetensors \
        "https://huggingface.co/Lightricks/LTX-2/resolve/main/ltx-2-19b-distilled-lora-384.safetensors"

# Download Camera Control LoRAs
RUN wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-dolly-in.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-In/resolve/main/ltx-2-19b-lora-camera-control-dolly-in.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-dolly-out.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Out/resolve/main/ltx-2-19b-lora-camera-control-dolly-out.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-dolly-left.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Left/resolve/main/ltx-2-19b-lora-camera-control-dolly-left.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-dolly-right.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Right/resolve/main/ltx-2-19b-lora-camera-control-dolly-right.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-jib-up.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Up/resolve/main/ltx-2-19b-lora-camera-control-jib-up.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-jib-down.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Down/resolve/main/ltx-2-19b-lora-camera-control-jib-down.safetensors" \
    && wget -q --show-progress -O models/loras/ltx-2-19b-lora-camera-control-static.safetensors \
        "https://huggingface.co/Lightricks/LTX-2-19b-LoRA-Camera-Control-Static/resolve/main/ltx-2-19b-lora-camera-control-static.safetensors"

# Download GitMylo's ComfyUI-compatible FP8 Gemma text encoder and Unsloth components
RUN wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/gemma_3_12B_it_fp8_e4m3fn.safetensors \
        "https://huggingface.co/GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn/resolve/main/gemma_3_12B_it_fp8_e4m3fn.safetensors" \
    && wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/ltx-2-19b-dev-fp4_projections_only.safetensors \
        "https://huggingface.co/GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn/resolve/main/ltx-2-19b-dev-fp4_projections_only.safetensors" \
    && wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/tokenizer.model \
        "https://huggingface.co/unsloth/gemma-2-9b/resolve/main/tokenizer.model" \
    && wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/tokenizer.json \
        "https://huggingface.co/unsloth/gemma-2-9b/resolve/main/tokenizer.json" \
    && wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/tokenizer_config.json \
        "https://huggingface.co/unsloth/gemma-2-9b/resolve/main/tokenizer_config.json" \
    && wget -q --show-progress -O models/clip/gemma-3-12b-it-fp8/special_tokens_map.json \
        "https://huggingface.co/unsloth/gemma-2-9b/resolve/main/special_tokens_map.json"

WORKDIR /opt/ComfyUI
# Use --lowvram to offload model weights to RAM, --reserve-vram 1 keeps 1GB free for system
# Use --cpu-vae to force VAE decoding on CPU (required for 8GB VRAM after main model uses most memory)
CMD ["python", "main.py", "--listen", "--lowvram", "--reserve-vram", "1", "--cpu-vae"]
