# LTX-2 19B FP8 Docker Image (16GB VRAM)
# Uses ltx-2-19b-distilled-fp8 model with Gemma-3-12b text encoder

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub \
        color-matcher matplotlib mss toml rich uv sentencepiece

WORKDIR /opt/ComfyUI

# Clone ComfyUI and custom nodes
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && git clone --depth=1 https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-LTXVideo/requirements.txt || true) \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true

# Create model directories
RUN mkdir -p models/checkpoints models/text_encoders models/latent_upscale_models models/loras

# HF_TOKEN for authenticated downloads
ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

# Download LTX-2 FP8 model (~10GB) - using huggingface-cli for reliability
RUN huggingface-cli download Lightricks/LTX-2 ltx-2-19b-distilled-fp8.safetensors \
    --local-dir models/checkpoints --local-dir-use-symlinks False

# Download spatial upscaler
RUN huggingface-cli download Lightricks/LTX-2 ltx-2-spatial-upscaler-x2-1.0.safetensors \
    --local-dir models/latent_upscale_models --local-dir-use-symlinks False

# Download distilled LoRA for faster generation
RUN huggingface-cli download Lightricks/LTX-2 ltx-2-19b-distilled-lora-384.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False

# Download Camera Control LoRAs
RUN huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-In \
    ltx-2-19b-lora-camera-control-dolly-in.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Out \
    ltx-2-19b-lora-camera-control-dolly-out.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Left \
    ltx-2-19b-lora-camera-control-dolly-left.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Right \
    ltx-2-19b-lora-camera-control-dolly-right.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Up \
    ltx-2-19b-lora-camera-control-jib-up.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Down \
    ltx-2-19b-lora-camera-control-jib-down.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False \
    && huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Static \
    ltx-2-19b-lora-camera-control-static.safetensors \
    --local-dir models/loras --local-dir-use-symlinks False

# Download Gemma-3 text encoder (gated model - requires token)
RUN huggingface-cli download google/gemma-3-12b-it-qat-q4_0-unquantized \
    --local-dir models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized \
    --local-dir-use-symlinks False \
    --token $HF_TOKEN

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen", "--lowvram"]
