# YUME 1.5 Docker Image (REST API Backend)
# 
# This image provides YUME 1.5 (Yume-5B-720P) for interactive world generation.
# YUME uses a custom diffusion pipeline built on FastVideo/HunyuanVideo.
# Uses a REST API server instead of ComfyUI for better compatibility.
#
# Reference: https://github.com/stdstu12/YUME
# Model: https://huggingface.co/stdstu123/Yume-5B-720P

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV TOKENIZERS_PARALLELISM=false
ENV YUME_MODEL_PATH=/opt/models/Yume

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common git curl wget libgl1-mesa-glx libgl1-mesa-dri \
    ffmpeg libsm6 libxext6 \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Base Python packages
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg timm decord av uv \
        diffusers transformers accelerate einops omegaconf huggingface_hub[cli] scikit-image \
        ftfy regex tqdm matplotlib tensorboard bitsandbytes scipy packaging \
        fastapi uvicorn python-multipart pillow easydict

# Clone YUME repository
WORKDIR /opt
RUN git clone --depth=1 https://github.com/stdstu12/YUME.git \
    && cd YUME \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt || true \
    && python -m pip install --no-cache-dir -e . || true

# Download Model Checkpoint (Split into layers to ensure reliable docker push)
# attempting to push a single 30GB layer often causes 502 Bad Gateway errors.
# By splitting downloads, we create smaller, manageable layers (~10GB each).

RUN mkdir -p /opt/models/Yume

# Layer 1: Config files & VAE (Small)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.json" "*.yaml" "*.md" ".gitattributes" "*VAE*"

# Layer 2: T5 Text Encoder (~5-10GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*t5*"

# Layer 3: Main Diffusion Model (~10-15GB) & Symlink
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.safetensors" \
    && ln -sf /opt/models/Yume /opt/YUME/Yume-5B-720p

# Create directories for API
RUN mkdir -p /opt/output /opt/input

# Copy the REST API server
WORKDIR /opt/dgn-client
COPY yume_api.py /opt/dgn-client/yume_api.py

# Expose REST API port
EXPOSE 8000

# Run the YUME REST API server
CMD ["python", "-u", "/opt/dgn-client/yume_api.py"]
