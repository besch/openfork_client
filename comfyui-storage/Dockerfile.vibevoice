# syntax=docker/dockerfile:1.4
# VibeVoice TTS Docker Image - OPTIMIZED

# Use runtime instead of devel - saves ~3-5GB
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined with --no-install-recommends and cleanup
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined into single layer
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg gguf uv huggingface_hub

WORKDIR /opt/ComfyUI

# Clone all repos with --depth=1, remove .git directories, install requirements
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-Manager/requirements.txt \
    && git clone --depth=1 https://github.com/kijai/ComfyUI-KJNodes.git custom_nodes/comfyui-kjnodes \
    && rm -rf custom_nodes/comfyui-kjnodes/.git \
    && git clone --depth=1 https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git \
    && git clone --depth=1 https://github.com/WASasquatch/was-node-suite-comfyui.git custom_nodes/was-node-suite-comfyui \
    && rm -rf custom_nodes/was-node-suite-comfyui/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/was-node-suite-comfyui/requirements.txt \
    && git clone --depth=1 https://github.com/Enemyx-net/VibeVoice-ComfyUI.git custom_nodes/VibeVoice-ComfyUI \
    && rm -rf custom_nodes/VibeVoice-ComfyUI/.git \
    && python -m pip install --no-cache-dir transformers==4.51.3 \
    && python -m pip install --no-cache-dir -r custom_nodes/VibeVoice-ComfyUI/requirements.txt \
    && git clone --depth=1 https://github.com/christian-byrne/audio-separation-nodes-comfyui.git custom_nodes/audio-separation-nodes-comfyui \
    && rm -rf custom_nodes/audio-separation-nodes-comfyui/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/audio-separation-nodes-comfyui/requirements.txt \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true

# Copy user configurations
COPY --chown=user:user ./storage/ComfyUI/user /opt/ComfyUI/user

# Download VibeVoice models (combined into single layer)
RUN mkdir -p models/vibevoice \
    && huggingface-cli download microsoft/VibeVoice-1.5B --local-dir models/vibevoice/VibeVoice-1.5B \
    && huggingface-cli download Qwen/Qwen2.5-1.5B \
        tokenizer_config.json vocab.json merges.txt tokenizer.json \
        --local-dir models/vibevoice/tokenizer \
        --local-dir-use-symlinks=False \
    && rm -rf ~/.cache/huggingface

WORKDIR /opt/ComfyUI
CMD ["sh", "-c", "export PYTHONPATH=$PYTHONPATH:/opt/ComfyUI/user/custom-packages; cd /opt/ComfyUI && python main.py --listen"]
