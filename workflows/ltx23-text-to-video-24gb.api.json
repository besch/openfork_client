{
  "prompt": {
    "1": {
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": { "title": "Load LTX-2.3 Checkpoint" }
    },

    "2": {
      "inputs": {
        "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
        "ckpt_name": "ltx-2.3-22b-dev.safetensors",
        "device": "cpu"
      },
      "class_type": "LTXAVTextEncoderLoader",
      "_meta": { "title": "Load Gemma FP4 Text Encoder (CPU offload)" }
    },

    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Positive Prompt" }
    },

    "4": {
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },

    "5": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning",
      "_meta": { "title": "LTX-V Conditioning" }
    },

    "6": {
      "inputs": {
        "width": 384,
        "height": 224,
        "length": 121,
        "batch_size": 1
      },
      "class_type": "EmptyLTXVLatentVideo",
      "_meta": {
        "title": "Stage 1: Empty Video Latent (half-res 384x224, 121 frames)"
      }
    },

    "10": {
      "inputs": {
        "model": ["22", 0],
        "vae": ["1", 2],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "latents": ["6", 0],
        "num_steps": 15,
        "cfg": 3.0,
        "seed": 0,
        "guiding_start_step": 2,
        "guiding_end_step": 13
      },
      "class_type": "LTXVBaseSampler",
      "_meta": {
        "title": "Stage 1: Generate (half-res, 15 steps, handles NestedTensor decode)"
      }
    },

    "22": {
      "inputs": {
        "model": ["1", 0],
        "lora_name": "ltx-2.3-22b-distilled-lora-384.safetensors",
        "strength_model": 1.0
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": { "title": "Apply Distilled LoRA" }
    },

    "30": {
      "inputs": {
        "model_name": "ltx-2.3-spatial-upscaler-x2-1.0.safetensors"
      },
      "class_type": "LatentUpscaleModelLoader",
      "_meta": { "title": "Stage 2: Load Spatial Upscaler x2" }
    },

    "40": {
      "inputs": {
        "model": ["30", 0],
        "vae": ["1", 2],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "latents": ["10", 0],
        "num_steps": 10,
        "cfg": 1.0,
        "seed": 0,
        "guiding_start_step": 2,
        "guiding_end_step": 8
      },
      "class_type": "LTXVBaseSampler",
      "_meta": {
        "title": "Stage 2: Spatial Upscale + Refine (384x224->768x448, 10 steps, cfg=1)"
      }
    },

    "50": {
      "inputs": {
        "images": ["40", 0],
        "fps": 24,
        "audio": ["60", 0]
      },
      "class_type": "CreateVideo",
      "_meta": { "title": "Create Video" }
    },

    "60": {
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev.safetensors"
      },
      "class_type": "LTXVAudioVAELoader",
      "_meta": { "title": "Load Audio VAE" }
    },

    "61": {
      "inputs": {
        "audio_vae": ["60", 0],
        "frames_number": 121,
        "frame_rate": 24,
        "batch_size": 1
      },
      "class_type": "LTXVEmptyLatentAudio",
      "_meta": { "title": "Empty Audio Latent (silent audio)" }
    },

    "62": {
      "inputs": {
        "samples": ["61", 0],
        "audio_vae": ["60", 0]
      },
      "class_type": "LTXVAudioVAEDecode",
      "_meta": { "title": "Decode Audio (silent)" }
    },

    "70": {
      "inputs": {
        "video": ["50", 0],
        "filename_prefix": "ltx23_t2v",
        "format": "auto",
        "codec": "auto"
      },
      "class_type": "SaveVideo",
      "_meta": { "title": "Save Video" }
    }
  }
}
