# syntax=docker/dockerfile:1.4
# Qwen Image Edit 8GB (GGUF Q4) Docker Image - OPTIMIZED
# NOTE: Keeping devel for SageAttention compilation at runtime

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision==0.22.1+cu128 torchaudio==2.7.1+cu128 \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg ninja gguf uv

# Clone SageAttention for runtime compilation
RUN git clone --depth=1 https://github.com/thu-ml/SageAttention.git /opt/sageattention \
    && rm -rf /opt/sageattention/.git

WORKDIR /opt/ComfyUI

# Clone repos with --depth=1, remove .git
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-Manager/requirements.txt \
    && git clone --depth=1 https://github.com/kijai/ComfyUI-KJNodes.git custom_nodes/comfyui-kjnodes \
    && rm -rf custom_nodes/comfyui-kjnodes/.git \
    && git clone --depth=1 https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git \
    && git clone --depth=1 https://github.com/WASasquatch/was-node-suite-comfyui.git custom_nodes/was-node-suite-comfyui \
    && rm -rf custom_nodes/was-node-suite-comfyui/.git \
    && python -m pip install --no-cache-dir -r custom_nodes/was-node-suite-comfyui/requirements.txt \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# ComfyUI/custom-node requirements can drift the torch stack. Re-pin after all
# Python package installs so cloud startup does not spend minutes repairing it.
RUN python -m pip install --no-cache-dir --force-reinstall \
        --index-url https://download.pytorch.org/whl/cu128 \
        --extra-index-url https://pypi.org/simple \
        torch==2.7.1+cu128 torchvision==0.22.1+cu128 torchaudio==2.7.1+cu128 \
    && python -c "import torch, torchvision, torchaudio; print('torch=%s torchvision=%s torchaudio=%s' % (torch.__version__, torchvision.__version__, torchaudio.__version__))"

# Create model directories and download models (GGUF Q4 for 8GB)
RUN mkdir -p models/text_encoders models/unet models/vae models/loras \
    && wget -q -O models/unet/qwen-image-edit-2511-Q4_K_M.gguf \
        "https://huggingface.co/unsloth/Qwen-Image-Edit-2511-GGUF/resolve/main/qwen-image-edit-2511-Q4_K_M.gguf" \
    && wget -q -O models/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors \
        "https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors" \
    && wget -q -O models/vae/qwen_image_vae.safetensors \
        "https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/vae/qwen_image_vae.safetensors" \
    && wget -q -O models/loras/Qwen-Image-Lightning-8steps-V1.1.safetensors \
        "https://huggingface.co/lightx2v/Qwen-Image-Lightning/resolve/main/Qwen-Image-Lightning-8steps-V1.1.safetensors"

RUN mkdir -p user/__manager \
    && printf "[default]\nnetwork_mode = offline\n" > user/__manager/config.ini

WORKDIR /opt/ComfyUI
CMD ["sh", "-c", "export PYTHONPATH=$PYTHONPATH:/opt/ComfyUI/user/custom-packages; if [ ! -d /opt/ComfyUI/user/custom-packages/sageattention ]; then echo 'SageAttention not found in persistent volume, attempting installation...'; python -m pip install -v --target=/opt/ComfyUI/user/custom-packages /opt/sageattention || (echo 'ERROR: SageAttention installation failed. Please ensure GPU is accessible.' && exit 1); else echo 'SageAttention already installed in persistent volume.'; fi; cd /opt/ComfyUI && python main.py --listen"]
