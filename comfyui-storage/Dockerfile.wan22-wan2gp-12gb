# OpenFork - WAN 2.2 on Wan2GP (12GB experimental)
#
# Provides:
#   - Wan2GP at /opt/wan2gp
#   - WAN 2.2 T2V/I2V 14B high/low quanto mfp16 int8 transformers
#   - WAN 2.1/WAN 2.2 VAEs and UMT5 text encoder support files
#
# Build:
#   docker build \
#     -t beschiak/openfork-wan22-wan2gp-12gb:latest \
#     -f Dockerfile.wan22-wan2gp-12gb .

ARG HF_TOKEN

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ARG HF_TOKEN

ENV DEBIAN_FRONTEND=noninteractive
ENV WAN2GP_ROOT=/opt/wan2gp
ENV WAN2GP_OUTPUT=/opt/wan2gp/outputs
ENV CUDA_MODULE_LOADING=LAZY
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128,garbage_collection_threshold:0.8
ENV MALLOC_ARENA_MAX=2
ENV WAN22_TRANSFORMER_VARIANT=quanto_mfp16_int8
ENV WAN2GP_CLI_ARGS="--profile 4.5 --attention sdpa --perc-reserved-mem-max 0.35 --vram-safety-coefficient 0.65"

RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git wget curl cmake ninja-build \
        build-essential g++ \
        libgl1 libglib2.0-0 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python
RUN pip3 install --upgrade pip setuptools wheel

RUN pip3 install \
        torch==2.7.0+cu128 \
        torchvision==0.22.0+cu128 \
        torchaudio==2.7.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/deepbeepmeep/Wan2GP /opt/wan2gp \
    && git -C /opt/wan2gp checkout main

RUN pip3 install \
        --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ort-cuda-13-nightly/pypi/simple/ \
        -r /opt/wan2gp/requirements.txt \
    || pip3 install -r /opt/wan2gp/requirements.txt

RUN pip3 install \
        torch==2.7.0+cu128 \
        torchvision==0.22.0+cu128 \
        torchaudio==2.7.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128

RUN mkdir -p /opt/wan2gp/ckpts /opt/wan2gp/outputs /opt/wan2gp/input

RUN pip3 install -q "huggingface_hub[cli]"

RUN if [ -n "${HF_TOKEN}" ]; then HF_TOKEN_ARG="--token ${HF_TOKEN}"; else HF_TOKEN_ARG=""; fi; \
    huggingface-cli download DeepBeepMeep/Wan2.2 \
        "wan2.2_text2video_14B_high_${WAN22_TRANSFORMER_VARIANT}.safetensors" \
        "wan2.2_text2video_14B_low_${WAN22_TRANSFORMER_VARIANT}.safetensors" \
        "wan2.2_image2video_14B_high_${WAN22_TRANSFORMER_VARIANT}.safetensors" \
        "wan2.2_image2video_14B_low_${WAN22_TRANSFORMER_VARIANT}.safetensors" \
        Wan2.2_VAE.safetensors \
        --local-dir /opt/wan2gp/ckpts \
        ${HF_TOKEN_ARG} \
    || { echo "ERROR: WAN 2.2 transformer/VAE download failed."; exit 1; }

RUN if [ -n "${HF_TOKEN}" ]; then HF_TOKEN_ARG="--token ${HF_TOKEN}"; else HF_TOKEN_ARG=""; fi; \
    huggingface-cli download DeepBeepMeep/Wan2.1 \
        Wan2.1_VAE.safetensors \
        umt5-xxl/special_tokens_map.json \
        umt5-xxl/spiece.model \
        umt5-xxl/tokenizer.json \
        umt5-xxl/tokenizer_config.json \
        umt5-xxl/models_t5_umt5-xxl-enc-bf16.safetensors \
        umt5-xxl/models_t5_umt5-xxl-enc-quanto_int8.safetensors \
        --local-dir /opt/wan2gp/ckpts \
        ${HF_TOKEN_ARG} \
    || { echo "ERROR: WAN 2.1 VAE/UMT5 support file download failed."; exit 1; }

RUN pip3 install fastapi "uvicorn[standard]"

COPY wan2gp_server.py /opt/wan2gp/wan2gp_server.py

RUN python3 -c "import os; root='/opt/wan2gp/ckpts'; variant=os.environ['WAN22_TRANSFORMER_VARIANT']; required=[f'wan2.2_text2video_14B_high_{variant}.safetensors',f'wan2.2_text2video_14B_low_{variant}.safetensors',f'wan2.2_image2video_14B_high_{variant}.safetensors',f'wan2.2_image2video_14B_low_{variant}.safetensors','Wan2.1_VAE.safetensors','Wan2.2_VAE.safetensors','umt5-xxl/models_t5_umt5-xxl-enc-bf16.safetensors','umt5-xxl/models_t5_umt5-xxl-enc-quanto_int8.safetensors']; missing=[p for p in required if not os.path.isfile(os.path.join(root,p))]; assert not missing, missing; print('WAN 2.2 Wan2GP 12GB files: OK')"

WORKDIR /opt/wan2gp

CMD ["python3", "/opt/wan2gp/wan2gp_server.py"]
