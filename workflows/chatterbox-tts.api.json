{
  "prompt": {
    "1": {
      "class_type": "ChatterboxTTS",
      "inputs": {
        "model_pack_name": "resembleai_default_voice",
        "text": "Hello, this is a test.",
        "max_new_tokens": 2048,
        "flow_cfg_scale": 0.7,
        "exaggeration": 0.5,
        "temperature": 0.8,
        "cfg_weight": 0.5,
        "repetition_penalty": 1.2,
        "min_p": 0.05,
        "top_p": 1.0,
        "seed": 0,
        "use_watermark": false
      }
    },
    "2": {
      "class_type": "SaveAudio",
      "inputs": {
        "audio": ["1", 0],
        "filename_prefix": "chatterbox_output"
      }
    }
  }
}
