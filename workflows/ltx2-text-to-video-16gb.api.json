      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode with Optimal Tiling (16GB)",
        "notes": "tile_size: 384 works well on 16GB. Use 512 if VRAM allows."
      }
    },
    "13": {
      "inputs": {
        "images": ["12", 0],
        "fps": 24
      },
      "class_type": "CreateVideo"
