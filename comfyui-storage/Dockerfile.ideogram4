# syntax=docker/dockerfile:1.4
# Ideogram 4 Docker Image
# Build args:
#   IDEOGRAM_QUANTIZATION=nf4|fp8
#   HF_TOKEN=hf_xxx for gated Hugging Face model access

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DEFAULT_TIMEOUT=120
ENV HF_HOME=/app/models
ENV HUGGINGFACE_HUB_CACHE=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV HF_HUB_DISABLE_PROGRESS_BARS=1
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ARG IDEOGRAM_QUANTIZATION=nf4
ENV IDEOGRAM_QUANTIZATION=${IDEOGRAM_QUANTIZATION}
ENV IDEOGRAM_SAMPLER_PRESET=V4_QUALITY_48
ENV IDEOGRAM_USE_MAGIC_PROMPT=0
ENV IDEOGRAM_MODEL_LOAD_TIMEOUT=1800
ENV IDEOGRAM4_API_WAIT_TIMEOUT=1800

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git wget libgl1-mesa-glx ffmpeg build-essential \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip

RUN mkdir -p /tmp/pip-cache \
    && for attempt in 1 2 3; do \
        PIP_NO_CACHE_DIR=0 python -m pip install \
            --cache-dir /tmp/pip-cache \
            --retries 10 \
            --timeout 120 \
            "torch>=2.11" \
            --index-url https://download.pytorch.org/whl/cu128 \
        && break; \
        status=$?; \
        echo "Torch install failed on attempt ${attempt}, retrying..."; \
        if [ "$attempt" -eq 3 ]; then exit "$status"; fi; \
        sleep 15; \
    done \
    && rm -rf /tmp/pip-cache

RUN python -m pip install --no-cache-dir \
        transformers>=4.51.0 \
        accelerate>=1.3.0 \
        sentencepiece \
        huggingface_hub \
        Pillow \
        fastapi \
        "uvicorn[standard]" \
        python-multipart \
        requests \
        safetensors \
        bitsandbytes

ARG IDEOGRAM4_REF=main
RUN git clone --depth 1 --branch "${IDEOGRAM4_REF}" https://github.com/ideogram-oss/ideogram4.git /opt/ideogram4 \
    && cd /opt/ideogram4 \
    && python -m pip install --no-cache-dir -e .

RUN mkdir -p /app/input /app/output /app/models

ARG HF_TOKEN=""
RUN HF_TOKEN="$HF_TOKEN" python - <<'PY'
import os
from huggingface_hub import snapshot_download

repos = {
    "nf4": "ideogram-ai/ideogram-4-nf4",
    "fp8": "ideogram-ai/ideogram-4-fp8",
}
quantization = os.environ.get("IDEOGRAM_QUANTIZATION", "nf4").lower()
repo_id = repos.get(quantization)
if not repo_id:
    raise SystemExit(f"Unsupported IDEOGRAM_QUANTIZATION={quantization}")
snapshot_download(
    repo_id,
    cache_dir="/app/models",
    token=os.environ.get("HF_TOKEN") or None,
)
PY

COPY ideogram4_api.py /app/ideogram4_api.py

EXPOSE 8000

CMD ["python", "/app/ideogram4_api.py"]
