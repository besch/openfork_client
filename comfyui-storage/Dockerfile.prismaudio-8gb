# syntax=docker/dockerfile:1.4
# Prism Audio (PRiSM) 8GB Docker Image
# Video-to-audio generation with Multi-dimensional CoT

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies
# python3-distutils used instead of python3.10-distutils (removed in Ubuntu 22.04)
# ffmpeg is NOT installed via apt — build_env.sh installs 'ffmpeg<7' via conda-forge
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3-distutils \
    curl git wget libsm6 libxext6 libsndfile1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Install Miniconda — required by build_env.sh
RUN wget -q https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh -O /tmp/miniconda.sh \
    && bash /tmp/miniconda.sh -b -p /opt/conda \
    && rm /tmp/miniconda.sh \
    && /opt/conda/bin/conda clean -afy

ENV PATH=/opt/conda/bin:$PATH

# Accept Anaconda ToS for the default channels (required since Miniconda 24.x)
RUN conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main \
    && conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r

# Clone PRiSM repo — canonical org is FunAudioLLM, branch prismaudio
RUN git clone -b prismaudio https://github.com/FunAudioLLM/ThinkSound.git /app \
    && rm -rf .git

# Create the conda env then run the official setup script (ffmpeg<7, all deps)
RUN conda create -n prismaudio python=3.10 -y \
    && chmod +x scripts/PrismAudio/setup/build_env.sh \
    && conda run -n prismaudio bash scripts/PrismAudio/setup/build_env.sh \
    && conda run -n prismaudio pip install -e /app \
    && conda clean -afy \
    && rm -rf ~/.cache/pip /tmp/*

# Fix dependency conflicts in a single pip pass to avoid resolver back-tracking:
# - protobuf>=3.20,<4.0: >=3.20 required so TF-generated .pb2 files can import
#   google.protobuf.internal.builder (added in 3.20); <4.0 keeps MessageFactory.GetPrototype
# - transformers<4.45 ensures T5EncoderModel is available
# - numpy>=1.24,<2.0: JAX >= 0.4.14 needs np.dtypes (added in numpy 1.24); <2.0 avoids
#   numpy 2.x API breakage elsewhere in the stack
RUN conda run -n prismaudio pip install \
    "protobuf>=3.20,<4.0" \
    "transformers<4.45,>=4.30" \
    "numpy>=1.24,<2.0" \
    && rm -rf ~/.cache/pip

# Create working directories
RUN mkdir -p /app/input /app/output /app/ckpts

# Download model weights from HuggingFace
# HF_TOKEN is required if the repo is gated; pass via --build-arg HF_TOKEN=hf_...
ARG HF_TOKEN
RUN HF_TOKEN=$HF_TOKEN conda run -n prismaudio python -c "\
from huggingface_hub import snapshot_download; \
import os, sys; \
os.makedirs('/app/ckpts', exist_ok=True); \
snapshot_download('FunAudioLLM/PrismAudio', local_dir='/app/ckpts', token=os.environ.get('HF_TOKEN') or None); \
files = [f for f in os.walk('/app/ckpts')]; \
print('PRiSM weights downloaded successfully'); \
[print(' ', root, f) for root, dirs, fs in files for f in fs]" \
    && rm -rf ~/.cache/pip

# Pre-download T5 text encoder loaded at startup by feature_utils_288.py:
#   self.t5 = AutoModelForSeq2SeqLM.from_pretrained("google/t5gemma-l-l-ul2-it")
#   self.t5tokenizer = AutoTokenizer.from_pretrained("google/t5gemma-l-l-ul2-it")
# Without this the container crashes immediately because HF_HUB_OFFLINE=1 at runtime.
RUN HF_TOKEN=$HF_TOKEN conda run -n prismaudio python -c "\
from transformers import AutoModelForSeq2SeqLM, AutoTokenizer; \
import os; \
token = os.environ.get('HF_TOKEN') or None; \
print('Downloading google/t5gemma-l-l-ul2-it model...'); \
AutoModelForSeq2SeqLM.from_pretrained('google/t5gemma-l-l-ul2-it', token=token); \
AutoTokenizer.from_pretrained('google/t5gemma-l-l-ul2-it', token=token); \
print('T5 text encoder pre-cached successfully')"

# Copy the API script at build time (used as fallback if curl fails at runtime)
COPY prismaudio_api.py /app/prismaudio_api.py

# Expose API port
EXPOSE 8000

# At runtime: attempt to pull the latest API script; fail loudly if unreachable.
# HF_HUB_OFFLINE is set here (not as ENV) so it does not interfere with build-time downloads.
CMD ["/bin/bash", "-c", \
    "curl -fsSL -o /app/prismaudio_api.py https://raw.githubusercontent.com/besch/openfork_client/main/comfyui-storage/prismaudio_api.py || { echo 'WARNING: Could not update prismaudio_api.py, using built-in copy'; }; \
    HF_HUB_OFFLINE=1 conda run -n prismaudio python /app/prismaudio_api.py"]