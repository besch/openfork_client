FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev curl git \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Install PyTorch with CUDA 12.8 wheels explicitly
RUN python -m pip install torch==2.7.1+cu128 torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cu128

# Install other dependencies as before, including gitpython to fix 'git' module error
RUN python -m pip install gitpython PyYAML opencv-python imageio-ffmpeg

# Set working directory back to /opt/ComfyUI
WORKDIR /opt/ComfyUI

# Clone ComfyUI and custom nodes as before
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI

# Clone ComfyUI Manager into custom_nodes
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git /opt/ComfyUI/custom_nodes/ComfyUI-Manager

# Clone HunyuanVideoFoley
RUN git clone https://github.com/if-ai/ComfyUI_HunyuanVideoFoley.git /opt/ComfyUI/custom_nodes/ComfyUI_HunyuanVideoFoley

# Clone VideoHelperSuite
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git /opt/ComfyUI/custom_nodes/VideoHelperSuite

# Install dependencies for custom nodes
RUN python -m pip install -r /opt/ComfyUI/custom_nodes/ComfyUI-Manager/requirements.txt
RUN python -m pip install -r /opt/ComfyUI/custom_nodes/ComfyUI_HunyuanVideoFoley/requirements.txt
RUN python -m pip install timm decord
RUN python -m pip install -U av

# Install main requirements
RUN python -m pip install -r requirements.txt

# Force reinstall correct torch version
RUN python -m pip install --force-reinstall torch==2.7.1+cu128 torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cu128

# Run install script for foley
# This is now run at container startup via CMD to ensure models are in the mounted volume
# RUN python /opt/ComfyUI/custom_nodes/ComfyUI_HunyuanVideoFoley/install.py

# Install additional system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Install uv for ComfyUI-Manager
RUN python -m pip install uv

# Set final working directory and command
WORKDIR /opt/ComfyUI
CMD ["sh", "-c", "python /opt/ComfyUI/custom_nodes/ComfyUI_HunyuanVideoFoley/install.py && python /opt/ComfyUI/custom_nodes/ComfyUI_HunyuanVideoFoley/install.py --quantization fp8 && (mv /opt/ComfyUI/models/foley/hunyuanvideo-foley-xxl/hunyuanvideo_foley.fp8.pth /opt/ComfyUI/models/foley/hunyuanvideo-foley-xxl/hunyuanvideo_foley.fp8_e5m2.pth || true) && python main.py --listen"]
