{
  "prompt": {
    "1": {
      "class_type": "VibeVoiceMultipleSpeakersNode",
      "inputs": {
        "text": "[1]: Hello, this is a test.\n[2]: And this is another test.",
        "model": "VibeVoice-1.5B",
        "attention_type": "auto",
        "quantize_llm": "full precision",
        "free_memory_after_generate": true,
        "diffusion_steps": 10,
        "temperature": 0.8,
        "cfg_scale": 3.5,
        "top_p": 0.95,
        "use_sampling": false,
        "seed": 0,
        "speaker1_voice": "clone1.wav",
        "speaker2_voice": "clone2.wav"
      }
    },
    "2": {
      "class_type": "AudioSeparation",
      "inputs": {
        "audio": ["1", 0],
        "chunk_fade_shape": "linear",
        "chunk_length": 10.0,
        "chunk_overlap": 0.1
      }
    },
    "3": {
      "class_type": "SaveAudio",
      "inputs": {
        "audio": ["2", 3],
        "filename_prefix": "vibevoice_multi_clone_output"
      }
    }
  }
}