{
  "prompt": {
    "1": {
      "inputs": {
        "ckpt_name": "ltx-2-19b-distilled-fp8.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": {
        "title": "Load LTX-2 FP8 Distilled Model (16GB optimized)"
      }
    },
    "2": {
      "inputs": {
        "clip_name1": "gemma-3-12b-it-fp8/gemma_3_12B_it_fp8_e4m3fn.safetensors",
        "clip_name2": "gemma-3-12b-it-fp8/ltx-2-19b-dev-fp4_projections_only.safetensors",
        "type": "ltxv"
      },
      "class_type": "DualCLIPLoader",
      "_meta": {
        "title": "Load FP8 Text Encoder"
      }
    },
    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive Prompt"
      }
    },
    "4": {
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative Prompt"
      }
    },
    "5": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning"
    },
    "6": {
      "inputs": {
        "model": ["1", 0],
        "block_indices": "14, 19"
      },
      "class_type": "LTXVApplySTG"
    },
    "7": {
      "inputs": {
        "model": ["6", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "cfg": 3.0,
        "stg": 1.0,
        "rescale": 0.7
      },
      "class_type": "STGGuider"
    },
    "8": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect"
    },
    "9": {
      "inputs": {
        "model": ["1", 0],
        "scheduler": "normal",
        "steps": 30,
        "denoise": 1.0
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "Scheduler (can reduce to 15-20 with distilled LoRA)"
      }
    },
    "10": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "11": {
      "inputs": {
        "model": ["1", 0],
        "vae": ["1", 2],
        "width": 768,
        "height": 512,
        "num_frames": 97,
        "guider": ["7", 0],
        "sampler": ["8", 0],
        "sigmas": ["9", 0],
        "noise": ["10", 0]
      },
      "class_type": "LTXVBaseSampler",
      "_meta": {
        "title": "16GB Optimized: 768x512 (720p), 97 frames (4 seconds)",
        "notes": "Can push to 1024x576 at 73 frames (3s) or 768x512 at 145 frames (6s)"
      }
    },
    "12": {
      "inputs": {
        "samples": ["11", 0],
        "vae": ["1", 2],
        "tile_size": 512,
        "overlap": 64
      },
      "class_type": "VAEDecode",
      "_meta": {
        "title": "VAE Decode with moderate tiling (ADDED FOR 16GB)",
        "notes": "Tiling prevents OOM during decode. tile_size 512 is good balance for 16GB."
      }
    },
    "13": {
      "inputs": {
        "images": ["12", 0],
        "fps": 24
      },
      "class_type": "CreateVideo"
    },
    "14": {
      "inputs": {
        "video": ["13", 0],
        "filename_prefix": "ltx2_t2v_16gb",
        "format": "auto",
        "codec": "auto",
        "quality": "auto"
      },
      "class_type": "SaveVideo"
    }
  },
  "_meta": {
    "16gb_optimization_notes": {
      "critical_fix": "Added tiling to VAEDecode (was missing, would cause OOM)",
      "performance": "2-3x faster than 8GB due to no CPU offloading",
      "recommended_settings": {
        "balanced_quality": {
          "width": 768,
          "height": 512,
          "num_frames": 97,
          "duration": "4 seconds",
          "tile_size": 512,
          "expected_vram": "14-16GB"
        },
        "high_resolution_short": {
          "width": 1024,
          "height": 576,
          "num_frames": 73,
          "duration": "3 seconds",
          "tile_size": 384,
          "expected_vram": "15-17GB",
          "note": "Push limits with 1080p quality"
        },
        "longer_duration": {
          "width": 768,
          "height": 512,
          "num_frames": 145,
          "duration": "6 seconds",
          "tile_size": 512,
          "expected_vram": "16-18GB",
          "note": "May need to close other apps"
        }
      },
      "vram_breakdown": {
        "model_loading": "~10GB (FP8 distilled)",
        "vae_gpu": "~2-3GB (fast, on GPU)",
        "frame_buffer": "~2-3GB",
        "cuda_overhead": "~0.5GB",
        "total": "~14-16GB"
      },
      "performance_tips": [
        "VAE runs on GPU (fast) - no CPU offloading needed",
        "Moderate tiling (512) prevents OOM without major slowdown",
        "Can experiment with higher resolutions at shorter durations",
        "Consider using distilled LoRA to reduce steps from 30 to 15-20",
        "No need to restart between generations like 8GB"
      ]
    }
  }
}