# LTX-2 19B Docker Image (8GB VRAM Optimized) - FULLY CORRECTED v2
# Based on verified Kijai/LTXV2_comfy and GitMylo repositories
# Uses FP8 quantized models with DualCLIPLoader approach
# Tested configuration for RTX 4060/3060 8GB cards

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Build arguments for HuggingFace authentication
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    curl \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    git-lfs \
    ffmpeg \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch 2.5.1 with CUDA 12.1
RUN python -m pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Install core dependencies
RUN python -m pip install --no-cache-dir \
    "huggingface-hub[cli]==0.26.2" \
    einops==0.8.0 \
    transformers==4.46.3 \
    diffusers==0.32.1 \
    accelerate==1.2.1 \
    safetensors==0.4.5 \
    Pillow==10.4.0 \
    numpy==1.26.4 \
    scipy==1.14.1 \
    opencv-python==4.10.0.84 \
    imageio==2.36.0 \
    imageio-ffmpeg==0.5.1 \
    PyYAML==6.0.2 \
    requests==2.32.3 \
    tqdm==4.67.1 \
    psutil==6.1.0 \
    sentencepiece==0.2.0 \
    protobuf==5.28.3 \
    comfy-kitchen>=0.1.0

# ComfyUI dependencies
RUN python -m pip install --no-cache-dir \
    aiohttp==3.11.10 \
    kornia==0.7.3 \
    spandrel==0.4.0 \
    soundfile==0.12.1 \
    matplotlib==3.9.2 \
    gitpython==3.1.43

WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git checkout master \
    && rm -rf .git

# Install ComfyUI requirements
RUN cd /opt/ComfyUI && python -m pip install --no-cache-dir -r requirements.txt

# Clone ComfyUI-Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git

# Clone ComfyUI-LTXVideo (essential for LTX-2)
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && cd custom_nodes/ComfyUI-LTXVideo \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# Patch embeddings_connector.py
RUN find custom_nodes/ComfyUI-LTXVideo -name "embeddings_connector.py" -exec python3 -c "import sys; path=sys.argv[1]; print(f'Patching {path}'); content=open(path).read(); content=content.replace('repeat(hidden_states.shape[0], 1, 1))', 'repeat(hidden_states.shape[0], 1, 1).to(hidden_states.device))'); open(path,'w').write(content)" {} \;

# Clone VideoHelperSuite
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && cd custom_nodes/VideoHelperSuite \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# Create model directories
RUN mkdir -p \
    models/checkpoints \
    models/unet \
    models/clip \
    models/vae \
    models/latent_upscale_models \
    models/loras \
    input \
    output \
    temp

# ============================================================================
# MODEL DOWNLOADS - VERIFIED 8GB VRAM CONFIGURATION
# ============================================================================

# Download LTX-2 FP8 diffusion model (~21.6GB)
# Source: Kijai/LTXV2_comfy
RUN echo "Downloading LTX-2 FP8 diffusion model..." && \
    huggingface-cli download Kijai/LTXV2_comfy \
    --repo-type model \
    --local-dir /tmp/kijai_models \
    --include "diffusion_models/ltx-2-19b-dev-fp8_transformer_only.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/kijai_models/diffusion_models/ltx-2-19b-dev-fp8_transformer_only.safetensors \
       models/unet/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ FP8 diffusion model downloaded (21.6GB)" && \
    ls -lh models/unet/

# Download VAE (~5GB)
# Source: Kijai/LTXV2_comfy
RUN echo "Downloading VAE..." && \
    huggingface-cli download Kijai/LTXV2_comfy \
    --repo-type model \
    --local-dir /tmp/kijai_models \
    --include "VAE/LTX2_video_vae_bf16.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/kijai_models/VAE/LTX2_video_vae_bf16.safetensors models/vae/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ VAE downloaded (5GB)" && \
    ls -lh models/vae/

# Download Gemma-3 12B FP8 text encoder (~13.2GB)
# CRITICAL: This is the FP8 conversion for 8GB VRAM
# Source: GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn
RUN echo "Downloading Gemma-3 12B FP8 text encoder..." && \
    huggingface-cli download GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn \
    --repo-type model \
    --local-dir /tmp/fp8_models \
    --include "gemma_3_12B_it_fp8_e4m3fn.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/fp8_models/gemma_3_12B_it_fp8_e4m3fn.safetensors \
       models/clip/ && \
    rm -rf /tmp/fp8_models && \
    echo "✓ Gemma-3 FP8 downloaded (13.2GB)" && \
    ls -lh models/clip/

# Download LTX-2 projections for DualCLIPLoader (~2.86GB)
# CRITICAL: This file enables DualCLIPLoader compatibility
# Source: GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn
RUN echo "Downloading LTX-2 projections..." && \
    huggingface-cli download GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn \
    --repo-type model \
    --local-dir /tmp/fp8_models \
    --include "ltx-2-19b-dev-fp4_projections_only.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/fp8_models/ltx-2-19b-dev-fp4_projections_only.safetensors \
       models/clip/ && \
    rm -rf /tmp/fp8_models && \
    echo "✓ Projections downloaded (2.86GB)" && \
    ls -lh models/clip/

# Download spatial upscaler (996MB)
RUN echo "Downloading spatial upscaler..." && \
    huggingface-cli download Lightricks/LTX-2 \
    --repo-type model \
    --local-dir /tmp/lightricks_models \
    --include "ltx-2-spatial-upscaler-x2-1.0.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lightricks_models/ltx-2-spatial-upscaler-x2-1.0.safetensors \
       models/latent_upscale_models/ && \
    rm -rf /tmp/lightricks_models && \
    echo "✓ Spatial upscaler downloaded"

# Download distilled LoRA
RUN echo "Downloading distilled LoRA..." && \
    huggingface-cli download Lightricks/LTX-2 \
    --repo-type model \
    --local-dir /tmp/lightricks_models \
    --include "ltx-2-19b-distilled-lora-384.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lightricks_models/ltx-2-19b-distilled-lora-384.safetensors \
       models/loras/ && \
    rm -rf /tmp/lightricks_models && \
    echo "✓ Distilled LoRA downloaded"

# Download Camera Control LoRAs
RUN echo "Downloading camera control LoRAs..." && \
    for lora in \
        "Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-In:ltx-2-19b-lora-camera-control-dolly-in.safetensors" \
        "Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Out:ltx-2-19b-lora-camera-control-dolly-out.safetensors" \
        "Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Left:ltx-2-19b-lora-camera-control-dolly-left.safetensors" \
        "Lightricks/LTX-2-19b