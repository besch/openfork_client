# syntax=docker/dockerfile:1.4
# Qwen3-TTS Docker Image - 8GB/16GB VRAM Optimized
# Supports: CustomVoice TTS, Voice Design, Voice Cloning

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV HF_HOME=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV TORCH_HOME=/app/models
ENV HF_HUB_DISABLE_PROGRESS_BARS=1
ENV HF_HUB_DISABLE_TELEMETRY=1

# System dependencies - Python 3.12
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    curl git wget ffmpeg libsndfile1 sox \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Install PyTorch with CUDA 12.4 support
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.4.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu124

# Install qwen-tts package and dependencies with tqdm fix
RUN python -m pip install --no-cache-dir \
    qwen-tts \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    requests \
    soundfile \
    numpy \
    "tqdm>=4.66.0"

# Install huggingface-hub CLI for reliable model downloads
RUN python -m pip install --no-cache-dir "huggingface_hub[cli]>=0.20.0"

# Install FlashAttention 2 for memory efficiency (optional, may fail on some systems)
RUN MAX_JOBS=4 python -m pip install --no-cache-dir flash-attn --no-build-isolation || \
    echo "FlashAttention 2 installation failed, continuing without it"

# Create directories
RUN mkdir -p /app/input /app/output /app/models

# Build argument for model size (0.6B or 1.7B)
ARG MODEL_SIZE=0.6B
ENV QWEN_MODEL_SIZE=${MODEL_SIZE}

# Pre-download models using huggingface-cli (more reliable than Python snapshot_download)
# This ensures complete file downloads including preprocessor_config.json

# Always download the tokenizer (shared across all models)
RUN huggingface-cli download Qwen/Qwen3-TTS-Tokenizer-12Hz \
    --cache-dir /app/models \
    --local-dir-use-symlinks False

# Download 0.6B models (default for 8GB variant)
RUN huggingface-cli download Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice \
    --cache-dir /app/models \
    --local-dir-use-symlinks False

RUN huggingface-cli download Qwen/Qwen3-TTS-12Hz-0.6B-Base \
    --cache-dir /app/models \
    --local-dir-use-symlinks False

# For 1.7B variant (16GB), download additional models
RUN if [ "$MODEL_SIZE" = "1.7B" ]; then \
        echo "Downloading 1.7B models for 16GB variant..."; \
        huggingface-cli download Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice \
            --cache-dir /app/models \
            --local-dir-use-symlinks False && \
        huggingface-cli download Qwen/Qwen3-TTS-12Hz-1.7B-Base \
            --cache-dir /app/models \
            --local-dir-use-symlinks False && \
        huggingface-cli download Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign \
            --cache-dir /app/models \
            --local-dir-use-symlinks False; \
    else \
        echo "Using 0.6B models for 8GB variant"; \
    fi

# Copy the API wrapper script (will be downloaded at runtime from GitHub)
# This allows dynamic updates without rebuilding the image

EXPOSE 8000

CMD ["/bin/bash", "-c", "curl -s -L -o qwen3_tts_api.py https://raw.githubusercontent.com/besch/openfork_client/main/comfyui-storage/qwen3_tts_api.py && python qwen3_tts_api.py"]