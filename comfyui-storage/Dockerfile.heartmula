# syntax=docker/dockerfile:1.4
# HeartMuLa Docker Image - Legacy GPU Compatibility (Compute 3.5+)
# Uses PyTorch 2.0 + CUDA 11.8 for older GPU support (Kepler/Maxwell)

FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

# Metadata
LABEL maintainer="openfork@example.com"
LABEL description="HeartMuLa Music Generation API Server (Legacy GPU Support)"
LABEL version="1.0.0-legacy"
LABEL cuda_version="11.8"
LABEL pytorch_version="2.0.1"
LABEL min_compute_capability="3.5"

# Environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    CUDA_HOME=/usr/local/cuda \
    PATH=$CUDA_HOME/bin:$PATH \
    LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/pretrained \
    TRANSFORMERS_CACHE=/app/pretrained \
    HF_HUB_ENABLE_HF_TRANSFER=0 \
    PYTHONUNBUFFERED=1 \
    HEARTMULA_QUANTIZATION=none

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    build-essential \
    curl \
    git \
    wget \
    ffmpeg \
    libsndfile1 \
    ca-certificates \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3.10-dev \
    python3.10-venv \
    python3.10-distutils \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Install PyTorch with CUDA 11.8 support (supports older GPUs)
# Use --extra-index-url to allow PyPI for dependencies (sympy, etc.)
RUN echo "Installing PyTorch 2.0.1 with CUDA 11.8 (supports compute 3.5+)..." \
    && python -m pip install --no-cache-dir \
        torch==2.0.1 \
        torchaudio==2.0.2 \
        --extra-index-url https://download.pytorch.org/whl/cu118

# Install core dependencies
RUN echo "Installing core dependencies..." \
    && python -m pip install --no-cache-dir \
        fastapi \
        uvicorn[standard] \
        python-multipart \
        requests \
        scipy \
        numpy

# Install Rust (needed for building tokenizers from source)
RUN echo "Installing Rust compiler..." \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && export PATH="/root/.cargo/bin:$PATH" \
    && echo "✓ Rust installed: $(rustc --version)"

# Add Rust to PATH for subsequent RUN commands
ENV PATH="/root/.cargo/bin:$PATH"

# Install HuggingFace ecosystem (split for better error isolation)
RUN echo "Installing HuggingFace CLI..." \
    && python -m pip install --no-cache-dir huggingface_hub[cli] \
    && echo "✓ huggingface_hub installed"

RUN echo "Installing tokenizers (this may take 5-10 minutes to compile)..." \
    && python -m pip install --no-cache-dir tokenizers \
    && echo "✓ tokenizers installed"

RUN echo "Installing transformers and accelerate..." \
    && python -m pip install --no-cache-dir transformers accelerate \
    && echo "✓ transformers and accelerate installed"

# Install optional dependencies (CRITICAL: bitsandbytes required for 16GB VRAM!)
# bitsandbytes 0.42+ has better CUDA 11.8 support
RUN echo "Installing bitsandbytes for 4-bit quantization..." \
    && python -m pip install --no-cache-dir "bitsandbytes>=0.42.0" \
    && python -c "import bitsandbytes; print(f'✓ bitsandbytes {bitsandbytes.__version__} installed successfully')" \
    || (echo "⚠️  bitsandbytes installation failed - 16GB VRAM will OOM without it!" && exit 1)

# Install flash-attn (optional performance optimization)
RUN echo "Installing flash-attn (optional)..." \
    && python -m pip install --no-cache-dir flash-attn --no-build-isolation \
    || echo "⚠️  flash-attn installation failed (performance optimizations disabled)"

# Clone and install HeartLib
RUN echo "Cloning HeartLib repository..." \
    && git clone https://github.com/HeartMuLa/heartlib.git /app/heartlib_repo \
    && cd /app/heartlib_repo \
    && echo "Installing HeartLib..." \
    && python -m pip install --no-cache-dir -e . \
    && echo "✓ HeartLib installed successfully" \
    && cd /app

# Create necessary directories
RUN mkdir -p /app/input /app/output /app/ckpt /app/pretrained

# Download HeartMuLa models with retry logic
# HeartMuLaGen contains gen_config.json and tokenizer.json
RUN echo "=== Downloading HeartMuLa Models ===" \
    && echo "This may take 30-60 minutes depending on connection speed..." \
    && echo "" \
    && echo "[1/3] Downloading HeartMuLaGen (config files)..." \
    && for i in 1 2 3; do \
        huggingface-cli download HeartMuLa/HeartMuLaGen \
            --local-dir /app/ckpt \
            --resume-download \
            && echo "✓ HeartMuLaGen downloaded" && break || \
        { echo "Retry $i/3 failed, waiting 10s..."; sleep 10; }; \
    done \
    && echo "" \
    && echo "[2/3] Downloading HeartMuLa-oss-3B (3B model weights)..." \
    && for i in 1 2 3; do \
        huggingface-cli download HeartMuLa/HeartMuLa-oss-3B \
            --local-dir /app/ckpt/HeartMuLa-oss-3B \
            --resume-download \
            && echo "✓ HeartMuLa-oss-3B downloaded" && break || \
        { echo "Retry $i/3 failed, waiting 10s..."; sleep 10; }; \
    done \
    && echo "" \
    && echo "[3/3] Downloading HeartCodec-oss (codec model)..." \
    && for i in 1 2 3; do \
        huggingface-cli download HeartMuLa/HeartCodec-oss \
            --local-dir /app/ckpt/HeartCodec-oss \
            --resume-download \
            && echo "✓ HeartCodec-oss downloaded" && break || \
        { echo "Retry $i/3 failed, waiting 10s..."; sleep 10; }; \
    done \
    && echo "" \
    && echo "=== Download Complete ==="

# Verify checkpoint structure and show sizes
RUN echo "" \
    && echo "=== Verifying Model Files ===" \
    && echo "" \
    && echo "Root checkpoint directory:" \
    && ls -lh /app/ckpt/ | grep -v "^total" || true \
    && echo "" \
    && echo "HeartMuLa-oss-3B contents:" \
    && ls -lh /app/ckpt/HeartMuLa-oss-3B/ | head -n 10 || true \
    && echo "" \
    && echo "HeartCodec-oss contents:" \
    && ls -lh /app/ckpt/HeartCodec-oss/ | head -n 10 || true \
    && echo "" \
    && du -sh /app/ckpt/* 2>/dev/null || true \
    && echo "" \
    && echo "=== Verification Complete ==="

# Copy the API wrapper script and diagnostic tool
COPY heartmula_api.py /app/heartmula_api.py
COPY diagnose_heartmula.sh /app/diagnose_heartmula.sh
RUN chmod +x /app/diagnose_heartmula.sh

# Verify Python environment and GPU compatibility
RUN echo "" \
    && echo "=== Python Environment ===" \
    && python --version \
    && python -c "import torch; print(f'PyTorch: {torch.__version__}')" \
    && python -c "import torch; print(f'CUDA Available: {torch.cuda.is_available()}')" \
    && python -c "import torch; print(f'CUDA Version: {torch.version.cuda}')" \
    && python -c "import heartlib; print(f'HeartLib: OK')" \
    && echo "" \
    && echo "=== GPU Compatibility ===" \
    && echo "This image supports NVIDIA GPUs with compute capability 3.5+" \
    && echo "  - Kepler (GTX 700): compute 3.5-3.7 ✓" \
    && echo "  - Maxwell (GTX 900): compute 5.0-5.2 ✓" \
    && echo "  - Pascal (GTX 10xx): compute 6.0-6.2 ✓" \
    && echo "  - Newer architectures: ✓" \
    && echo "=== Environment OK ==="

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose API port
EXPOSE 8000

# Run the API server
CMD ["python", "heartmula_api.py"]
