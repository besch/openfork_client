FROM ollama/ollama:latest

# Install Python and other dependencies
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv curl bash \
    && rm -rf /var/lib/apt/lists/*

# Install DGN client dependencies (with --break-system-packages for PEP 668)
# Include tenacity for retry logic, docker for container management
RUN pip3 install --break-system-packages \
    requests python-dotenv websocket-client py-cpuinfo GPUtil psutil \
    httpx supabase websockets ffmpeg-python tenacity docker

# Pre-pull models during build for faster startup (mistral for JSON output)
RUN /bin/sh -c "ollama serve & pid=\$! && sleep 10 && ollama pull mistral:7b-instruct && kill \$pid"

# Bake DGN client into image at build time for efficiency
# This avoids downloading files on every container start
RUN mkdir -p /opt/dgn-client /data/.cache /data/input
WORKDIR /opt/dgn-client

# Download and install DGN client during build
RUN curl -sL https://raw.githubusercontent.com/besch/openfork_client/main/bootstrap.sh -o bootstrap.sh \
    && bash bootstrap.sh \
    && rm -f bootstrap.sh manifest.txt

# Create marker file to indicate client is pre-installed
RUN echo "$(date -Iseconds)" > /opt/dgn-client/.installed

# Copy startup script
COPY comfyui-storage/llm-start.sh /start.sh
RUN chmod +x /start.sh

# Override entrypoint to use our custom script
ENTRYPOINT ["/start.sh"]