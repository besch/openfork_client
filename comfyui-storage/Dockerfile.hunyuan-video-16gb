# Hunyuan Video 1.5 (16GB) Docker Image - OPTIMIZED

FROM nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

# Build arguments for HuggingFace authentication
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub \
        color-matcher matplotlib mss toml rich uv

WORKDIR /opt/ComfyUI

# Clone repos with --depth=1, remove .git
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && git clone --depth=1 https://github.com/kijai/ComfyUI-KJNodes.git custom_nodes/comfyui-kjnodes \
    && rm -rf custom_nodes/comfyui-kjnodes/.git \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Create model directories
RUN mkdir -p models/text_encoders models/diffusion_models models/vae models/clip_vision

# Download models using huggingface-cli (better retry, resume, parallel support)
# Text Encoders (~9GB + 0.4GB)
RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors models/text_encoders/ \
    && rm -rf split_files

RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/text_encoders/byt5_small_glyphxl_fp16.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/text_encoders/byt5_small_glyphxl_fp16.safetensors models/text_encoders/ \
    && rm -rf split_files

# VAE (~2.5GB)
RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/vae/hunyuanvideo15_vae_fp16.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/vae/hunyuanvideo15_vae_fp16.safetensors models/vae/ \
    && rm -rf split_files

# Diffusion Models - 720p I2V (~8GB)
RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/diffusion_models/hunyuanvideo1.5_720p_i2v_cfg_distilled_fp8_scaled.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/diffusion_models/hunyuanvideo1.5_720p_i2v_cfg_distilled_fp8_scaled.safetensors models/diffusion_models/ \
    && rm -rf split_files

# Diffusion Models - 480p I2V (~8GB)
RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/diffusion_models/hunyuanvideo1.5_480p_i2v_cfg_distilled_fp8_scaled.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/diffusion_models/hunyuanvideo1.5_480p_i2v_cfg_distilled_fp8_scaled.safetensors models/diffusion_models/ \
    && rm -rf split_files

# Diffusion Models - 480p T2V (~8GB) - NOTE: 720p T2V FP8 doesn't exist, using 480p
RUN huggingface-cli download Comfy-Org/HunyuanVideo_1.5_repackaged \
        split_files/diffusion_models/hunyuanvideo1.5_480p_t2v_cfg_distilled_fp8_scaled.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/diffusion_models/hunyuanvideo1.5_480p_t2v_cfg_distilled_fp8_scaled.safetensors models/diffusion_models/ \
    && rm -rf split_files

# CLIP Vision (~0.8GB)
RUN huggingface-cli download Comfy-Org/sigclip_vision_384 \
        sigclip_vision_patch14_384.safetensors \
        --local-dir models/clip_vision --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen", "--lowvram"]
