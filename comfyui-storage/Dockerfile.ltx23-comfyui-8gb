# OpenFork — LTX-2.3 22B Audio-Video on ComfyUI (8GB VRAM, GGUF)
#
# Uses GGUF Q4_K_M quantised dev model (~14GB) with separate VAE files
# and maximum CPU offloading at very low resolution (512x288, 65 frames).
# Minimum system RAM: 32GB (down from 64GB thanks to GGUF).
#
# Models loaded:
#   - Transformer: GGUF Q4_K_M (dev) + distilled LoRA v1.1
#   - Text encoder: Gemma 3 12B FP8
#   - Video VAE: separate safetensors
#   - Audio VAE: separate safetensors
#   - Spatial upscaler v1.1 x2
#   - Temporal upscaler x2
#   - HDR IC-LoRA
#
# Build:
#   docker build \
#     --build-arg HF_TOKEN=<token> \
#     -t beschiak/openfork-ltx23-comfyui-8gb:latest \
#     -f Dockerfile.ltx23-comfyui-8gb .

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

# ── System dependencies ───────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# ── PyTorch (CUDA 12.8) ───────────────────────────────────────────────────────
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu128 \
    && rm -rf /tmp/* /var/tmp/*

# ── Python dependencies ───────────────────────────────────────────────────────
RUN python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers \
        huggingface-hub color-matcher matplotlib mss toml \
        rich uv sentencepiece bitsandbytes xformers accelerate \
        gguf \
    && rm -rf /tmp/* /var/tmp/*

WORKDIR /opt/ComfyUI

ARG CACHEBUST=1

# ── ComfyUI core ──────────────────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && rm -rf /tmp/* /var/tmp/*

# ── ComfyUI-Manager ───────────────────────────────────────────────────────────
RUN git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && rm -rf /tmp/* /var/tmp/*

# ── ComfyUI-LTXVideo (master — required for LTX-2.3 audio + HDR nodes) ───────
RUN git clone --depth=1 https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-LTXVideo/requirements.txt || true) \
    && rm -rf /tmp/* /var/tmp/*

# ── VideoHelperSuite (VHS_VideoCombine with audio output) ────────────────────
RUN git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && rm -rf /tmp/* /var/tmp/*

# ── ComfyUI-GGUF (GGUF model loading) ────────────────────────────────────────
RUN git clone --depth=1 https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-GGUF/requirements.txt || true) \
    && rm -rf /tmp/* /var/tmp/*

# ── Model directories ─────────────────────────────────────────────────────────
RUN mkdir -p models/unet \
    models/checkpoints \
    models/text_encoders \
    models/vae \
    models/loras \
    models/latent_upscale_models \
    models/clip \
    models/input

# ── Download LTX-2.3 22B Dev GGUF Q4_K_M (~14GB, replaces 46GB BF16) ─────────
RUN echo "Downloading LTX-2.3 22B Dev GGUF Q4_K_M (~14GB)..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='unsloth/LTX-2.3-GGUF', filename='ltx-2.3-22b-dev-Q4_K_M.gguf', \
    local_dir='/tmp/ltx23', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/ltx23/ltx-2.3-22b-dev-Q4_K_M.gguf models/unet/ && \
    rm -rf /tmp/ltx23 && \
    python -c "import os; size=os.path.getsize('models/unet/ltx-2.3-22b-dev-Q4_K_M.gguf')/(1024**3); print(f'GGUF Q4_K_M: {size:.2f}GB'); assert size > 12" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download separate Video VAE ───────────────────────────────────────────────
RUN echo "Downloading LTX-2.3 video VAE..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='unsloth/LTX-2.3-GGUF', filename='vae/ltx-2.3-22b-dev_video_vae.safetensors', \
    local_dir='/tmp/vae', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/vae/vae/ltx-2.3-22b-dev_video_vae.safetensors models/vae/ && \
    rm -rf /tmp/vae && \
    python -c "import os; size=os.path.getsize('models/vae/ltx-2.3-22b-dev_video_vae.safetensors')/(1024**3); print(f'Video VAE: {size:.2f}GB'); assert size > 0.5" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download separate Audio VAE ───────────────────────────────────────────────
RUN echo "Downloading LTX-2.3 audio VAE..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='unsloth/LTX-2.3-GGUF', filename='vae/ltx-2.3-22b-dev_audio_vae.safetensors', \
    local_dir='/tmp/avae', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/avae/vae/ltx-2.3-22b-dev_audio_vae.safetensors models/vae/ && \
    rm -rf /tmp/avae && \
    python -c "import os; size=os.path.getsize('models/vae/ltx-2.3-22b-dev_audio_vae.safetensors')/(1024**3); print(f'Audio VAE: {size:.2f}GB'); assert size > 0.1" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download embeddings connectors (text encoder projections) ─────────────────
RUN echo "Downloading LTX-2.3 embeddings connectors..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='unsloth/LTX-2.3-GGUF', filename='text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors', \
    local_dir='/tmp/emb', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/emb/text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors models/text_encoders/ && \
    rm -rf /tmp/emb && \
    python -c "import os; size=os.path.getsize('models/text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors')/(1024**2); print(f'Embeddings connectors: {size:.1f}MB'); assert size > 10" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download distilled LoRA v1.1 (THE COLOR FIX, updated) ─────────────────────
RUN echo "Downloading distilled LoRA v1.1..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-distilled-lora-384-1.1.safetensors', \
    local_dir='/tmp/lora', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/lora/ltx-2.3-22b-distilled-lora-384-1.1.safetensors models/loras/ && \
    rm -rf /tmp/lora && \
    python -c "import os; size=os.path.getsize('models/loras/ltx-2.3-22b-distilled-lora-384-1.1.safetensors')/(1024**3); print(f'Distilled LoRA v1.1: {size:.2f}GB'); assert size > 0.1" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download Gemma-3 12B FP8 text encoder ────────────────────────────────────
RUN echo "Downloading Gemma-3 12B FP8 encoder..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn', filename='gemma_3_12B_it_fp8_e4m3fn.safetensors', \
    local_dir='/tmp/gemma', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/gemma/gemma_3_12B_it_fp8_e4m3fn.safetensors models/text_encoders/ && \
    rm -rf /tmp/gemma && \
    python -c "import os; size=os.path.getsize('models/text_encoders/gemma_3_12B_it_fp8_e4m3fn.safetensors')/(1024**3); print(f'Gemma FP8: {size:.2f}GB'); assert size > 5" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download LTX-2.3 Spatial Upscaler x2 v1.1 (updated) ──────────────────────
RUN echo "Downloading LTX-2.3 spatial upscaler v1.1..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-spatial-upscaler-x2-1.1.safetensors', \
    local_dir='/tmp/upscaler', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/upscaler/ltx-2.3-spatial-upscaler-x2-1.1.safetensors models/latent_upscale_models/ && \
    rm -rf /tmp/upscaler && \
    python -c "import os; size=os.path.getsize('models/latent_upscale_models/ltx-2.3-spatial-upscaler-x2-1.1.safetensors')/(1024**3); print(f'Spatial Upscaler v1.1: {size:.2f}GB'); assert size > 0.5" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download LTX-2.3 Temporal Upscaler x2 (NEW) ──────────────────────────────
RUN echo "Downloading LTX-2.3 temporal upscaler..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-temporal-upscaler-x2-1.0.safetensors', \
    local_dir='/tmp/temporal', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/temporal/ltx-2.3-temporal-upscaler-x2-1.0.safetensors models/latent_upscale_models/ && \
    rm -rf /tmp/temporal && \
    python -c "import os; size=os.path.getsize('models/latent_upscale_models/ltx-2.3-temporal-upscaler-x2-1.0.safetensors')/(1024**3); print(f'Temporal Upscaler: {size:.2f}GB'); assert size > 0.5" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download HDR IC-LoRA (NEW) ───────────────────────────────────────────────
RUN echo "Downloading LTX-2.3 HDR IC-LoRA..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3-22b-IC-LoRA-HDR', filename='ltx-2.3-22b-ic-lora-hdr-0.9.safetensors', \
    local_dir='/tmp/hdr', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/hdr/ltx-2.3-22b-ic-lora-hdr-0.9.safetensors models/loras/ && \
    rm -rf /tmp/hdr && \
    python -c "import os; size=os.path.getsize('models/loras/ltx-2.3-22b-ic-lora-hdr-0.9.safetensors')/(1024**3); print(f'HDR IC-LoRA: {size:.2f}GB'); assert size > 0.5" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# ── Download Gemma tokenizer / processor configs ──────────────────────────────
RUN mkdir -p models/text_encoders/gemma-3-12b-it && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    files = ['tokenizer.json','tokenizer_config.json','tokenizer.model', \
             'special_tokens_map.json','generation_config.json', \
             'preprocessor_config.json','processor_config.json']; \
    [hf_hub_download(repo_id='google/gemma-3-12b-it', filename=f, \
     local_dir='/tmp/gemma-cfg', token=os.getenv('HF_TOKEN')) \
     for f in files if True]" 2>/dev/null || \
    python -c "import os; from huggingface_hub import snapshot_download; \
    snapshot_download(repo_id='DeepBeepMeep/LTX-2', \
    allow_patterns='gemma-3-12b-it-qat-q4_0-unquantized/*.json', \
    local_dir='/tmp/gemma-cfg', token=os.getenv('HF_TOKEN'))" && \
    find /tmp/gemma-cfg -name '*.json' -exec cp {} models/text_encoders/gemma-3-12b-it/ \; && \
    rm -rf /tmp/gemma-cfg && \
    rm -rf /root/.cache/huggingface/* ~/.cache/*

# ── Verify all model files ────────────────────────────────────────────────────
RUN python3 - <<'EOF'
import os, sys
files = {
    "models/unet/ltx-2.3-22b-dev-Q4_K_M.gguf": 12.0,
    "models/vae/ltx-2.3-22b-dev_video_vae.safetensors": 0.5,
    "models/vae/ltx-2.3-22b-dev_audio_vae.safetensors": 0.1,
    "models/text_encoders/ltx-2.3-22b-dev_embeddings_connectors.safetensors": 0.01,
    "models/loras/ltx-2.3-22b-distilled-lora-384-1.1.safetensors": 0.1,
    "models/text_encoders/gemma_3_12B_it_fp8_e4m3fn.safetensors": 5.0,
    "models/latent_upscale_models/ltx-2.3-spatial-upscaler-x2-1.1.safetensors": 0.5,
    "models/latent_upscale_models/ltx-2.3-temporal-upscaler-x2-1.0.safetensors": 0.5,
    "models/loras/ltx-2.3-22b-ic-lora-hdr-0.9.safetensors": 0.5,
}
print("=" * 60)
print("VERIFYING LTX-2.3 COMFYUI 8GB MODEL FILES (GGUF)")
print("=" * 60)
ok = True
total_gb = 0
for path, min_gb in files.items():
    if not os.path.exists(path):
        print(f"MISSING: {path}"); ok = False; continue
    gb = os.path.getsize(path) / (1024**3)
    total_gb += gb
    if gb < min_gb:
        print(f"TOO SMALL: {path} ({gb:.2f}GB)"); ok = False
    else:
        print(f"OK: {path} ({gb:.2f}GB)")
if not ok:
    sys.exit(1)
print(f"\nTotal model size: {total_gb:.1f}GB (was ~47GB with BF16 checkpoint)")
print("All LTX-2.3 ComfyUI model files verified!")
EOF

# ── Final cleanup ─────────────────────────────────────────────────────────────
RUN find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/* ~/.cache/*

WORKDIR /opt/ComfyUI

# Maximum offload: --cpu-vae keeps VAE off GPU, --reserve-vram 0.5 for system
CMD ["python", "main.py", "--listen", "--lowvram", "--cpu-vae", "--reserve-vram", "0.5", "--use-pytorch-cross-attention"]
