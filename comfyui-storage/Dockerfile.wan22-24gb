# =============================================================================
# Dockerfile for WAN 2.2 24GB - UNIFIED (T2V + I2V)
# Uses Q8_0 GGUF quantization for near-lossless quality generation
# Contains all models for both Text-to-Video and Image-to-Video
# =============================================================================

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

# Build arguments for HuggingFace authentication
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub \
        color-matcher matplotlib mss toml rich gguf uv

WORKDIR /opt/ComfyUI

# Clone repos with --depth=1, remove .git
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && git clone --depth=1 https://github.com/kijai/ComfyUI-KJNodes.git custom_nodes/comfyui-kjnodes \
    && rm -rf custom_nodes/comfyui-kjnodes/.git \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && git clone --depth=1 https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Create model directories
RUN mkdir -p models/unet models/vae models/text_encoders models/loras

# Download models using huggingface-cli (better retry, resume, parallel support)
# Shared models: Text Encoder + VAE
RUN huggingface-cli download Comfy-Org/Wan_2.1_ComfyUI_repackaged \
        split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors models/text_encoders/ \
    && rm -rf split_files

RUN huggingface-cli download Comfy-Org/Wan_2.1_ComfyUI_repackaged \
        split_files/vae/wan_2.1_vae.safetensors \
        --local-dir . --local-dir-use-symlinks False \
        --token ${HF_TOKEN} \
    && mv split_files/vae/wan_2.1_vae.safetensors models/vae/ \
    && rm -rf split_files

# T2V Q8_0 High/Low Noise
RUN huggingface-cli download QuantStack/Wan2.2-T2V-A14B-GGUF \
        HighNoise/Wan2.2-T2V-A14B-HighNoise-Q8_0.gguf \
        --local-dir models/unet --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

RUN huggingface-cli download QuantStack/Wan2.2-T2V-A14B-GGUF \
        LowNoise/Wan2.2-T2V-A14B-LowNoise-Q8_0.gguf \
        --local-dir models/unet --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

# I2V Q8_0 High/Low Noise
RUN huggingface-cli download QuantStack/Wan2.2-I2V-A14B-GGUF \
        HighNoise/Wan2.2-I2V-A14B-HighNoise-Q8_0.gguf \
        --local-dir models/unet --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

RUN huggingface-cli download QuantStack/Wan2.2-I2V-A14B-GGUF \
        LowNoise/Wan2.2-I2V-A14B-LowNoise-Q8_0.gguf \
        --local-dir models/unet --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

# LoRAs
RUN huggingface-cli download Kijai/WanVideo_comfy \
        Lightx2v/lightx2v_T2V_14B_cfg_step_distill_v2_lora_rank32_bf16.safetensors \
        --local-dir models/loras --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

RUN huggingface-cli download Kijai/WanVideo_comfy \
        Lightx2v/lightx2v_I2V_14B_480p_cfg_step_distill_rank32_bf16.safetensors \
        --local-dir models/loras --local-dir-use-symlinks False \
        --token ${HF_TOKEN}

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]
