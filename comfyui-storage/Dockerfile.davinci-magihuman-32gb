# OpenFork — daVinci-MagiHuman 32GB (RTX 5090 / consumer GPU)
#
# What this image provides:
#   - sandai/magi-human base (CUDA 12 + PyTorch 2.10)
#   - MagiCompiler (fuses Transformer layers for ~1.2x speedup)
#   - daVinci-MagiHuman code but NOT model weights (download at runtime)
#   - FP8 quantized weights downloaded at runtime from SanDiegoDude/daVinci-MagiHuman-FP8
#     (reduces DiT from ~28.5 GB BF16 → ~14.3 GB FP8, enabling 32GB VRAM operation)
#   - FastAPI REST wrapper at port 8000
#   - VRAM_MODE=32gb: enables enable_sequential_cpu_offload() after pipeline load
#
# Build:
#   docker build \
#     -t beschiak/openfork-davinci-magihuman-32gb:latest \
#     -f Dockerfile.davinci-magihuman-32gb .
#
# Run on cloud (RunPod/Vast.ai — RTX 5090 or 3090 Ti with 32GB VRAM):
#   The cloud platform runs start_cloud.sh which handles:
#   - FP8 model download on first run (if not in volume)
#   - API startup with VRAM_MODE=32gb
#
# Notes:
#   - Requires 32GB VRAM minimum (RTX 5090 recommended; RTX 3090 Ti marginal)
#   - Requires 64GB+ system RAM for CPU offloading of inactive model layers
#   - FP8 weights from SanDiegoDude/daVinci-MagiHuman-FP8 (CC 8.9+ required)
#   - Resolution capped at 256p (same as 48GB tier) — generation is slower due to offloading
#   - ComfyUI is NOT used — REST API via davinci_magihuman_api.py

FROM sandai/magi-human:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV DAVINCI_ROOT=/opt/davinci-magihuman
ENV DAVINCI_MODELS=/models/davinci-magihuman
ENV DAVINCI_OUTPUT=/tmp/davinci_outputs
# 32GB low-VRAM mode: FP8 weights + sequential CPU offloading
ENV VRAM_MODE=32gb
ENV DAVINCI_FP8_DIR=/models/davinci-magihuman/fp8

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        git wget curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# ── MagiCompiler (graph fusion for ~1.2x speedup) ────────────────────────────
RUN git clone https://github.com/SandAI-org/MagiCompiler.git /opt/MagiCompiler \
    && pip install -r /opt/MagiCompiler/requirements.txt \
    && pip install /opt/MagiCompiler

# ── daVinci-MagiHuman source ──────────────────────────────────────────────────
RUN git clone https://github.com/GAIR-NLP/daVinci-MagiHuman /opt/davinci-magihuman \
    && git -C /opt/davinci-magihuman checkout main

# ── daVinci-MagiHuman Python dependencies ────────────────────────────────────
RUN pip install -r /opt/davinci-magihuman/requirements.txt || true
RUN pip install --no-deps -r /opt/davinci-magihuman/requirements-nodeps.txt || true

RUN pip install \
    transformers==4.56.0 \
    accelerate==1.10.1 \
    timm==1.0.20 \
    loguru==0.7.3

# ── FastAPI & uvicorn for REST wrapper ───────────────────────────────────────
RUN pip install fastapi uvicorn python-multipart

# ── Pre-create directories ────────────────────────────────────────────────────
RUN mkdir -p ${DAVINCI_MODELS} ${DAVINCI_OUTPUT} ${DAVINCI_FP8_DIR}

# ── Install HuggingFace CLI for runtime model downloads ────────────────────────
RUN pip install -q "huggingface_hub[cli]"

# ── Copy API wrapper ──────────────────────────────────────────────────────────
RUN mkdir -p /app
COPY davinci_magihuman_api.py /app/davinci_magihuman_api.py

WORKDIR /app
EXPOSE 8000

CMD ["bash"]
