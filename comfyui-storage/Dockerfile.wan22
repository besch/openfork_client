# WAN 2.2 (8GB) Docker Image - OPTIMIZED

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1

# System dependencies - combined
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub \
        color-matcher matplotlib mss toml rich gguf uv

WORKDIR /opt/ComfyUI

# Clone repos with --depth=1, remove .git
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && git clone --depth=1 https://github.com/kijai/ComfyUI-KJNodes.git custom_nodes/comfyui-kjnodes \
    && rm -rf custom_nodes/comfyui-kjnodes/.git \
    && git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && git clone --depth=1 https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git \
    && find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Copy user configurations
COPY --chown=user:user ./storage/ComfyUI/user /opt/ComfyUI/user

# Copy WAN 2.2 models from local storage
COPY --chown=user:user ./storage/ComfyUI/models/vae/wan_2.1_vae.safetensors /opt/ComfyUI/models/vae/
COPY --chown=user:user ./storage/ComfyUI/models/unet/wan2.2_i2v_low_noise_14B_Q4_K_S.gguf /opt/ComfyUI/models/unet/
COPY --chown=user:user ./storage/ComfyUI/models/unet/wan2.2_i2v_high_noise_14B_Q4_K_S.gguf /opt/ComfyUI/models/unet/
COPY --chown=user:user ./storage/ComfyUI/models/unet/wan2.2_t2v_high_noise_14B_Q4_K_S.gguf /opt/ComfyUI/models/unet/
COPY --chown=user:user ./storage/ComfyUI/models/unet/wan2.2_t2v_low_noise_14B_Q4_K_S.gguf /opt/ComfyUI/models/unet/
COPY --chown=user:user ./storage/ComfyUI/models/loras/Wan21_lightx2v_I2V_14B_480p_cfg_step_distill_rank32_bf16.safetensors /opt/ComfyUI/models/loras/
COPY --chown=user:user ./storage/ComfyUI/models/loras/Wan21_T2V_14B_lightx2v_cfg_step_distill_lora_rank32.safetensors /opt/ComfyUI/models/loras/
COPY --chown=user:user ./storage/ComfyUI/models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors /opt/ComfyUI/models/text_encoders/

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]
