# OpenFork - SCAIL-2 14B on WanGP (24GB experimental)
#
# Provides:
#   - WanGP/Wan2GP at /opt/wan2gp
#   - SCAIL-2 14B quanto int8 transformer
#   - Wan2.1 VAE, UMT5 text encoder, XLM-R CLIP vision encoder
#   - NLF pose files and SAM3 Magic Mask files used by WanGP's SCAIL-2 flow
#
# Build:
#   docker build \
#     --build-arg HF_TOKEN=<token> \
#     -t beschiak/openfork-scail2-wan2gp-24gb:latest \
#     -f Dockerfile.scail2-wan2gp-24gb .

ARG HF_TOKEN

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ARG HF_TOKEN

ENV DEBIAN_FRONTEND=noninteractive
ENV WAN2GP_ROOT=/opt/wan2gp
ENV WAN2GP_OUTPUT=/opt/wan2gp/outputs
ENV CUDA_MODULE_LOADING=LAZY
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,max_split_size_mb:128,garbage_collection_threshold:0.8
ENV MALLOC_ARENA_MAX=2
ENV WAN2GP_CLI_ARGS="--profile 4.5 --attention sdpa --perc-reserved-mem-max 0.45 --vram-safety-coefficient 0.70"

RUN rm -f /etc/apt/sources.list.d/cuda*.list /etc/apt/sources.list.d/nvidia*.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git wget curl cmake ninja-build \
        build-essential g++ \
        libgl1 libglib2.0-0 ffmpeg xz-utils ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fSL https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-n7.1-latest-linux64-gpl-7.1.tar.xz \
    | tar -xJ --strip-components=2 -C /usr/local/bin/ \
      ffmpeg-n7.1-latest-linux64-gpl-7.1/bin/ffmpeg \
      ffmpeg-n7.1-latest-linux64-gpl-7.1/bin/ffprobe

RUN ln -sf /usr/bin/python3 /usr/bin/python
RUN pip3 install --upgrade pip setuptools wheel

RUN pip3 install \
        torch==2.7.0+cu128 \
        torchvision==0.22.0+cu128 \
        torchaudio==2.7.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128

RUN git clone https://github.com/deepbeepmeep/Wan2GP /opt/wan2gp \
    && git -C /opt/wan2gp checkout main

RUN pip3 install \
        --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ort-cuda-13-nightly/pypi/simple/ \
        -r /opt/wan2gp/requirements.txt \
    || pip3 install -r /opt/wan2gp/requirements.txt

RUN pip3 install \
        torch==2.7.0+cu128 \
        torchvision==0.22.0+cu128 \
        torchaudio==2.7.0+cu128 \
        --index-url https://download.pytorch.org/whl/cu128

RUN mkdir -p /opt/wan2gp/ckpts /opt/wan2gp/outputs /opt/wan2gp/input

RUN pip3 install -q "huggingface_hub[cli]"

RUN if [ -n "${HF_TOKEN}" ]; then HF_TOKEN_ARG="--token ${HF_TOKEN}"; else HF_TOKEN_ARG=""; fi; \
    huggingface-cli download DeepBeepMeep/Wan2.1 \
        scail2_14B_quanto_mbf16_int8.safetensors \
        Wan2.1_VAE.safetensors \
        Wan2.1_VAE_upscale2x_imageonly_real_v1.safetensors \
        umt5-xxl/special_tokens_map.json \
        umt5-xxl/spiece.model \
        umt5-xxl/tokenizer.json \
        umt5-xxl/tokenizer_config.json \
        umt5-xxl/models_t5_umt5-xxl-enc-bf16.safetensors \
        umt5-xxl/models_t5_umt5-xxl-enc-quanto_int8.safetensors \
        xlm-roberta-large/models_clip_open-clip-xlm-roberta-large-vit-huge-14-bf16.safetensors \
        xlm-roberta-large/sentencepiece.bpe.model \
        xlm-roberta-large/special_tokens_map.json \
        xlm-roberta-large/tokenizer.json \
        xlm-roberta-large/tokenizer_config.json \
        pose/nlf_l_multi_0.3.2.eager.safetensors \
        pose/nlf_l_multi_0.3.2.eager.meta.json \
        sam3/sam3.1_multiplex_bf16.safetensors \
        sam3/bpe_simple_vocab_16e6.txt.gz \
        --local-dir /opt/wan2gp/ckpts \
        ${HF_TOKEN_ARG} \
    || { echo "ERROR: SCAIL-2/Wan2.1 support file download failed."; exit 1; }

RUN pip3 install fastapi "uvicorn[standard]"

COPY wan2gp_server.py /opt/wan2gp/wan2gp_server.py

RUN python3 -c "import os; root='/opt/wan2gp/ckpts'; any_transformer=any(os.path.isfile(os.path.join(root, p)) for p in ['scail2_14B_mbf16.safetensors','scail2_14B_quanto_mbf16_int8.safetensors','scail2_14B_quanto_mfp16_int8.safetensors']); required=['Wan2.1_VAE.safetensors','umt5-xxl/models_t5_umt5-xxl-enc-bf16.safetensors','xlm-roberta-large/models_clip_open-clip-xlm-roberta-large-vit-huge-14-bf16.safetensors','pose/nlf_l_multi_0.3.2.eager.safetensors','pose/nlf_l_multi_0.3.2.eager.meta.json','sam3/sam3.1_multiplex_bf16.safetensors','sam3/bpe_simple_vocab_16e6.txt.gz']; missing=[p for p in required if not os.path.isfile(os.path.join(root, p))]; assert any_transformer, 'missing SCAIL-2 transformer'; assert not missing, missing; print('SCAIL-2 WanGP 24GB files: OK')"

WORKDIR /opt/wan2gp

CMD ["python3", "/opt/wan2gp/wan2gp_server.py"]
