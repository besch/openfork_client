{
  "prompt": {
    "1": {
      "inputs": {
        "unet_name": "ltx-2-19b-dev-fp8_transformer_only.safetensors",
        "weight_dtype": "default"
      },
      "class_type": "UNETLoader",
      "_meta": {
        "title": "Load LTX-2 FP8 UNET (Split Loading for Speed)"
      }
    },
    "2": {
      "inputs": {
        "clip_name1": "gemma_3_12B_it_fp8_e4m3fn.safetensors",
        "clip_name2": "ltx-2-19b-dev-fp4_projections_only.safetensors",
        "type": "ltxv2"
      },
      "class_type": "DualCLIPLoader",
      "_meta": {
        "title": "Load Gemma-3 12B Text Encoder (FP8 Optimized)"
      }
    },
    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Positive Prompt"
      }
    },
    "4": {
      "inputs": {
        "text": "worst quality, inconsistent motion, blurry, jittery, distorted, missing audio, silent, muffled audio, distorted audio",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": {
        "title": "Negative Prompt"
      }
    },
    "15": {
      "inputs": {
        "image": "start_image.png"
      },
      "class_type": "LoadImage",
      "_meta": {
        "title": "Load Start Image"
      }
    },
    "16": {
      "inputs": {
        "vae_name": "LTX2_video_vae_bf16.safetensors"
      },
      "class_type": "VAELoader",
      "_meta": {
        "title": "Load Video VAE"
      }
    },
    "audio_vae": {
      "inputs": {
        "vae_name": "LTX2_audio_vae_bf16.safetensors"
      },
      "class_type": "LTXVAudioVAELoader",
      "_meta": {
        "title": "Load Audio VAE (LTX-2 core node)"
      }
    },
    "17": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "vae": ["16", 0],
        "image": ["15", 0],
        "width": 1280,
        "height": 720,
        "length": 97,
        "batch_size": 1,
        "strength": 0.95,
        "img_compression": 42,
        "image_noise_scale": 0.15
      },
      "class_type": "LTXVImgToVideo",
      "_meta": {
        "title": "24GB: Image-to-Video (1280x720, 97 frames)"
      }
    },
    "empty_audio_latent": {
      "inputs": {
        "length": 97,
        "batch_size": 1,
        "frame_rate": 24
      },
      "class_type": "LTXVEmptyLatentAudio",
      "_meta": {
        "title": "Empty Audio Latent"
      }
    },
    "concat_av": {
      "inputs": {
        "video_latent": ["17", 2],
        "audio_latent": ["empty_audio_latent", 0]
      },
      "class_type": "LTXVConcatAVLatent",
      "_meta": {
        "title": "Concatenate Audio+Video Latents"
      }
    },
    "5": {
      "inputs": {
        "positive": ["17", 0],
        "negative": ["17", 1],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning",
      "_meta": {
        "title": "LTX-V Conditioning"
      }
    },
    "7": {
      "inputs": {
        "model": ["1", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "cfg": 3.0
      },
      "class_type": "CFGGuider"
    },
    "8": {
      "inputs": {
        "sampler_name": "euler"
      },
      "class_type": "KSamplerSelect"
    },
    "9": {
      "inputs": {
        "model": ["1", 0],
        "scheduler": "simple",
        "steps": 25,
        "denoise": 1.0
      },
      "class_type": "BasicScheduler",
      "_meta": {
        "title": "Scheduler (25 steps for 24GB)"
      }
    },
    "10": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise"
    },
    "11": {
      "inputs": {
        "noise": ["10", 0],
        "guider": ["7", 0],
        "sampler": ["8", 0],
        "sigmas": ["9", 0],
        "latent_image": ["concat_av", 0]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": {
        "title": "Sampler (Audio+Video)"
      }
    },
    "separate_av": {
      "inputs": {
        "samples": ["11", 0]
      },
      "class_type": "LTXVSeparateAVLatent",
      "_meta": {
        "title": "Separate Audio/Video Latents"
      }
    },
    "12": {
      "inputs": {
        "samples": ["separate_av", 0],
        "vae": ["16", 0],
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 64,
        "temporal_overlap": 8
      },
      "class_type": "VAEDecodeTiled",
      "_meta": {
        "title": "Decode Video Latent (Tiled, 24GB Safe)"
      }
    },
    "decode_audio": {
      "inputs": {
        "samples": ["separate_av", 1],
        "audio_vae": ["audio_vae", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVAudioVAEDecode",
      "_meta": {
        "title": "Decode Audio Latent"
      }
    },
    "14": {
      "inputs": {
        "images": ["12", 0],
        "audio": ["decode_audio", 0],
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "ltx2_i2v_24gb_audio",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv420p",
        "crf": 19,
        "save_metadata": true,
        "trim_to_audio": false,
        "pingpong": false,
        "save_output": true
      },
      "class_type": "VHS_VideoCombine",
      "_meta": {
        "title": "Save Video+Audio (VHS)"
      }
    }
  }
}