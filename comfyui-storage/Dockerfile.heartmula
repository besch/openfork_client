# syntax=docker/dockerfile:1.4
# HeartMuLa Docker Image

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV HF_HOME=/app/pretrained
ENV TRANSFORMERS_CACHE=/app/pretrained

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3.10-distutils \
    curl git wget ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Install PyTorch
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.4.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu124 \
    && python -m pip install --no-cache-dir \
        fastapi uvicorn[standard] python-multipart requests huggingface_hub[cli] transformers scipy bitsandbytes

# Clone and install HeartLib
RUN git clone https://github.com/HeartMuLa/heartlib.git /app/heartlib_repo \
    && cd /app/heartlib_repo \
    && python -m pip install --no-cache-dir -e .

# Create directories
RUN mkdir -p /app/input /app/output /app/ckpt

# Download HeartMuLa models
# Using huggingface-cli download for better reliability
RUN pip install -U "huggingface_hub[cli]" \
    && huggingface-cli download HeartMuLa/HeartMuLaGen --local-dir /app/ckpt \
    && huggingface-cli download HeartMuLa/HeartMuLa-oss-3B --local-dir /app/ckpt/HeartMuLa-oss-3B \
    && huggingface-cli download HeartMuLa/HeartCodec-oss --local-dir /app/ckpt/HeartCodec-oss

# Copy the API wrapper script
COPY heartmula_api.py /app/heartmula_api.py

EXPOSE 8000
CMD ["python", "heartmula_api.py"]