{
  "_README": {
    "tier": "32GB VRAM — Multi-Frame Image-to-Video",
    "model": "ltx-2.3-22b-dev.safetensors + ltx-2.3-22b-distilled-lora-384.safetensors",
    "encoder": "gemma_3_12B_it_fp4_mixed.safetensors (cpu)",
    "resolution": "1024x576 (16:9 default)",
    "frames": "153 frames = ~6.4s @ 24fps",
    "multi_frame_approach": [
      "Node 21-23: Start frame — LTXVImgToVideoConditionOnly applies start image to first frame of video latent",
      "Node 26-28: End frame — LTXVImgToVideoConditionOnly applied to REVERSED video latent (pins end image to last frame), then reversed back",
      "LatentFlip nodes (29, 30) reverse the temporal dimension so the same start-frame node effectively conditions the last frame",
      "Final conditioned latent has start image anchored at frame 0, end image anchored at last frame",
      "Model interpolates smoothly between start and end"
    ],
    "scheduler": "dev model: 15 steps, max_shift=2.05, base_shift=0.95, stretch=true",
    "audio": "native audio+video generation in one pass",
    "output": "VHS_VideoCombine with yuv444p",
    "fixes": [
      "NODE 29 & 30 (LatentFlip): flip_method 'x' -> 't' — 'x' flips spatially (horizontal mirror), 't' reverses temporal frame order which is required for the end-frame pinning trick to work"
    ]
  },
  "prompt": {
    "1": {
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": { "title": "LTX-2.3 22B Dev Checkpoint" }
    },
    "25": {
      "inputs": {
        "model": ["1", 0],
        "lora_name": "ltx-2.3-22b-distilled-lora-384.safetensors",
        "strength_model": 0.2
      },
      "class_type": "LoraLoaderModelOnly",
      "_meta": { "title": "Apply Distilled LoRA (speed boost, strength=0.2)" }
    },
    "2": {
      "inputs": {
        "text_encoder": "gemma_3_12B_it_fp4_mixed.safetensors",
        "ckpt_name": "ltx-2.3-22b-dev.safetensors",
        "device": "cpu"
      },
      "class_type": "LTXAVTextEncoderLoader",
      "_meta": { "title": "Load Gemma-3 12B FP4 Text Encoder (cpu)" }
    },
    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Positive Prompt" }
    },
    "4": {
      "inputs": {
        "text": "worst quality, inconsistent motion, blurry, jittery, distorted, watermarks, low contrast, washed out colors, desaturated, overexposed, color banding, artifacts, noise",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },
    "5": {
      "inputs": {
        "positive": ["3", 0],
        "negative": ["4", 0],
        "frame_rate": 24
      },
      "class_type": "LTXVConditioning",
      "_meta": { "title": "LTX-V Conditioning" }
    },
    "6": {
      "inputs": {
        "width": 1024,
        "height": 576,
        "length": 153,
        "batch_size": 1
      },
      "class_type": "EmptyLTXVLatentVideo",
      "_meta": { "title": "Empty Video Latent (1024x576, 153 frames)" }
    },
    "7": {
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev.safetensors"
      },
      "class_type": "LTXVAudioVAELoader",
      "_meta": { "title": "Load Audio VAE" }
    },
    "8": {
      "inputs": {
        "audio_vae": ["7", 0],
        "frames_number": 153,
        "frame_rate": 24,
        "batch_size": 1
      },
      "class_type": "LTXVEmptyLatentAudio",
      "_meta": { "title": "Empty Audio Latent (153 frames @ 24fps)" }
    },
    "21": {
      "inputs": {
        "image": "start_image.png",
        "upload": "image"
      },
      "class_type": "LoadImage",
      "_meta": { "title": "Load Start Image (frame 0)" }
    },
    "22": {
      "inputs": {
        "image": ["21", 0],
        "img_compression": 18
      },
      "class_type": "LTXVPreprocess",
      "_meta": { "title": "Preprocess Start Image" }
    },
    "23": {
      "inputs": {
        "vae": ["1", 2],
        "image": ["22", 0],
        "latent": ["6", 0],
        "strength": 0.75,
        "bypass_i2v": false
      },
      "class_type": "LTXVImgToVideoConditionOnly",
      "_meta": {
        "title": "Condition Start Frame (anchors first frame to start image)"
      }
    },
    "26": {
      "inputs": {
        "image": "end_image.png",
        "upload": "image"
      },
      "class_type": "LoadImage",
      "_meta": { "title": "Load End Image (last frame)" }
    },
    "27": {
      "inputs": {
        "image": ["26", 0],
        "img_compression": 18
      },
      "class_type": "LTXVPreprocess",
      "_meta": { "title": "Preprocess End Image" }
    },
    "29": {
      "inputs": {
        "samples": ["23", 0],
        "flip_method": "t"
      },
      "class_type": "LatentFlip",
      "_meta": {
        "title": "Flip Latent Temporally (flip_method='t' reverses frame order — FIXED from 'x' which was a spatial/horizontal mirror)"
      }
    },
    "28": {
      "inputs": {
        "vae": ["1", 2],
        "image": ["27", 0],
        "latent": ["29", 0],
        "strength": 0.75,
        "bypass_i2v": false
      },
      "class_type": "LTXVImgToVideoConditionOnly",
      "_meta": {
        "title": "Condition End Frame (on reversed latent, so this pins the LAST frame)"
      }
    },
    "30": {
      "inputs": {
        "samples": ["28", 0],
        "flip_method": "t"
      },
      "class_type": "LatentFlip",
      "_meta": {
        "title": "Flip Latent Back to Normal Temporal Order (flip_method='t' — FIXED from 'x')"
      }
    },
    "9": {
      "inputs": {
        "video_latent": ["30", 0],
        "audio_latent": ["8", 0]
      },
      "class_type": "LTXVConcatAVLatent",
      "_meta": {
        "title": "Concat Audio+Video Latents (start+end conditioned video + empty audio)"
      }
    },
    "10": {
      "inputs": {
        "modality": "AUDIO",
        "cfg": 3.0,
        "stg": 0.5,
        "perturb_attn": true,
        "rescale": 0.7,
        "modality_scale": 1.0,
        "skip_step": 1,
        "cross_attn": true
      },
      "class_type": "GuiderParameters",
      "_meta": { "title": "Audio Guider Parameters" }
    },
    "11": {
      "inputs": {
        "parameters": ["10", 0],
        "modality": "VIDEO",
        "cfg": 4.5,
        "stg": 0.5,
        "perturb_attn": true,
        "rescale": 0.9,
        "modality_scale": 1.0,
        "skip_step": 0,
        "cross_attn": true
      },
      "class_type": "GuiderParameters",
      "_meta": { "title": "Video Guider Parameters" }
    },
    "12": {
      "inputs": {
        "model": ["25", 0],
        "positive": ["5", 0],
        "negative": ["5", 1],
        "parameters": ["11", 0],
        "skip_blocks": "19"
      },
      "class_type": "MultimodalGuider",
      "_meta": { "title": "Multimodal Guider (Audio+Video)" }
    },
    "13": {
      "inputs": {
        "latent": ["9", 0],
        "steps": 15,
        "max_shift": 2.05,
        "base_shift": 0.95,
        "stretch": true,
        "terminal": 0.1
      },
      "class_type": "LTXVScheduler",
      "_meta": { "title": "LTX-V Scheduler — dev model: 15 steps" }
    },
    "14": {
      "inputs": {
        "sampler_name": "euler_ancestral_cfg_pp"
      },
      "class_type": "KSamplerSelect",
      "_meta": { "title": "Sampler Select" }
    },
    "15": {
      "inputs": {
        "noise_seed": 0
      },
      "class_type": "RandomNoise",
      "_meta": { "title": "Random Noise (Seed)" }
    },
    "16": {
      "inputs": {
        "noise": ["15", 0],
        "guider": ["12", 0],
        "sampler": ["14", 0],
        "sigmas": ["13", 0],
        "latent_image": ["9", 0]
      },
      "class_type": "SamplerCustomAdvanced",
      "_meta": { "title": "Sampler (Audio+Video)" }
    },
    "17": {
      "inputs": {
        "av_latent": ["16", 0]
      },
      "class_type": "LTXVSeparateAVLatent",
      "_meta": { "title": "Separate Audio+Video Latents" }
    },
    "18": {
      "inputs": {
        "samples": ["17", 0],
        "vae": ["1", 2],
        "tile_size": 512,
        "overlap": 64,
        "temporal_size": 512,
        "temporal_overlap": 64
      },
      "class_type": "VAEDecodeTiled",
      "_meta": { "title": "Decode Video (Tiled VAE)" }
    },
    "19": {
      "inputs": {
        "samples": ["17", 1],
        "audio_vae": ["7", 0]
      },
      "class_type": "LTXVAudioVAEDecode",
      "_meta": { "title": "Decode Audio" }
    },
    "20": {
      "inputs": {
        "images": ["18", 0],
        "audio": ["19", 0],
        "frame_rate": 24,
        "loop_count": 0,
        "filename_prefix": "ltx23_mf_i2v_32gb",
        "format": "video/h264-mp4",
        "pix_fmt": "yuv444p",
        "crf": 18,
        "save_metadata": true,
        "trim_to_audio": true,
        "pingpong": false,
        "save_output": true
      },
      "class_type": "VHS_VideoCombine",
      "_meta": { "title": "Save Video + Audio (Multi-Frame I2V)" }
    }
  }
}
