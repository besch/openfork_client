# syntax=docker/dockerfile:1.4
# Qwen3-TTS Docker Image - 8GB VRAM Optimized
# Supports: CustomVoice TTS, Voice Design, Voice Cloning

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV HF_HOME=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV TORCH_HOME=/app/models

# System dependencies - Python 3.12 (distutils removed in 3.12, not needed with modern pip)
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev \
    curl git wget ffmpeg libsndfile1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && ln -sf /usr/bin/python3.12 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Install PyTorch with CUDA 12.4 support
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.4.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu124

# Install qwen-tts package and dependencies
RUN python -m pip install --no-cache-dir \
    qwen-tts \
    fastapi \
    uvicorn[standard] \
    python-multipart \
    requests \
    soundfile \
    numpy

# Install FlashAttention 2 for memory efficiency (optional, may fail on some systems)
RUN MAX_JOBS=4 python -m pip install --no-cache-dir flash-attn --no-build-isolation || \
    echo "FlashAttention 2 installation failed, continuing without it"

# Create directories
RUN mkdir -p /app/input /app/output /app/models

# Build argument for model size (0.6B or 1.7B)
ARG MODEL_SIZE=0.6B
ENV QWEN_MODEL_SIZE=${MODEL_SIZE}

# Pre-download models to bake them into the image
# This ensures zero-download startup time
RUN python -c "from huggingface_hub import snapshot_download; \
    import os; \
    size = os.environ.get('QWEN_MODEL_SIZE', '0.6B'); \
    print(f'Pre-downloading Qwen3-TTS {size} models...'); \
    # Download Base model (used for Voice Cloning) \
    snapshot_download(f'Qwen/Qwen3-TTS-12Hz-{size}-Base'); \
    # Download CustomVoice model (used for TTS) \
    snapshot_download(f'Qwen/Qwen3-TTS-12Hz-{size}-CustomVoice'); \
    # Download VoiceDesign model (only for 1.7B usually, but good to have if size is 1.7B) \
    if size == '1.7B': \
        snapshot_download('Qwen/Qwen3-TTS-12Hz-1.7B-VoiceDesign'); \
    print('Model download complete.')"

# Copy the API wrapper script
COPY qwen3_tts_api.py /app/qwen3_tts_api.py

EXPOSE 8000
CMD ["python", "qwen3_tts_api.py"]

