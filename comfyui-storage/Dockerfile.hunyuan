FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev curl git \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Install PyTorch with CUDA 12.8 wheels explicitly
RUN python -m pip install torch==2.7.1+cu128 torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cu128

# Install other dependencies
RUN python -m pip install gitpython PyYAML opencv-python imageio-ffmpeg ninja
ENV TORCH_CUDA_ARCH_LIST="8.9"
RUN python -m pip install --no-build-isolation sageattention

# Set working directory
WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI
RUN python -m pip install -r requirements.txt

# Clone ComfyUI Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git /opt/ComfyUI/custom_nodes/ComfyUI-Manager
RUN python -m pip install GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub>0.20

# --- Hunyuan Video Custom Nodes ---

# ComfyUI-GGUF (Required for 8GB VRAM usage of Hunyuan)
RUN git clone https://github.com/city96/ComfyUI-GGUF.git /opt/ComfyUI/custom_nodes/ComfyUI-GGUF
RUN cd /opt/ComfyUI/custom_nodes/ComfyUI-GGUF && python -m pip install -r requirements.txt

# ComfyUI-HunyuanVideoWrapper (Main wrapper for Hunyuan 1.5)
RUN git clone https://github.com/kijai/ComfyUI-HunyuanVideoWrapper.git /opt/ComfyUI/custom_nodes/ComfyUI-HunyuanVideoWrapper
RUN cd /opt/ComfyUI/custom_nodes/ComfyUI-HunyuanVideoWrapper && python -m pip install -r requirements.txt

# KJNodes (Dependency / Useful helpers)
RUN git clone https://github.com/kijai/ComfyUI-KJNodes.git /opt/ComfyUI/custom_nodes/comfyui-kjnodes
RUN cd /opt/ComfyUI/custom_nodes/comfyui-kjnodes && python -m pip install -r requirements.txt

# VideoHelperSuite (VHS) - For saving video
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git /opt/ComfyUI/custom_nodes/VideoHelperSuite
RUN cd /opt/ComfyUI/custom_nodes/VideoHelperSuite && python -m pip install -r requirements.txt

# Install additional system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN python -m pip install uv

# Copy user configurations
COPY --chown=user:user ./storage/ComfyUI/user /opt/ComfyUI/user

# Setup model directories if you want to bake them in, otherwise we rely on volume mounts
# We assume the user maps the 'storage/ComfyUI/models' directory to '/opt/ComfyUI/models'

WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]
