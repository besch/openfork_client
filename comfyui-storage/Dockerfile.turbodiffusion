# syntax=docker/dockerfile:1.7
# TurboDiffusion Docker Image - OPTIMIZED
# NOTE: Keeping devel for flash-attn and turbo_diffusion_ops CUDA compilation

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=/usr/local/lib/python3.11/dist-packages/torch/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONPATH=/opt/TurboDiffusion:/opt/TurboDiffusion/turbodiffusion

# System dependencies - combined
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git ffmpeg libgl1-mesa-glx libgl1-mesa-dri \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Python packages - combined
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.8.0+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        psutil ninja packaging wheel setuptools \
        "triton>=3.3.0" einops numpy pillow loguru "imageio[ffmpeg]" \
        pandas pyyaml omegaconf attrs fvcore ftfy regex transformers nvidia-ml-py \
        accelerate diffusers sentencepiece opencv-python av iopath prompt-toolkit rich \
        scipy scikit-image lmdb tensorboard lpips matplotlib tqdm requests \
        "huggingface-hub>=0.26.0" \
        fastapi uvicorn python-multipart aiofiles

# Install flash-attn (skip on failure)
RUN MAX_JOBS=2 python -m pip install --no-cache-dir flash-attn --no-build-isolation || echo "flash-attn skipped"

# Clone TurboDiffusion
WORKDIR /opt
RUN git clone --depth=1 https://github.com/thu-ml/TurboDiffusion.git \
    && cd TurboDiffusion \
    && git submodule update --init --recursive \
    && rm -rf .git

WORKDIR /opt/TurboDiffusion

# Build and verify the turbo_diffusion_ops CUDA extension. Generation fails
# immediately without this module, so the image must not publish if it cannot
# compile.
RUN MAX_JOBS=2 python -m pip install --no-cache-dir -e . --no-build-isolation \
    && python - <<'PY'
import turbo_diffusion_ops  # noqa: F401
PY

# Install SpargeAttn (skip on failure)
RUN python -m pip install --no-cache-dir git+https://github.com/thu-ml/SpargeAttn.git --no-build-isolation || echo "SpargeAttn skipped"

# Create runtime directories before downloading checkpoints.
RUN mkdir -p checkpoints outputs inputs

WORKDIR /opt/TurboDiffusion/checkpoints

# Download checkpoints as separate cached layers. The cache mount lets an
# interrupted BuildKit download resume on the next build attempt.
RUN --mount=type=cache,target=/root/.cache/turbodiffusion-checkpoints \
    --mount=type=secret,id=hf_token,required=false \
    if [ -s /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    cp "$(hf download Wan-AI/Wan2.1-T2V-1.3B Wan2.1_VAE.pth \
        --cache-dir /root/.cache/turbodiffusion-checkpoints \
        --quiet)" Wan2.1_VAE.pth

RUN --mount=type=cache,target=/root/.cache/turbodiffusion-checkpoints \
    --mount=type=secret,id=hf_token,required=false \
    if [ -s /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    cp "$(hf download Wan-AI/Wan2.1-T2V-1.3B models_t5_umt5-xxl-enc-bf16.pth \
        --cache-dir /root/.cache/turbodiffusion-checkpoints \
        --quiet)" models_t5_umt5-xxl-enc-bf16.pth

RUN --mount=type=cache,target=/root/.cache/turbodiffusion-checkpoints \
    --mount=type=secret,id=hf_token,required=false \
    if [ -s /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    cp "$(hf download TurboDiffusion/TurboWan2.1-T2V-1.3B-480P TurboWan2.1-T2V-1.3B-480P-quant.pth \
        --cache-dir /root/.cache/turbodiffusion-checkpoints \
        --quiet)" TurboWan2.1-T2V-1.3B-480P-quant.pth

RUN --mount=type=cache,target=/root/.cache/turbodiffusion-checkpoints \
    --mount=type=secret,id=hf_token,required=false \
    if [ -s /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    cp "$(hf download TurboDiffusion/TurboWan2.2-I2V-A14B-720P TurboWan2.2-I2V-A14B-high-720P-quant.pth \
        --cache-dir /root/.cache/turbodiffusion-checkpoints \
        --quiet)" TurboWan2.2-I2V-A14B-high-720P-quant.pth

RUN --mount=type=cache,target=/root/.cache/turbodiffusion-checkpoints \
    --mount=type=secret,id=hf_token,required=false \
    if [ -s /run/secrets/hf_token ]; then export HF_TOKEN="$(cat /run/secrets/hf_token)"; fi; \
    cp "$(hf download TurboDiffusion/TurboWan2.2-I2V-A14B-720P TurboWan2.2-I2V-A14B-low-720P-quant.pth \
        --cache-dir /root/.cache/turbodiffusion-checkpoints \
        --quiet)" TurboWan2.2-I2V-A14B-low-720P-quant.pth

# Copy the API server script
COPY turbodiffusion_api_server.py /opt/TurboDiffusion/api_server.py

WORKDIR /opt/TurboDiffusion
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "api_server:app", "--host", "0.0.0.0", "--port", "8000"]
