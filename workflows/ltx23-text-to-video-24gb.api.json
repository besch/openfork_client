{
  "prompt": {
    "1": {
      "inputs": {
        "ckpt_name": "ltx-2.3-22b-dev.safetensors"
      },
      "class_type": "CheckpointLoaderSimple",
      "_meta": { "title": "Load LTX-2.3 Checkpoint" }
    },

    "2": {
      "inputs": {
        "text_encoder_path": "gemma-3-12b-it-qat-q4_0-unquantized",
        "load_device": "cpu"
      },
      "class_type": "LTXVTextEncoderLoader",
      "_meta": {
        "title": "Load Gemma Text Encoder (from directory, CPU offload)"
      }
    },

    "3": {
      "inputs": {
        "text": "A cinematic video prompt placeholder",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Positive Prompt" }
    },

    "4": {
      "inputs": {
        "text": "",
        "clip": ["2", 0]
      },
      "class_type": "CLIPTextEncode",
      "_meta": { "title": "Negative Prompt" }
    },

    "5": {
      "inputs": {
        "model": ["1", 0],
        "vae": ["1", 2],
        "positive": ["3", 0],
        "negative": ["4", 0],
        "width": 768,
        "height": 432,
        "num_frames": 121,
        "frame_rate": 24,
        "seed": 0,
        "steps": 8,
        "cfg": 1.0,
        "spatial_upscaler_model": "ltx-2.3-spatial-upscaler-x2-1.0.safetensors"
      },
      "class_type": "LTXVDistilledPipeline",
      "_meta": {
        "title": "LTX-2.3 Distilled Pipeline (two-stage, NestedTensor-safe, outputs IMAGE)"
      }
    },

    "6": {
      "inputs": {
        "images": ["5", 0],
        "fps": 24
      },
      "class_type": "CreateVideo",
      "_meta": { "title": "Create Video @ 24fps" }
    },

    "7": {
      "inputs": {
        "video": ["6", 0],
        "filename_prefix": "ltx23_t2v",
        "format": "auto",
        "codec": "auto"
      },
      "class_type": "SaveVideo",
      "_meta": { "title": "Save Video" }
    }
  }
}
