# YUME 1.5 Docker Image (REST API Backend)
# 
# This image provides YUME 1.5 (Yume-5B-720P) for interactive world generation.
# YUME uses a custom diffusion pipeline built on FastVideo/HunyuanVideo.
# Uses a REST API server instead of ComfyUI for better compatibility.
#
# Reference: https://github.com/stdstu12/YUME
# Model: https://huggingface.co/stdstu123/Yume-5B-720P

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV TOKENIZERS_PARALLELISM=false
ENV YUME_MODEL_PATH=/opt/models/Yume

# System dependencies (using Python 3.10 from Ubuntu 22.04 default repos to avoid PPA)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget libgl1-mesa-glx libgl1-mesa-dri \
    ffmpeg libsm6 libxext6 build-essential \
    python3.10 python3.10-venv python3.10-distutils python3.10-dev \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Base Python packages
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu128 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg timm decord av uv \
        diffusers transformers accelerate einops omegaconf huggingface_hub[cli] scikit-image \
        ftfy regex tqdm matplotlib tensorboard bitsandbytes scipy packaging \
        fastapi uvicorn python-multipart pillow easydict \
        pytorch-lightning peft yacs moviepy fvcore pytorchvideo liger_kernel triton \
        flask flask-cors

# Install flash-attn (requires CUDA devel tools and must be after torch)
RUN python -m pip install --no-cache-dir flash-attn --no-build-isolation

# Clone YUME repository
WORKDIR /opt
RUN git clone --depth=1 https://github.com/stdstu12/YUME.git \
    && cd YUME \
    && rm -rf .git \
    && python -m pip install --no-cache-dir -r requirements.txt || true \
    && python -m pip install --no-cache-dir -e . || true

# Download InternVL3 Model (Required for YUME)
# The code expects InternVL3-2B-Instruct at a hardcoded path.
RUN huggingface-cli download OpenGVLab/InternVL3-2B-Instruct --local-dir /opt/models/InternVL3-2B-Instruct

# Patch hardcoded private paths in YUME codebase to point to our local model
RUN grep -r "/mnt/petrelfs" /opt/YUME | cut -d: -f1 | sort | uniq | xargs -I {} sed -i "s|/mnt/petrelfs/maoxiaofeng/Yume_v2_release/InternVL3-2B-Instruct|/opt/models/InternVL3-2B-Instruct|g" {}

# Download Model Checkpoint (Split into layers to ensure reliable docker push)
# attempting to push a single 30GB layer often causes 502 Bad Gateway errors.
# By splitting downloads, we create smaller, manageable layers (~10GB each).

RUN mkdir -p /opt/models/Yume

# Layer 1: Config files & VAE (Small)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.json" "*.yaml" "*.md" ".gitattributes" "*VAE*"

# Layer 2: T5 Text Encoder (~5-10GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*t5*"

# Layer 3: Main Diffusion Model (~10-15GB) & Symlink
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.safetensors" \
    && ln -sf /opt/models/Yume /opt/YUME/Yume-5B-720P

# Create directories for output
RUN mkdir -p /opt/output /opt/input

# Working directory for webapp
WORKDIR /opt/YUME

# Environment variables for the webapp
ENV WEB_PORT=8000
ENV DEVICE_ID=0
ENV CHECKPOINT_DIR=/opt/models/Yume

# Expose REST API port
EXPOSE 8000

# Run the official YUME webapp (has working generation logic)
CMD ["python", "-u", "/opt/YUME/webapp_single_gpu.py"]
