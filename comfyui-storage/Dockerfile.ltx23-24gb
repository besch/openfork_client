# LTX-2.3 22B Docker Image (24GB VRAM)
#
# KEY ARCHITECTURE DECISIONS:
#   1. Uses LTX-2.3 DistilledPipeline node (high-level, handles NestedTensor internally)
#      — avoids all ComfyUI core nodes_lt.py NestedTensor crash issues
#   2. Gemma encoder stored as full directory (gemma-3-12b-it-qat-q4_0-unquantized/)
#      not as a single safetensors file
#   3. Latest ComfyUI master (no pinned tag — tags are unreliable for this model)
#   4. No --novram flag (degrades VAE precision on 24GB cards)
#
# Models:
#   - Checkpoint:  ltx-2.3-22b-dev.safetensors  (46.1GB BF16)
#   - Encoder:     gemma-3-12b-it-qat-q4_0-unquantized/ (directory, ~6GB)
#   - Upscaler:    ltx-2.3-spatial-upscaler-x2-1.0.safetensors
#
# Minimum: 24GB VRAM | System RAM: 64GB+

FROM nvidia/cuda:12.6.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

ARG HF_TOKEN
ENV HF_TOKEN=${HF_TOKEN}

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-distutils \
    curl git wget libgl1-mesa-glx libgl1-mesa-dri git-lfs ffmpeg \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN python -m pip install --no-cache-dir --upgrade pip

RUN python -m pip install --no-cache-dir \
        torch torchvision torchaudio \
        --index-url https://download.pytorch.org/whl/cu126 \
    && rm -rf /tmp/* /var/tmp/*

RUN python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg \
        GitPython PyGithub matrix-client==0.4.0 transformers \
        huggingface-hub color-matcher matplotlib mss toml \
        rich uv sentencepiece bitsandbytes xformers accelerate \
    && rm -rf /tmp/* /var/tmp/*

WORKDIR /opt/ComfyUI

ARG CACHEBUST=1

# Latest ComfyUI master — no pinned tag, LTX-2.3 is developed against master
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && python -m pip install --no-cache-dir -r requirements.txt \
    && rm -rf /tmp/* /var/tmp/*

RUN git clone --depth=1 https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git \
    && rm -rf /tmp/* /var/tmp/*

# Full clone of ComfyUI-LTXVideo — required for DistilledPipeline and all LTX-2.3 nodes
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && cd custom_nodes/ComfyUI-LTXVideo \
    && (python -m pip install --no-cache-dir -r requirements.txt || true) \
    && rm -rf /tmp/* /var/tmp/*

RUN git clone --depth=1 https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && rm -rf /tmp/* /var/tmp/*

RUN mkdir -p models/checkpoints \
    models/vae \
    models/loras \
    models/latent_upscale_models \
    "models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized"

ENV LTX23_TIER=24gb

# LTX-2.3 22B Dev checkpoint (46.1GB)
RUN echo "Downloading LTX-2.3 22B checkpoint..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-dev.safetensors', \
    local_dir='/tmp/ckpt', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/ckpt/ltx-2.3-22b-dev.safetensors models/checkpoints/ && \
    rm -rf /tmp/ckpt && \
    python -c "import os; s=os.path.getsize('models/checkpoints/ltx-2.3-22b-dev.safetensors')/(1024**3); print(f'Checkpoint: {s:.1f}GB'); assert s>40" && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Gemma text encoder — downloaded as full directory (required by LTXVTextEncoderLoader)
RUN echo "Downloading Gemma text encoder directory..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Lightricks/LTX-2.3', local_dir='/tmp/ltx23', allow_patterns=['gemma-3-12b-it-qat-q4_0-unquantized/*'], token=os.getenv('HF_TOKEN'))" && \
    cp -r /tmp/ltx23/gemma-3-12b-it-qat-q4_0-unquantized/* \
        "models/text_encoders/gemma-3-12b-it-qat-q4_0-unquantized/" && \
    rm -rf /tmp/ltx23 && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Spatial Upscaler x2
RUN echo "Downloading spatial upscaler..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-spatial-upscaler-x2-1.0.safetensors', \
    local_dir='/tmp/up', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/up/ltx-2.3-spatial-upscaler-x2-1.0.safetensors models/latent_upscale_models/ && \
    rm -rf /tmp/up && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

# Temporal Upscaler x2
RUN echo "Downloading temporal upscaler..." && \
    python -c "import os; from huggingface_hub import hf_hub_download; \
    hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-temporal-upscaler-x2-1.0.safetensors', \
    local_dir='/tmp/tup', token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/tup/ltx-2.3-temporal-upscaler-x2-1.0.safetensors models/latent_upscale_models/ && \
    rm -rf /tmp/tup && \
    rm -rf /root/.cache/huggingface/* /tmp/* /var/tmp/* ~/.cache/*

RUN find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true \
    && find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true \
    && rm -rf /root/.cache/* /tmp/* /var/tmp/* ~/.cache/*

WORKDIR /opt/ComfyUI

# --reserve-vram 2.0: keep 2GB headroom on 24GB card
# --use-split-cross-attention: memory efficient attention
# NOTE: --novram intentionally omitted — DGN client adds it; it degrades VAE on 24GB
CMD ["python", "main.py", "--listen", "--reserve-vram", "2.0", "--use-split-cross-attention"]