# LTX-2 19B Docker Image (8GB VRAM Optimized) - GGUF VERSION - FIXED
# Uses GGUF quantized models that STAY COMPRESSED in RAM
# Critical for 8GB VRAM + 32GB RAM systems
# Based on Kijai/LTXV2_comfy GGUF recommendations

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

# Build arguments for HuggingFace authentication
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
# FIXED: Add PYTHONPATH to ensure custom nodes are discoverable
ENV PYTHONPATH=/opt/ComfyUI:/opt/ComfyUI/custom_nodes:$PYTHONPATH

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    curl \
    git \
    ffmpeg \
    libsndfile1 \
    libmagic1 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    git-lfs \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Upgrade pip
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

ENV PATH=/usr/local/bin:$PATH

# Install PyTorch with CUDA 12.8
RUN python -m pip install --no-cache-dir \
    torch==2.7.1+cu128 \
    torchvision \
    torchaudio \
    --extra-index-url https://download.pytorch.org/whl/cu128

# Install core dependencies including huggingface-hub with CLI
RUN python -m pip install --no-cache-dir \
    "huggingface-hub[cli]==0.26.2" \
    einops==0.8.0 \
    transformers==4.46.3 \
    diffusers==0.32.1 \
    accelerate==1.2.1 \
    safetensors==0.4.5 \
    Pillow==10.4.0 \
    numpy==1.26.4 \
    scipy==1.14.1 \
    opencv-python==4.10.0.84 \
    imageio==2.36.0 \
    imageio-ffmpeg==0.5.1 \
    PyYAML==6.0.2 \
    requests==2.32.3 \
    tqdm==4.67.1 \
    psutil==6.1.0 \
    sentencepiece==0.2.0 \
    protobuf==5.28.3 \
    comfy-kitchen>=0.1.0

# FIXED: Install GGUF package FIRST with verification
RUN python -m pip install --no-cache-dir --upgrade gguf && \
    python -c "import gguf; print('✓ GGUF package installed successfully')"



# ComfyUI dependencies
RUN python -m pip install --no-cache-dir \
    aiohttp==3.11.10 \
    kornia==0.7.3 \
    spandrel==0.4.0 \
    soundfile==0.12.1 \
    matplotlib==3.9.2 \
    gitpython==3.1.43 \
    huggingface_hub

WORKDIR /opt/ComfyUI

# Clone ComfyUI - use latest
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git checkout master \
    && rm -rf .git

# Install ComfyUI requirements
RUN cd /opt/ComfyUI && python -m pip install --no-cache-dir -r requirements.txt

# Clone ComfyUI-Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git

# Clone ComfyUI-LTXVideo (essential for LTX-2)
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && cd custom_nodes/ComfyUI-LTXVideo \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# Install ComfyUI-KJNodes (Required for LTXVAudioVAELoader)
RUN git clone --depth=1 https://github.com/Kijai/ComfyUI-KJNodes.git custom_nodes/ComfyUI-KJNodes \
    && rm -rf custom_nodes/ComfyUI-KJNodes/.git \
    && (python -m pip install --no-cache-dir -r custom_nodes/ComfyUI-KJNodes/requirements.txt || true)

# Patch embeddings_connector.py
RUN find custom_nodes/ComfyUI-LTXVideo -name "embeddings_connector.py" -exec python3 -c "import sys; path=sys.argv[1]; print(f'Patching {path}'); content=open(path).read(); content=content.replace('repeat(hidden_states.shape[0], 1, 1))', 'repeat(hidden_states.shape[0], 1, 1).to(hidden_states.device))'); open(path,'w').write(content)" {} \;

# Clone VideoHelperSuite
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && cd custom_nodes/VideoHelperSuite \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# ============================================================================
# CRITICAL: Install ComfyUI-GGUF for GGUF model loading
# This enables UnetLoaderGGUF and DualCLIPLoaderGGUF nodes
# FIXED: Proper installation order and verification
# ============================================================================

# Clone ComfyUI-GGUF
RUN git clone https://github.com/city96/ComfyUI-GGUF.git custom_nodes/ComfyUI-GGUF \
    && rm -rf custom_nodes/ComfyUI-GGUF/.git

# FIXED: Install GGUF dependencies from the custom node directory
RUN cd custom_nodes/ComfyUI-GGUF && \
    python -m pip install --no-cache-dir --upgrade gguf && \
    if [ -f requirements.txt ]; then python -m pip install --no-cache-dir -r requirements.txt; fi

# Create model directories
RUN mkdir -p \
    models/checkpoints \
    models/unet \
    models/clip \
    models/clip_gguf \
    models/vae \
    models/latent_upscale_models \
    models/loras \
    input \
    output \
    temp

# ============================================================================
# MODEL DOWNLOADS - GGUF QUANTIZED FOR TRUE 8GB OPERATION
# GGUF models stay compressed in RAM unlike FP8 safetensors
# ============================================================================

# Download LTX-2 Distilled GGUF Q4 model (~12GB - stays compressed in RAM!)
# Source: Kijai/LTXV2_comfy
RUN echo "Downloading LTX-2 Distilled GGUF Q4 model..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Kijai/LTXV2_comfy', repo_type='model', local_dir='/tmp/kijai_models', allow_patterns=['diffusion_models/ltx-2-19b-distilled_Q4_K_M.gguf'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/kijai_models/diffusion_models/ltx-2-19b-distilled_Q4_K_M.gguf models/unet/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ LTX-2 GGUF Q4 downloaded (~12GB)" && \
    ls -lh models/unet/

# Download VAE (~5GB) - Still needs safetensors version
# Source: Kijai/LTXV2_comfy
RUN echo "Downloading VAE..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Kijai/LTXV2_comfy', repo_type='model', local_dir='/tmp/kijai_models', allow_patterns=['VAE/LTX2_video_vae_bf16.safetensors'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/kijai_models/VAE/LTX2_video_vae_bf16.safetensors models/vae/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ VAE downloaded (5GB)" && \
    ls -lh models/vae/

# Download Audio VAE (~1GB)
# Source: Kijai/LTXV2_comfy
RUN echo "Downloading Audio VAE..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Kijai/LTXV2_comfy', repo_type='model', local_dir='/tmp/kijai_models', allow_patterns=['VAE/LTX2_audio_vae_bf16.safetensors'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/kijai_models/VAE/LTX2_audio_vae_bf16.safetensors models/vae/LTX2-Audio-VAE-BF16.safetensors && \
    ln -s /opt/ComfyUI/models/vae/LTX2-Audio-VAE-BF16.safetensors models/checkpoints/LTX2-Audio-VAE-BF16.safetensors && \
    rm -rf /tmp/kijai_models && \
    echo "✓ Audio VAE downloaded" && \
    ls -lh models/vae/

# Download Gemma-3 12B FP4 MIXED text encoder (9.4GB - much smaller than FP8/BF16!)
# Source: Comfy-Org/ltx-2 (official ComfyUI models)
# This should expand to ~18GB in RAM vs ~26GB for FP8
RUN echo "Downloading Gemma-3 12B FP4 Mixed text encoder from Comfy-Org..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Comfy-Org/ltx-2', repo_type='model', local_dir='/tmp/comfy_models', allow_patterns=['split_files/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/comfy_models/split_files/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors models/clip/ && \
    rm -rf /tmp/comfy_models && \
    echo "✓ Gemma-3 FP4 Mixed downloaded (9.4GB)" && \
    ls -lh models/clip/

# Download LTX-2 FP4 projections (required for DualCLIPLoader)
# Source: GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn
RUN echo "Downloading LTX-2 projections..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn', repo_type='model', local_dir='/tmp/fp8_models', allow_patterns=['ltx-2-19b-dev-fp4_projections_only.safetensors'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/fp8_models/ltx-2-19b-dev-fp4_projections_only.safetensors models/clip/ && \
    rm -rf /tmp/fp8_models && \
    echo "✓ Projections downloaded" && \
    ls -lh models/clip/

# Download distilled LoRA (optional, for even faster generation)
RUN echo "Downloading distilled LoRA..." && \
    python -c "import os; from huggingface_hub import snapshot_download; snapshot_download(repo_id='Lightricks/LTX-2', repo_type='model', local_dir='/tmp/lightricks_models', allow_patterns=['ltx-2-19b-distilled-lora-384.safetensors'], token=os.getenv('HF_TOKEN'))" && \
    mv /tmp/lightricks_models/ltx-2-19b-distilled-lora-384.safetensors \
       models/loras/ && \
    rm -rf /tmp/lightricks_models && \
    echo "✓ Distilled LoRA downloaded"

# Verify all downloads
RUN echo "=== Model Download Summary ===" && \
    echo "UNET Models:" && ls -lh models/unet/ && \
    echo "VAE Models:" && ls -lh models/vae/ && \
    echo "CLIP GGUF Models:" && ls -lh models/clip_gguf/ && \
    echo "CLIP Models:" && ls -lh models/clip/ && \
    echo "LoRA Models:" && ls -lh models/loras/ && \
    echo "=== Total disk usage ===" && \
    du -sh models/

# Expose port
EXPOSE 8188

# Set environment variables for memory optimization
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV CUDA_MODULE_LOADING=LAZY

# Entry point with 8GB VRAM optimization flags
CMD ["python", "main.py", "--listen", "0.0.0.0", "--port", "8188", "--lowvram", "--reserve-vram", "1"]