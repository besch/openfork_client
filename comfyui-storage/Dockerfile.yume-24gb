# YUME 1.5 Docker Image (REST API Backend)
# 
# This image provides YUME 1.5 (Yume-5B-720P) for interactive world generation.
# YUME uses a custom diffusion pipeline built on FastVideo/HunyuanVideo.
# Uses a REST API server for better compatibility.
#
# Reference: https://github.com/stdstu12/YUME
# Model: https://huggingface.co/stdstu123/Yume-5B-720P

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV TOKENIZERS_PARALLELISM=false
ENV YUME_MODEL_PATH=/opt/models/Yume

# System dependencies (using Python 3.10 from Ubuntu 22.04 default repos)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget libgl1-mesa-glx libgl1-mesa-dri \
    ffmpeg libsm6 libxext6 build-essential \
    python3.10 python3.10-venv python3.10-distutils python3.10-dev \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/python3.10 /usr/bin/python3 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Base Python packages
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python -m pip install --no-cache-dir \
        torch==2.5.1+cu124 torchvision torchaudio \
        --extra-index-url https://download.pytorch.org/whl/cu124 \
    && python -m pip install --no-cache-dir \
        gitpython PyYAML opencv-python imageio-ffmpeg timm decord av \
        diffusers transformers accelerate einops omegaconf huggingface_hub[cli] scikit-image \
        ftfy regex tqdm matplotlib tensorboard scipy packaging \
        fastapi uvicorn python-multipart pillow easydict \
        pytorch-lightning peft yacs moviepy fvcore pytorchvideo \
        flask flask-cors ninja

# Install flash-attn (requires CUDA devel tools and must be after torch)
RUN python -m pip install --no-cache-dir flash-attn --no-build-isolation

# Clone YUME repository
WORKDIR /opt
RUN git clone --depth=1 https://github.com/stdstu12/YUME.git \
    && cd YUME \
    && rm -rf .git

# CRITICAL FIX: Patch YUME to avoid CUDA initialization during import
# The bug is in wan/modules/t5.py line 478: device=torch.cuda.current_device()
# This gets called at import time, failing when no GPU is present
WORKDIR /opt/YUME
RUN sed -i 's/device=torch.cuda.current_device()/device="cpu"/g' wan/modules/t5.py && \
    echo "✓ Patched wan/modules/t5.py to avoid CUDA init during import"

# Install YUME as a package
# We skip the import test during build because YUME still has issues without GPU
# The actual import will be tested at runtime when GPU is available
RUN python -m pip install --no-cache-dir -r requirements.txt || echo "Some requirements failed, continuing..." \
    && python -m pip install --no-cache-dir -e . && \
    echo "✓ YUME package installed (import verification will happen at runtime with GPU)"

# Download InternVL3 Model (Required for YUME)
ENV INTERNVL_PATH=/opt/models/InternVL3-2B-Instruct
RUN huggingface-cli download OpenGVLab/InternVL3-2B-Instruct --local-dir $INTERNVL_PATH

# Download Model Checkpoint (Split into layers for reliable Docker push)
RUN mkdir -p /opt/models/Yume

# Layer 1: Config files & small files (< 1GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.json" "*.yaml" "*.md" ".gitattributes"

# Layer 2: VAE (~2-3GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*vae*" "*VAE*"

# Layer 3: T5 Text Encoder (~5-10GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*t5*" "*T5*"

# Layer 4: Main Diffusion Model safetensors (~10-15GB)
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume \
    --include "*.safetensors"

# Layer 5: Remaining files
RUN huggingface-cli download stdstu123/Yume-5B-720P --local-dir /opt/models/Yume

# Create symlink for YUME to find model
RUN ln -sf /opt/models/Yume /opt/YUME/Yume-5B-720P

# Create directories for output
RUN mkdir -p /opt/output /opt/input

# Copy the corrected API server (will be provided by DGN client bootstrap)
# The yume_api.py will be downloaded by start_cloud.sh via bootstrap.sh
WORKDIR /opt/YUME

# Environment variables for the API
ENV WEB_PORT=8000
ENV DEVICE_ID=0
ENV CHECKPOINT_DIR=/opt/models/Yume

# CRITICAL: Set CUDA_VISIBLE_DEVICES="" during package imports to prevent CUDA errors
# This will be unset at runtime when GPU is available
ENV CUDA_VISIBLE_DEVICES=""

# Expose REST API port
EXPOSE 8000

# The actual API server will be started by start_cloud.sh
# which downloads yume_api.py from the DGN client repository
CMD ["python", "-u", "/opt/dgn-client/yume_api.py"]