# LTX-2.3 22B — Wan2GP backend — 24 GB VRAM
#
# Wan2GP replaces ComfyUI for this tier. The Python client imports
# shared.api from /opt/wan2gp directly (via WAN2GP_ROOT env var).
#
# Model directory: Wan2GP expects checkpoints in ckpts/ (not models/).
# Gemma text encoder must live in ckpts/gemma-3-12b-it-qat-q4_0-unquantized/.

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV WAN2GP_ROOT=/opt/wan2gp
ENV WAN2GP_OUTPUT=/opt/wan2gp/outputs

# ── System packages ────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3-pip \
    build-essential \
    git git-lfs \
    ffmpeg \
    wget curl \
    libgl1-mesa-glx libglib2.0-0 \
    libsndfile1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1 \
 && update-alternatives --install /usr/bin/python  python  /usr/bin/python3.11 1

# ── Wan2GP ─────────────────────────────────────────────────────────
RUN git clone https://github.com/deepbeepmeep/Wan2GP /opt/wan2gp

WORKDIR /opt/wan2gp

# Install PyTorch first (CUDA 12.4) so Wan2GP deps pick up the right build
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124

# Install Wan2GP requirements
# The extra-index-url is required for the onnxruntime-gpu nightly build
RUN pip3 install --no-cache-dir \
    --extra-index-url https://aiinfra.pkgs.visualstudio.com/PublicPackages/_packaging/ort-cuda-13-nightly/pypi/simple/ \
    -r requirements.txt

# ── Model weights ──────────────────────────────────────────────────
# Wan2GP expects all checkpoints in ckpts/ (not models/).
# Gemma encoder must be in ckpts/gemma-3-12b-it-qat-q4_0-unquantized/ subfolder.
RUN pip3 install --no-cache-dir huggingface-hub

# LTX-2.3 22B base model (46.1 GB BF16) — from Lightricks/LTX-2.3
RUN mkdir -p /opt/wan2gp/ckpts && \
    huggingface-cli download Lightricks/LTX-2.3 \
        ltx-2.3-22b-dev.safetensors \
        --local-dir /opt/wan2gp/ckpts

# LTX-2.3 distilled LoRA (7.6 GB) — required for two-stage pipeline
RUN huggingface-cli download Lightricks/LTX-2.3 \
        ltx-2.3-22b-distilled-lora-384.safetensors \
        --local-dir /opt/wan2gp/ckpts

# Gemma-3 12B text encoder — from DeepBeepMeep/LTX-2, entire subfolder
RUN huggingface-cli download DeepBeepMeep/LTX-2 \
        --include "gemma-3-12b-it-qat-q4_0-unquantized/*" \
        --local-dir /opt/wan2gp/ckpts

# ── Runtime directories ────────────────────────────────────────────
RUN mkdir -p /opt/wan2gp/outputs

# ── Client code ────────────────────────────────────────────────────
# The DGN Python client is fetched at container start via start_cloud.sh.
# Wan2GP is imported by the client through sys.path (WAN2GP_ROOT above).

WORKDIR /workspace