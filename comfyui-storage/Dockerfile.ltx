FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev curl git \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip

# Install PyTorch with CUDA 12.8 wheels explicitly
RUN python -m pip install torch==2.7.1+cu128 torchvision torchaudio --extra-index-url https://download.pytorch.org/whl/cu128

# Install other dependencies
RUN python -m pip install gitpython PyYAML opencv-python imageio-ffmpeg ninja

# Set working directory
WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI
RUN python -m pip install -r requirements.txt

# Clone ComfyUI Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git /opt/ComfyUI/custom_nodes/ComfyUI-Manager
RUN python -m pip install GitPython PyGithub matrix-client==0.4.0 transformers huggingface-hub>0.20

# Clone LTX Video Custom Nodes
# Using the main repo for ComfyUI-LTXVideo
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git /opt/ComfyUI/custom_nodes/ComfyUI-LTXVideo
RUN cd /opt/ComfyUI/custom_nodes/ComfyUI-LTXVideo && python -m pip install -r requirements.txt

# Clone VideoHelperSuite (VHS)
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git /opt/ComfyUI/custom_nodes/VideoHelperSuite
RUN cd /opt/ComfyUI/custom_nodes/VideoHelperSuite && python -m pip install -r requirements.txt

# Clone KJNodes (often useful helpers)
RUN git clone https://github.com/kijai/ComfyUI-KJNodes.git /opt/ComfyUI/custom_nodes/comfyui-kjnodes
RUN cd /opt/ComfyUI/custom_nodes/comfyui-kjnodes && python -m pip install -r requirements.txt


# Install additional system dependencies for OpenCV
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN python -m pip install uv

# Copy user configurations
COPY --chown=user:user ./storage/ComfyUI/user /opt/ComfyUI/user

# --- LTX Video Models ---
# Assuming user will place models in ./storage/ComfyUI/models/checkpoints and text_encoders
# We copy them if they exist in build context, but usually they are volume mounted.
# However, to be consistent with Wan2.2 dockerfile, we can attempt copy.
# But for local dev with voluminous models, volume mount is better.
# The user said "build docker image locally and upload it with the rest of the images", 
# which implies baking models might be desired for the "prod" image but maybe not for local dev.
# For now, I'll rely on volume mounts for the heavy models in dev_compose.
# In prod image (this file), we usually copy. I will add copy instructions but commented out or generic.

# VAEs (if specific VAE is needed, but LTX usually has it or uses standard)
# Text Encoders (T5)
COPY --chown=user:user ./storage/ComfyUI/models/text_encoders/t5xxl_fp16.safetensors /opt/ComfyUI/models/text_encoders/

# Checkpoints
COPY --chown=user:user ./storage/ComfyUI/models/checkpoints/ltx-video-2b-v0.9.1.safetensors /opt/ComfyUI/models/checkpoints/

# Set final working directory and command
WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]
