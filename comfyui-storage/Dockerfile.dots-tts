# syntax=docker/dockerfile:1.4
# dots.tts Docker Image - experimental 6GB VRAM target
# Supports: TTS/random voice sampling and zero-shot voice cloning

FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HOME=/app/models
ENV HUGGINGFACE_HUB_CACHE=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV TORCH_HOME=/app/models
ENV HF_HUB_DISABLE_PROGRESS_BARS=1
ENV HF_HUB_DISABLE_TELEMETRY=1
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip \
    git curl wget ffmpeg libsndfile1 sox build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python3 -m pip install --no-cache-dir --upgrade --ignore-installed pip \
    && python3 -m pip install --no-cache-dir \
        torch==2.8.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

ARG DOTS_TTS_REF=main
RUN git clone --depth=1 --branch "${DOTS_TTS_REF}" https://github.com/rednote-hilab/dots.tts.git /opt/dots.tts \
    && python3 -m pip install --no-cache-dir \
        -e /opt/dots.tts \
        -c /opt/dots.tts/constraints/recommended.txt \
    && python3 -m pip install --no-cache-dir \
        fastapi \
        "uvicorn[standard]" \
        python-multipart \
        requests \
        "huggingface_hub[cli]>=0.36.0"

RUN mkdir -p /app/input /app/output /app/models

ARG DOTS_TTS_MODEL=rednote-hilab/dots.tts-mf
ENV DOTS_TTS_MODEL=${DOTS_TTS_MODEL}
ENV DOTS_TTS_NUM_STEPS=4
ENV DOTS_TTS_GUIDANCE_SCALE=1.2
ENV DOTS_TTS_OPTIMIZE=0
ENV DOTS_TTS_MODEL_CACHE_DIR=/app/models

RUN huggingface-cli download "${DOTS_TTS_MODEL}" \
    --cache-dir /app/models

# Lock to offline mode at runtime; the selected model snapshot is baked in above.
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

COPY dots_tts_api.py /app/dots_tts_api.py

EXPOSE 8000

CMD ["python3", "/app/dots_tts_api.py"]
