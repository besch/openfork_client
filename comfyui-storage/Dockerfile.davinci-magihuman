# OpenFork — daVinci-MagiHuman (15B avatar video+audio, H100/A100 80GB)
#
# What this image provides:
#   - sandai/magi-human base (CUDA 12 + PyTorch 2.10)
#   - MagiCompiler (fuses Transformer layers for ~1.2x speedup)
#   - daVinci-MagiHuman model weights from GAIR/daVinci-MagiHuman (public HF)
#   - FastAPI REST wrapper at port 8000
#
# Build:
#   docker build \
#     -t beschiak/openfork-davinci-magihuman-80gb:latest \
#     -f Dockerfile.davinci-magihuman .
#
# Notes:
#   - Requires 64GB+ VRAM (H100/A100 80GB recommended)
#   - No HF_TOKEN needed — model is publicly accessible
#   - Flash Attention (Hopper variant) is pre-installed in the base image
#   - ComfyUI is NOT used — this image uses the daVinci Python library via REST

FROM sandai/magi-human:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV DAVINCI_ROOT=/opt/davinci-magihuman
ENV DAVINCI_MODELS=/models/davinci-magihuman
ENV DAVINCI_OUTPUT=/tmp/davinci_outputs

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        git wget curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

# ── MagiCompiler (graph fusion for ~1.2x speedup) ────────────────────────────
# Required for full graph compilation in daVinci-MagiHuman
RUN git clone https://github.com/SandAI-org/MagiCompiler.git /opt/MagiCompiler \
    && pip install -r /opt/MagiCompiler/requirements.txt \
    && pip install /opt/MagiCompiler

# ── daVinci-MagiHuman source ──────────────────────────────────────────────────
RUN git clone https://github.com/GAIR-NLP/daVinci-MagiHuman /opt/davinci-magihuman \
    && git -C /opt/davinci-magihuman checkout main

# ── daVinci-MagiHuman Python dependencies ────────────────────────────────────
RUN pip install -r /opt/davinci-magihuman/requirements.txt || true

# Install no-deps requirements separately (strict version pinning)
RUN pip install --no-deps -r /opt/davinci-magihuman/requirements-nodeps.txt || true

# Ensure key packages are at the right versions
RUN pip install \
    transformers==4.56.0 \
    accelerate==1.10.1 \
    timm==1.0.20 \
    loguru==0.7.3

# ── FastAPI & uvicorn for REST wrapper ───────────────────────────────────────
RUN pip install fastapi uvicorn python-multipart

# ── Pre-create directories ────────────────────────────────────────────────────
RUN mkdir -p ${DAVINCI_MODELS} ${DAVINCI_OUTPUT}

# ── Download daVinci-MagiHuman model weights ─────────────────────────────────
# The GAIR/daVinci-MagiHuman repo is public — no HF_TOKEN needed.
# Expected: base model, distilled model, SR models, VAE
RUN pip install -q "huggingface_hub[cli]" \
    && huggingface-cli download GAIR/daVinci-MagiHuman \
        --local-dir ${DAVINCI_MODELS} \
    || { echo "ERROR: daVinci-MagiHuman model download from GAIR/daVinci-MagiHuman failed."; exit 1; }

# ── Also download Wan2.2-TI2V-5B (required by daVinci for I2V) ──────────────
RUN huggingface-cli download Wan-AI/Wan2.2-TI2V-5B \
        --local-dir ${DAVINCI_MODELS}/Wan2.2-TI2V-5B \
    || { echo "WARNING: Wan2.2-TI2V-5B download failed — I2V mode may not work."; }

# ── Copy API wrapper ──────────────────────────────────────────────────────────
RUN mkdir -p /app
COPY davinci_magihuman_api.py /app/davinci_magihuman_api.py

WORKDIR /app
EXPOSE 8000

# Run the API server with dynamic script download from source for updates
ENV HF_HUB_OFFLINE=1
CMD ["/bin/bash", "-c", "curl -s -L -o davinci_magihuman_api.py https://raw.githubusercontent.com/besch/openfork_client/main/comfyui-storage/davinci_magihuman_api.py && python davinci_magihuman_api.py"]
