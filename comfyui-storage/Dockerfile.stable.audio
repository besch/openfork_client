# syntax=docker/dockerfile:1.4
# Stable Audio 3 Small-SFX REST image for sound-effects-only text-to-audio.

FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/models
ENV HUGGINGFACE_HUB_CACHE=/app/models
ENV TRANSFORMERS_CACHE=/app/models
ENV STABLE_AUDIO3_MODEL_ID=small-sfx
ENV STABLE_AUDIO3_MODEL_HALF=true
ENV STABLE_AUDIO3_MAX_DURATION_SECONDS=120
ENV STABLE_AUDIO3_DEFAULT_DURATION=8
ENV STABLE_AUDIO3_DEFAULT_STEPS=8
ENV STABLE_AUDIO3_DEFAULT_CFG_SCALE=1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.10 python3.10-venv python3.10-distutils \
    curl git wget ffmpeg libsndfile1 ca-certificates \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.10 \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir \
        torch==2.7.1+cu126 torchaudio==2.7.1+cu126 \
        --index-url https://download.pytorch.org/whl/cu126

RUN git clone --depth=1 https://github.com/Stability-AI/stable-audio-3.git /opt/stable-audio-3 \
    && python -m pip install --no-cache-dir --no-deps -e /opt/stable-audio-3 \
    && python -m pip install --no-cache-dir \
        "einops>=0.8.2" \
        "einops-exts>=0.0.4" \
        "numpy>=2.2.6" \
        "packaging>=26.0" \
        "safetensors>=0.7.0" \
        "tqdm>=4.67.3" \
        "huggingface-hub>=1.7.1" \
        "transformers>=5.8.0" \
        "soundfile>=0.13.1" \
        fastapi \
        "uvicorn[standard]" \
        requests

RUN mkdir -p /app/output /app/models

ARG HF_TOKEN=""
RUN HF_TOKEN="$HF_TOKEN" python - <<'PY'
from stable_audio_3 import StableAudioModel

model = StableAudioModel.from_pretrained("small-sfx", device="cpu", model_half=False)
print("Stable Audio 3 Small-SFX downloaded:", model.model.sample_rate)
PY

ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

COPY stable_audio3_api.py /app/stable_audio3_api.py

EXPOSE 8000

CMD ["/bin/bash", "-c", "curl -fsSL -o /app/stable_audio3_api.py https://raw.githubusercontent.com/besch/openfork_client/main/comfyui-storage/stable_audio3_api.py || echo 'WARNING: Could not update stable_audio3_api.py, using baked-in copy'; python /app/stable_audio3_api.py"]
