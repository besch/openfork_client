# LTX-2 19B Docker Image (8GB VRAM Optimized) - FULLY CORRECTED VERSION
# Based on actual Kijai/LTXV2_comfy and Comfy-Org repositories
# Uses FP8 quantized model (~21.6GB) with proper text encoder setup
# Optimized for 8GB VRAM with RAM offloading

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

# Build arguments for HuggingFace authentication
ARG HF_TOKEN=""
ENV HF_TOKEN=${HF_TOKEN}

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV PIP_NO_CACHE_DIR=1
ENV PYTHONUNBUFFERED=1

# System dependencies (using Ubuntu 22.04's default Python 3.10)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    curl \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    git-lfs \
    ffmpeg \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Upgrade pip and install build tools
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.1 support (version 2.5.1 for comfy_kitchen compatibility)
RUN python -m pip install --no-cache-dir \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    --index-url https://download.pytorch.org/whl/cu121

# Install huggingface-cli and core dependencies
RUN python -m pip install --no-cache-dir \
    "huggingface-hub[cli]==0.26.2" \
    einops==0.8.0 \
    transformers==4.46.3 \
    diffusers==0.32.1 \
    accelerate==1.2.1 \
    safetensors==0.4.5 \
    Pillow==10.4.0 \
    numpy==1.26.4 \
    scipy==1.14.1 \
    opencv-python==4.10.0.84 \
    imageio==2.36.0 \
    imageio-ffmpeg==0.5.1 \
    PyYAML==6.0.2 \
    requests==2.32.3 \
    tqdm==4.67.1 \
    psutil==6.1.0 \
    sentencepiece==0.2.0 \
    protobuf==5.28.3 \
    comfy-kitchen>=0.1.0

# Additional ComfyUI dependencies
RUN python -m pip install --no-cache-dir \
    aiohttp==3.11.10 \
    kornia==0.7.3 \
    spandrel==0.4.0 \
    soundfile==0.12.1 \
    matplotlib==3.9.2 \
    gitpython==3.1.43

WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && cd /opt/ComfyUI \
    && git checkout master \
    && rm -rf .git

# Install ComfyUI requirements
RUN cd /opt/ComfyUI && python -m pip install --no-cache-dir -r requirements.txt

# Clone ComfyUI-Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager \
    && rm -rf custom_nodes/ComfyUI-Manager/.git

# Clone ComfyUI-LTXVideo (essential for LTX-2 support)
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git custom_nodes/ComfyUI-LTXVideo \
    && rm -rf custom_nodes/ComfyUI-LTXVideo/.git \
    && cd custom_nodes/ComfyUI-LTXVideo \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# Patch embeddings_connector.py to prevent device mismatch errors
RUN find custom_nodes/ComfyUI-LTXVideo -name "embeddings_connector.py" -exec python3 -c "import sys; path=sys.argv[1]; print(f'Patching {path}'); content=open(path).read(); content=content.replace('repeat(hidden_states.shape[0], 1, 1))', 'repeat(hidden_states.shape[0], 1, 1).to(hidden_states.device))'); open(path,'w').write(content)" {} \;

# Clone VideoHelperSuite
RUN git clone https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git custom_nodes/VideoHelperSuite \
    && rm -rf custom_nodes/VideoHelperSuite/.git \
    && cd custom_nodes/VideoHelperSuite \
    && python -m pip install --no-cache-dir -r requirements.txt || true

# Create model directory structure
RUN mkdir -p \
    models/checkpoints \
    models/unet \
    models/clip \
    models/text_encoders \
    models/latent_upscale_models \
    models/loras \
    models/vae \
    input \
    output \
    temp

# ============================================================================
# CRITICAL SECTION: Download models from correct repositories
# Using ACTUAL file structure from Kijai and Comfy-Org
# ============================================================================

# Download LTX-2 FP8 diffusion model (~21.6GB) from Kijai
# This is the smallest viable model for 8GB VRAM
# Source: https://huggingface.co/Kijai/LTXV2_comfy/tree/main/diffusion_models
RUN echo "Downloading LTX-2 19B FP8 diffusion model (ComfyUI-optimized)..." && \
    huggingface-cli download Kijai/LTXV2_comfy \
    --repo-type model \
    --local-dir /tmp/kijai_models \
    --include "diffusion_models/ltx-2-19b-dev-fp8_transformer_only.safetensors" \
    --token ${HF_TOKEN} && \
    mkdir -p models/unet && \
    mv /tmp/kijai_models/diffusion_models/ltx-2-19b-dev-fp8_transformer_only.safetensors \
       models/unet/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ LTX-2 FP8 diffusion model downloaded successfully" && \
    ls -lh models/unet/

# Download VAE models from Kijai (~5GB)
# Source: https://huggingface.co/Kijai/LTXV2_comfy/tree/main/VAE
RUN echo "Downloading VAE models..." && \
    huggingface-cli download Kijai/LTXV2_comfy \
    --repo-type model \
    --local-dir /tmp/kijai_models \
    --include "VAE/LTX2_video_vae_bf16.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/kijai_models/VAE/LTX2_video_vae_bf16.safetensors models/vae/ && \
    rm -rf /tmp/kijai_models && \
    echo "✓ VAE models downloaded successfully" && \
    ls -lh models/vae/

# Download LTX-2 projections for DualCLIPLoader compatibility
# CRITICAL: This file is specifically designed for DualCLIPLoader node
# Using embeddings_connector causes "clip missing" errors with DualCLIPLoader
# Source: https://huggingface.co/GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn
RUN echo "Downloading LTX-2 projections for DualCLIPLoader..." && \
    huggingface-cli download GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn \
    --repo-type model \
    --local-dir /tmp/fp8_models \
    --include "ltx-2-19b-dev-fp4_projections_only.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/fp8_models/ltx-2-19b-dev-fp4_projections_only.safetensors \
       models/clip/ && \
    rm -rf /tmp/fp8_models && \
    echo "✓ LTX-2 projections downloaded successfully" && \
    ls -lh models/clip/

# Download Gemma-3 12B FP8 text encoder (~6GB, optimized for 8GB VRAM)
# Source: https://huggingface.co/GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn
RUN echo "Downloading Gemma-3 12B FP8 text encoder..." && \
    huggingface-cli download GitMylo/LTX-2-comfy_gemma_fp8_e4m3fn \
    --repo-type model \
    --local-dir /tmp/fp8_models \
    --include "gemma_3_12B_it_fp8_e4m3fn.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/fp8_models/gemma_3_12B_it_fp8_e4m3fn.safetensors \
       models/clip/ && \
    rm -rf /tmp/fp8_models && \
    echo "✓ Gemma-3 FP8 text encoder downloaded successfully" && \
    ls -lh models/clip/

# ============================================================================
# Download supporting models from Lightricks (optional but recommended)
# ============================================================================

# Download spatial upscaler (996MB)
# Source: https://huggingface.co/Lightricks/LTX-2
RUN echo "Downloading spatial upscaler..." && \
    huggingface-cli download Lightricks/LTX-2 \
    --repo-type model \
    --local-dir /tmp/lightricks_models \
    --include "ltx-2-spatial-upscaler-x2-1.0.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lightricks_models/ltx-2-spatial-upscaler-x2-1.0.safetensors \
       models/latent_upscale_models/ && \
    rm -rf /tmp/lightricks_models && \
    echo "✓ Spatial upscaler downloaded successfully"

# Download distilled LoRA for faster generation
# Source: https://huggingface.co/Lightricks/LTX-2
RUN echo "Downloading distilled LoRA..." && \
    huggingface-cli download Lightricks/LTX-2 \
    --repo-type model \
    --local-dir /tmp/lightricks_models \
    --include "ltx-2-19b-distilled-lora-384.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lightricks_models/ltx-2-19b-distilled-lora-384.safetensors \
       models/loras/ && \
    rm -rf /tmp/lightricks_models && \
    echo "✓ Distilled LoRA downloaded successfully"

# Download Camera Control LoRAs from verified repositories
# Each LoRA is in its own repository under Lightricks organization
RUN echo "Downloading camera control LoRAs..." && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-In \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-dolly-in.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-dolly-in.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Out \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-dolly-out.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-dolly-out.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Left \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-dolly-left.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-dolly-left.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Dolly-Right \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-dolly-right.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-dolly-right.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Up \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-jib-up.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-jib-up.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Jib-Down \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-jib-down.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-jib-down.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    huggingface-cli download Lightricks/LTX-2-19b-LoRA-Camera-Control-Static \
    --repo-type model \
    --local-dir /tmp/lora_temp \
    --include "ltx-2-19b-lora-camera-control-static.safetensors" \
    --token ${HF_TOKEN} && \
    mv /tmp/lora_temp/ltx-2-19b-lora-camera-control-static.safetensors models/loras/ && \
    rm -rf /tmp/lora_temp && \
    echo "✓ Camera control LoRAs downloaded successfully"

# Create extra_model_paths.yaml for proper model discovery
RUN echo "comfyui:" > extra_model_paths.yaml && \
    echo "  base_path: /opt/ComfyUI/" >> extra_model_paths.yaml && \
    echo "  checkpoints: models/checkpoints/" >> extra_model_paths.yaml && \
    echo "  unet: models/unet/" >> extra_model_paths.yaml && \
    echo "  clip: models/clip/" >> extra_model_paths.yaml && \
    echo "  text_encoders: models/text_encoders/" >> extra_model_paths.yaml && \
    echo "  loras: models/loras/" >> extra_model_paths.yaml && \
    echo "  upscale_models: models/latent_upscale_models/" >> extra_model_paths.yaml && \
    echo "  vae: models/vae/" >> extra_model_paths.yaml

# Verify final model structure
RUN echo "=== Final Model Structure ===" && \
    echo "UNET (Diffusion Model):" && ls -lh models/unet/ && \
    echo "CLIP (Text Encoders):" && ls -lh models/clip/ && \
    echo "VAE:" && ls -lh models/vae/ && \
    echo "LoRAs:" && ls -lh models/loras/ && \
    echo "Upscale Models:" && ls -lh models/latent_upscale_models/

# Clean up to reduce image size
RUN find /opt/ComfyUI -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find /opt/ComfyUI -name "*.pyc" -delete 2>/dev/null || true && \
    find /opt/ComfyUI -name ".git" -type d -exec rm -rf {} + 2>/dev/null || true

# Set proper permissions
RUN chmod -R 755 /opt/ComfyUI

# Expose ComfyUI port
EXPOSE 8188

WORKDIR /opt/ComfyUI

# Start ComfyUI with AGGRESSIVE 8GB VRAM optimization settings
# Critical for RTX 4060/3060/3070 and similar 8GB cards
#
# --lowvram: Essential - Offloads model weights to RAM when not in use
# --cpu-vae: Runs VAE decode on CPU, saves ~1-2GB VRAM (slower but stable)
# --disable-smart-memory: Prevents memory caching that causes silent OOM crashes
# --reserve-vram 1.0: Keeps 1GB VRAM free for CUDA kernels
# --force-fp16: Forces FP16 precision where possible for memory efficiency
# --use-split-cross-attention: Reduces memory spikes during attention computation
# --preview-method none: Disables preview generation to save VRAM
CMD ["python", "main.py", \
     "--listen", "0.0.0.0", \
     "--port", "8188", \
     "--lowvram", \
     "--cpu-vae", \
     "--disable-smart-memory", \
     "--reserve-vram", "1.0", \
     "--force-fp16", \
     "--use-split-cross-attention", \
     "--preview-method", "none"]

# Build instructions:
# docker build --build-arg HF_TOKEN=your_token_here -t ltx2-8gb-fp8 -f Dockerfile .
# 
# Run instructions:
# docker run --gpus all -p 8188:8188 -v $(pwd)/output:/opt/ComfyUI/output ltx2-8gb-fp8
#
# IMPORTANT: Your HF token must have access to:
# - Kijai/LTXV2_comfy (public)
# - Comfy-Org/ltx-2 (public)
# - Lightricks/LTX-2 (public)
#
# NOTE: This uses FP8 model instead of FP4 because:
# 1. FP4 model doesn't exist in split format in Kijai's repo
# 2. FP8 is the recommended quantization for 8GB VRAM in current setup
# 3. FP8 provides better quality than FP4 with minimal VRAM increase