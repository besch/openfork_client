# syntax=docker/dockerfile:1.4
FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=$CUDA_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$CUDA_HOME/lib64:$LD_LIBRARY_PATH
ENV TORCH_CUDA_INDEX_URL=https://download.pytorch.org/whl/cu121

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.11 python3.11-venv python3.11-distutils python3.11-dev \
    curl git wget sed git-lfs \
    ffmpeg \
    libavformat-dev libavcodec-dev libavdevice-dev \
    libavutil-dev libavfilter-dev libswscale-dev libswresample-dev \
    pkg-config \
    libgl1-mesa-glx libgl1-mesa-dri \
    libsndfile1 libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 \
    && ln -sf /usr/bin/python3.11 /usr/bin/python

RUN python -m pip install --upgrade pip

# Install PyTorch with CUDA 12.1 wheels
RUN python -m pip install torch==2.3.1+cu121 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

# Install base dependencies
RUN python -m pip install PyYAML opencv-python imageio-ffmpeg

# Set working directory
WORKDIR /opt/ComfyUI

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI
RUN python -m pip install -r requirements.txt

# Install ComfyUI Manager
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git /opt/ComfyUI/custom_nodes/ComfyUI-Manager
RUN python -m pip install -r /opt/ComfyUI/custom_nodes/ComfyUI-Manager/requirements.txt

# Install ComfyUI-audio custom node for AudioCraft
RUN git clone https://github.com/eigenpunk/ComfyUI-audio.git /opt/ComfyUI/custom_nodes/ComfyUI-audio

# Install audio dependencies manually (avoiding requirements.txt with missing voicefixer)
RUN python -m pip install audiocraft
RUN python -m pip install --pre vall_e_x
RUN python -m pip install git+https://github.com/rsxdalv/tortoise-tts.git@e4711433b12bcd1086840649e1830ad5c3fa1a76#egg=tortoise-tts
RUN python -m pip install --ignore-installed blinker
RUN python -m pip install voicefixer

# Install uv for ComfyUI-Manager
RUN python -m pip install uv

# Create audiocraft models directory
RUN mkdir -p /opt/ComfyUI/models/audiocraft

# Download AudioGen models
RUN git lfs install && \
    git clone https://huggingface.co/facebook/audiogen-medium /opt/ComfyUI/models/audiocraft/audiogen-medium

# Set final working directory and command
WORKDIR /opt/ComfyUI
CMD ["python", "main.py", "--listen"]