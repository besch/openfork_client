# syntax=docker/dockerfile:1.4
# Dockerfile.ltx23-32gb
# LTX-2.3 Audio-Video Model — 32GB VRAM tier
#
# KEY DIFFERENCES from ltx23-24gb:
#   - Resolution: 1024x576 (vs 768x432) — ~1.8x more pixels
#   - Frames:     153 (vs 121) — ~6.4s vs 5s at 24fps
#   - VRAM flags: --lowvram (vs --novram) — 32GB headroom allows partial in-VRAM inference
#   - Models:     BOTH distilled (T2V) AND dev (I2V) — requires ~120GB disk
#   - No reserve-vram: keep default 2GB reservation for stability
#
# MODELS INCLUDED:
#   ltx-2.3-22b-distilled.safetensors          (46.1 GB) — T2V, 8-step fast generation
#   ltx-2.3-22b-dev.safetensors                (46.1 GB) — I2V, 15-step quality generation
#   ltx-2.3-22b-distilled-lora-384.safetensors (~0.5 GB) — speed LoRA for I2V
#   gemma_3_12B_it_fp4_mixed.safetensors        (~6 GB)  — Gemma-3 12B FP4 text encoder
#
# FIXES vs original:
#   1. Spatial upscaler: 1.0 -> 1.1 (v1.0 had known artifact/color-overlay bug)
#   2. Gemma encoder source: was Lightricks/LTX-2.3 (file doesn't exist there)
#      FIXED: Comfy-Org/ltx-2 -> split_files/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors
#   3. Added temporal upscaler download (was missing entirely)
#
# SYSTEM REQUIREMENTS:
#   GPU:  32GB+ VRAM (CUDA)
#   RAM:  64GB+ system RAM (model CPU offloads during inference)
#   Disk: ~120GB (both checkpoints + encoder + OS/ComfyUI)
#   Swap: 128GB recommended

ARG PYTORCH_VERSION=2.5.1
ARG CUDA_VERSION=12.4
ARG BASE_IMAGE=pytorch/pytorch:${PYTORCH_VERSION}-cuda${CUDA_VERSION}-cudnn9-devel

FROM ${BASE_IMAGE}

LABEL maintainer="OpenFork"
LABEL description="LTX-2.3 22B Audio-Video Model — 32GB VRAM tier"
LABEL version="1.1"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ============================================================
# Install ComfyUI
# ============================================================
WORKDIR /opt
RUN git clone --depth=1 https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI
WORKDIR /opt/ComfyUI
RUN pip install --quiet --no-cache-dir -r requirements.txt

RUN mkdir -p \
    /opt/ComfyUI/models/checkpoints \
    /opt/ComfyUI/models/loras \
    /opt/ComfyUI/models/text_encoders \
    /opt/ComfyUI/models/vae \
    /opt/ComfyUI/models/upscale_models \
    /opt/ComfyUI/models/latent_upscale_models \
    /opt/ComfyUI/input \
    /opt/ComfyUI/output

# ============================================================
# Install Custom Nodes
# ============================================================

# ComfyUI-LTXVideo — master branch required for LTX-2.3 audio nodes
RUN git clone https://github.com/Lightricks/ComfyUI-LTXVideo.git \
    /opt/ComfyUI/custom_nodes/ComfyUI-LTXVideo \
    && pip install --quiet --no-cache-dir \
        -r /opt/ComfyUI/custom_nodes/ComfyUI-LTXVideo/requirements.txt

# ComfyUI-VideoHelperSuite — for VHS_VideoCombine with audio support
RUN git clone --depth=1 \
    https://github.com/Kosinkadink/ComfyUI-VideoHelperSuite.git \
    /opt/ComfyUI/custom_nodes/ComfyUI-VideoHelperSuite \
    && pip install --quiet --no-cache-dir \
        -r /opt/ComfyUI/custom_nodes/ComfyUI-VideoHelperSuite/requirements.txt

# ============================================================
# Download Models
# ============================================================

# Force-reinstall huggingface_hub AFTER all custom node pip installs,
# which may downgrade it to versions that break the Python API.
RUN pip install --quiet --no-cache-dir --force-reinstall 'huggingface_hub>=0.26.0'

# LTX-2.3 22B Distilled — T2V (fast, 8-step, distilled schedule)
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-distilled.safetensors', local_dir='/opt/ComfyUI/models/checkpoints', local_dir_use_symlinks=False)"

# LTX-2.3 22B Dev — I2V (quality, 15-step, standard schedule)
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-dev.safetensors', local_dir='/opt/ComfyUI/models/checkpoints', local_dir_use_symlinks=False)"

# Distilled LoRA — applied to dev model for I2V speed boost (strength=0.2)
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-22b-distilled-lora-384.safetensors', local_dir='/opt/ComfyUI/models/loras', local_dir_use_symlinks=False)"

# Gemma-3 12B FP4 Mixed Text Encoder (~6GB)
# FIXED: original sourced from Lightricks/LTX-2.3 where this file does NOT exist.
# Correct source: Comfy-Org/ltx-2 -> split_files/text_encoders/
# LTXAVTextEncoderLoader expects this file in models/text_encoders/
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Comfy-Org/ltx-2', filename='split_files/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors', local_dir='/tmp/gemma', local_dir_use_symlinks=False)" \
    && mv /tmp/gemma/split_files/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors /opt/ComfyUI/models/text_encoders/ \
    && rm -rf /tmp/gemma

# LTX-2.3 Spatial Upscaler x2 v1.1
# FIXED: was downloading v1.0 which had a known artifact/color-overlay bug (hotfixed by Lightricks)
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-spatial-upscaler-x2-1.1.safetensors', local_dir='/opt/ComfyUI/models/latent_upscale_models', local_dir_use_symlinks=False)"

# LTX-2.3 Temporal Upscaler x2 (was missing in original Dockerfile)
RUN python3 -c "from huggingface_hub import hf_hub_download; hf_hub_download(repo_id='Lightricks/LTX-2.3', filename='ltx-2.3-temporal-upscaler-x2-1.0.safetensors', local_dir='/opt/ComfyUI/models/latent_upscale_models', local_dir_use_symlinks=False)"

# ============================================================
# Encoder Path Fix
# LTXAVTextEncoderLoader in some versions looks for the encoder
# relative to the checkpoint directory. Symlink ensures it is
# found regardless of which path it checks.
# ============================================================
RUN ln -sf \
    /opt/ComfyUI/models/text_encoders/gemma_3_12B_it_fp4_mixed.safetensors \
    /opt/ComfyUI/models/checkpoints/gemma_3_12B_it_fp4_mixed.safetensors

# ============================================================
# Environment Setup
# ============================================================
ENV PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:512,garbage_collection_threshold:0.8"
ENV PYTORCH_NO_CUDA_MEMORY_CACHING=0
ENV TRANSFORMERS_CACHE=/opt/ComfyUI/models/.cache/transformers
ENV HF_HOME=/opt/ComfyUI/models/.cache/huggingface

# Default ComfyUI launch flags for 32GB tier
# --lowvram: Keep partial model chunks in VRAM (more efficient than --novram for 32GB)
# --reserve-vram 2.0: Reserve 2GB for activation overhead
# --use-split-cross-attention: Memory-efficient attention for large sequences
ENV COMFYUI_FLAGS="--listen 0.0.0.0 --port 8188 --lowvram --reserve-vram 2.0 --use-split-cross-attention"

WORKDIR /opt/ComfyUI
EXPOSE 8188

CMD ["bash", "-c", "python main.py $COMFYUI_FLAGS"]